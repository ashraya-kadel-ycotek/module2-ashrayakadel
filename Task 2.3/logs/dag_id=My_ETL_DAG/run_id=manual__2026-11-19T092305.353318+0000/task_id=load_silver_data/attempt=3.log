{"timestamp":"2026-11-19T09:41:24.040462Z","level":"info","event":"Running statement: -- 3.3 negatives\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_INVENTORY_MASTER',\n       'NEGATIVE_AMOUNT', 'STOCK_ON_HAND or IN_TRANSIT negative',\n       OBJECT_CONSTRUCT(*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n  AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.STOCK_ON_HAND) < 0\n     OR TRY_TO_NUMBER(s.IN_TRANSIT)   < 0 );, parameters: None","ti_id":"01a1f32e-8f3b-7bf4-a5d2-475a88bd21e0","run_id":"manual__2026-11-19T09:23:05.353318+00:00","map_index":-1,"dag_id":"my_etl_dag","try_number":3,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
