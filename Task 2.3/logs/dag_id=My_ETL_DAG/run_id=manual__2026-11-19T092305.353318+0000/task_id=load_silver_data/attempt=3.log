{"timestamp":"2026-11-19T09:41:23.915577Z","level":"info","event":"Running statement: -- 3.2 NULLs\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_INVENTORY_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required inventory field is NULL',\n       OBJECT_CONSTRUCT(*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NOT NULL\n  AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n  AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n  AND ( s.INVENTORY_DT IS NULL OR s.ITEM_ID IS NULL\n     OR s.LOCATION_ID IS NULL OR s.STOCK_ON_HAND IS NULL\n     OR s.IN_TRANSIT IS NULL );, parameters: None","ti_id":"01a1f32e-8f3b-7bf4-a5d2-475a88bd21e0","run_id":"manual__2026-11-19T09:23:05.353318+00:00","map_index":-1,"dag_id":"my_etl_dag","try_number":3,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
