{"timestamp":"2026-11-19T09:41:24.396619Z","level":"info","event":"Running statement: -- 3.5 RI failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_INVENTORY_MASTER',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in dims',\n       OBJECT_CONSTRUCT(*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND ( NOT EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER  i WHERE i.ITEM_ID     = s.ITEM_ID)\n     OR NOT EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID) );, parameters: None","ti_id":"01a1f32e-8f3b-7bf4-a5d2-475a88bd21e0","run_id":"manual__2026-11-19T09:23:05.353318+00:00","map_index":-1,"dag_id":"my_etl_dag","try_number":3,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
