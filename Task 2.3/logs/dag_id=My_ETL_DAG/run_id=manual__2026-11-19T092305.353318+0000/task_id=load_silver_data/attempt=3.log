{"timestamp":"2026-11-19T09:41:28.473795Z","level":"info","event":"Running statement: -- 5.6 Referential integrity\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_PRICE_MASTER',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in Silver master tables',\n       OBJECT_CONSTRUCT(*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND (\n      NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_ITEM_MASTER i\n          WHERE i.ITEM_ID = s.ITEM_ID\n      )\n      OR NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_STORE_MASTER st\n          WHERE st.LOCATION_ID = s.LOCATION_ID\n      )\n  );, parameters: None","ti_id":"01a1f32e-8f3b-7bf4-a5d2-475a88bd21e0","run_id":"manual__2026-11-19T09:23:05.353318+00:00","map_index":-1,"dag_id":"my_etl_dag","try_number":3,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
