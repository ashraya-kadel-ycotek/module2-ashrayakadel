{"timestamp":"2026-11-19T09:41:20.430083Z","level":"info","event":"Running statement: -- ---------------------------- 0. Idempotency ----------------------------\nDELETE FROM control.C_REJ_TABLE\n WHERE BATCH_ID = DATE '2026-11-19'\n   AND TARGET_TABLE IN\n       ('TMP_STORE_MASTER','TMP_ITEM_MASTER','TMP_INVENTORY_MASTER',\n        'TMP_POS_SALES','TMP_PRICE_MASTER');, parameters: None","ti_id":"01a1f32e-8f3b-7bf4-a5d2-475a88bd21e0","run_id":"manual__2026-11-19T09:23:05.353318+00:00","map_index":-1,"dag_id":"my_etl_dag","try_number":3,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
