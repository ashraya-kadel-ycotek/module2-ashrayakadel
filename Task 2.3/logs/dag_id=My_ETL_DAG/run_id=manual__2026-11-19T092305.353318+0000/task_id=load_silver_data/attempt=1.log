{"timestamp":"2026-11-19T09:23:45.573010Z","level":"info","event":"Running statement: -- ---------------------------- 0. Idempotency ----------------------------\nDELETE FROM control.C_REJ_TABLE\n WHERE BATCH_ID = DATE '2026-11-19'\n   AND TARGET_TABLE IN\n       ('TMP_STORE_MASTER','TMP_ITEM_MASTER','TMP_INVENTORY_MASTER',\n        'TMP_POS_SALES','TMP_PRICE_MASTER');, parameters: None","ti_id":"01a1f31d-e631-74e5-ae80-89331e9d2c79","run_id":"manual__2026-11-19T09:23:05.353318+00:00","try_number":1,"map_index":-1,"dag_id":"my_etl_dag","task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
