{"timestamp":"2026-11-20T04:35:55.789326Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same STATE_CODE, but STATE_NAME changed. Overwrite.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_STATE tgt\nSET\n    STATE_NAME  = src.STATE_NAME,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-13'\nFROM TMP_DIM_STATE_SRC src\nWHERE tgt.STATE_ID  = src.STATE_ID\n  AND tgt.CURR_FLG  = TRUE\n  AND COALESCE(tgt.STATE_CODE, '') = COALESCE(src.STATE_CODE, '')\n  AND COALESCE(tgt.STATE_NAME, '') <> COALESCE(src.STATE_NAME, '');, parameters: None","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f73c-713a-7562-9c3e-5d88d68414e3","task_id":"gold_load_dim_phase1","run_id":"scheduled__2026-11-13T18:15:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
