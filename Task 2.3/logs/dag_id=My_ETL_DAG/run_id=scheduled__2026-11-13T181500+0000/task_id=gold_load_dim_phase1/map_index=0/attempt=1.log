{"timestamp":"2026-11-20T04:35:55.248882Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same COMPANY_NAME, but COMPANY_TYPE changed. Overwrite.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_COMPANY tgt\nSET\n    COMPANY_TYPE = src.COMPANY_TYPE,\n    REC_UPDT_TS  = CURRENT_TIMESTAMP(),\n    BATCH_ID     = DATE '2026-11-13'\nFROM TMP_DIM_COMPANY_SRC src\nWHERE tgt.COMPANY_ID  = src.COMPANY_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.COMPANY_NAME, '') = COALESCE(src.COMPANY_NAME, '')\n  AND COALESCE(tgt.COMPANY_TYPE, '') <> COALESCE(src.COMPANY_TYPE, '');, parameters: None","map_index":0,"task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-13T18:15:00+00:00","ti_id":"01a1f73c-7139-7f71-a113-1e67c45dfc1c","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
