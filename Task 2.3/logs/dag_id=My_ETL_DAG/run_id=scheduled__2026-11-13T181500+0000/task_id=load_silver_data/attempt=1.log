{"timestamp":"2026-11-19T10:17:50.205248Z","level":"info","event":"Executing: -- ============================================================================\n-- SILVER LOAD (flat script — no stored procedure)\n-- Run via Airflow SQLExecuteQueryOperator with split_statements=True,\n-- autocommit=False. Snowflake will treat the file as a sequence of\n-- statements; the MERGE/INSERT DML is auto-wrapped in a transaction\n-- by the connector when autocommit=False; DDL auto-commits regardless.\n--\n-- Batch id is bound as a placeholder :BATCH_ID by the driver — the\n-- SQLExecuteQueryOperator passes `parameters` / `params` if you set them.\n-- Simpler: use a single literal substitution here:\n--   2026-11-13 is resolved by Airflow BEFORE the file runs, so the file\n--   itself contains DATE '2026-11-13'.\n-- ============================================================================\nUSE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\n\n-- ---------------------------- 0. Idempotency ----------------------------\nDELETE FROM control.C_REJ_TABLE\n WHERE BATCH_ID = DATE '2026-11-13'\n   AND TARGET_TABLE IN\n       ('TMP_STORE_MASTER','TMP_ITEM_MASTER','TMP_INVENTORY_MASTER',\n        'TMP_POS_SALES','TMP_PRICE_MASTER');\n\nDELETE FROM control.C_BATCH_RECON\n WHERE BATCH_ID = DATE '2026-11-13';\n\n\n-- ============================================================================\n-- 1. TMP_STORE_MASTER   (key: LOCATION_ID)\n-- ============================================================================\n-- 1.1 NULL rejects\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_STORE_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required store_master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND ( s.LOCATION_ID IS NULL OR s.LOCATION_NAME IS NULL\n     OR s.ADDRESS_LINE IS NULL OR s.DISTRICT_ID IS NULL\n     OR s.DISTRICT_NAME IS NULL OR s.DISTRICT_CODE IS NULL\n     OR s.STATE_ID IS NULL OR s.STATE_NAME IS NULL\n     OR s.STATE_CODE IS NULL );\n\n-- 1.2 DUP rejects\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_STORE_MASTER',\n       'DUP_BUSINESS_KEY', 'LOCATION_ID duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nJOIN (\n    SELECT LOCATION_ID\n    FROM bronze.STG_STORE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-13' AND LOCATION_ID IS NOT NULL\n    GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n) d ON d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-13';\n\n-- 1.3 MERGE\nMERGE INTO silver.TMP_STORE_MASTER t\nUSING (\n    SELECT\n        s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE,\n        s.DISTRICT_ID, s.DISTRICT_NAME, s.DISTRICT_CODE,\n        s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n        s.SRC_FILE_NM,\n        MD5(\n            COALESCE(s.LOCATION_ID  ,'')||'|'||COALESCE(s.LOCATION_NAME ,'')||'|'||\n            COALESCE(s.ADDRESS_LINE ,'')||'|'||COALESCE(s.DISTRICT_ID   ,'')||'|'||\n            COALESCE(s.DISTRICT_NAME,'')||'|'||COALESCE(s.DISTRICT_CODE ,'')||'|'||\n            COALESCE(s.STATE_ID     ,'')||'|'||COALESCE(s.STATE_NAME    ,'')||'|'||\n            COALESCE(s.STATE_CODE   ,'')\n        ) AS ROW_HASH\n    FROM bronze.STG_STORE_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-13'\n      AND s.LOCATION_ID IS NOT NULL AND s.LOCATION_NAME IS NOT NULL\n      AND s.ADDRESS_LINE IS NOT NULL AND s.DISTRICT_ID IS NOT NULL\n      AND s.DISTRICT_NAME IS NOT NULL AND s.DISTRICT_CODE IS NOT NULL\n      AND s.STATE_ID IS NOT NULL AND s.STATE_NAME IS NOT NULL\n      AND s.STATE_CODE IS NOT NULL\n      AND s.LOCATION_ID NOT IN (\n          SELECT LOCATION_ID FROM bronze.STG_STORE_MASTER\n          WHERE BATCH_ID = DATE '2026-11-13' AND LOCATION_ID IS NOT NULL\n          GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n      )\n) s\nON t.LOCATION_ID = s.LOCATION_ID\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    LOCATION_NAME = s.LOCATION_NAME, ADDRESS_LINE = s.ADDRESS_LINE,\n    DISTRICT_ID = s.DISTRICT_ID, DISTRICT_NAME = s.DISTRICT_NAME,\n    DISTRICT_CODE = s.DISTRICT_CODE, STATE_ID = s.STATE_ID,\n    STATE_NAME = s.STATE_NAME, STATE_CODE = s.STATE_CODE,\n    _SRC_FILE_NM = s.SRC_FILE_NM, _BATCH_ID = DATE '2026-11-13',\n    _LOAD_TS = CURRENT_TIMESTAMP(), _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (LOCATION_ID, LOCATION_NAME, ADDRESS_LINE, DISTRICT_ID, DISTRICT_NAME,\n     DISTRICT_CODE, STATE_ID, STATE_NAME, STATE_CODE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE, s.DISTRICT_ID, s.DISTRICT_NAME,\n     s.DISTRICT_CODE, s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n     s.SRC_FILE_NM, DATE '2026-11-13', CURRENT_TIMESTAMP(), s.ROW_HASH);\n\n-- 1.4 Recon\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_STORE_MASTER WHERE BATCH_ID = DATE '2026-11-13'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-13' AND TARGET_TABLE = 'TMP_STORE_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_STORE_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-13'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-13' AND r.TARGET_TABLE = 'TMP_STORE_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-13',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_STORE_MASTER WHERE BATCH_ID = DATE '2026-11-13'),'store_master'),\n       'TMP_STORE_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;\n\n\n-- ============================================================================\n-- 2. TMP_ITEM_MASTER   (key: ITEM_ID, CLASS_ID, DEPARTMENT_ID)\n-- ============================================================================\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_ITEM_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required item_master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_ITEM_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND ( s.ITEM_ID IS NULL OR s.ITEM_NAME IS NULL OR s.COLOR IS NULL\n     OR s.SIZE IS NULL OR s.CLASS_ID IS NULL OR s.CLASS_NAME IS NULL\n     OR s.CLASS_DESCRIPTION IS NULL OR s.DEPARTMENT_ID IS NULL\n     OR s.DEPARTMENT_NAME IS NULL OR s.DEPARTMENT_MANAGER_NAME IS NULL\n     OR s.COMPANY_ID IS NULL OR s.COMPANY_NAME IS NULL\n     OR s.COMPANY_TYPE IS NULL );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_ITEM_MASTER',\n       'DUP_BUSINESS_KEY',\n       'Composite (ITEM_ID, CLASS_ID, DEPARTMENT_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_ITEM_MASTER s\nJOIN (\n    SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n    FROM bronze.STG_ITEM_MASTER\n    WHERE BATCH_ID = DATE '2026-11-13'\n    GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n) d ON  d.ITEM_ID = s.ITEM_ID\n    AND d.CLASS_ID = s.CLASS_ID\n    AND d.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHERE s.BATCH_ID = DATE '2026-11-13';\n\nMERGE INTO silver.TMP_ITEM_MASTER t\nUSING (\n    SELECT\n        s.ITEM_ID, s.ITEM_NAME, s.COLOR, s.SIZE,\n        s.CLASS_ID, s.CLASS_NAME, s.CLASS_DESCRIPTION,\n        s.DEPARTMENT_ID, s.DEPARTMENT_NAME, s.DEPARTMENT_MANAGER_NAME,\n        s.COMPANY_ID, s.COMPANY_NAME, s.COMPANY_TYPE,\n        s.SRC_FILE_NM,\n        MD5(\n            COALESCE(s.ITEM_ID,'')||'|'||COALESCE(s.ITEM_NAME,'')||'|'||\n            COALESCE(s.COLOR,'')||'|'||COALESCE(s.SIZE,'')||'|'||\n            COALESCE(s.CLASS_ID,'')||'|'||COALESCE(s.CLASS_NAME,'')||'|'||\n            COALESCE(s.CLASS_DESCRIPTION,'')||'|'||COALESCE(s.DEPARTMENT_ID,'')||'|'||\n            COALESCE(s.DEPARTMENT_NAME,'')||'|'||COALESCE(s.DEPARTMENT_MANAGER_NAME,'')||'|'||\n            COALESCE(s.COMPANY_ID,'')||'|'||COALESCE(s.COMPANY_NAME,'')||'|'||\n            COALESCE(s.COMPANY_TYPE,'')\n        ) AS ROW_HASH\n    FROM bronze.STG_ITEM_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-13'\n      AND s.ITEM_ID IS NOT NULL AND s.ITEM_NAME IS NOT NULL\n      AND s.COLOR IS NOT NULL AND s.SIZE IS NOT NULL\n      AND s.CLASS_ID IS NOT NULL AND s.CLASS_NAME IS NOT NULL\n      AND s.CLASS_DESCRIPTION IS NOT NULL AND s.DEPARTMENT_ID IS NOT NULL\n      AND s.DEPARTMENT_NAME IS NOT NULL AND s.DEPARTMENT_MANAGER_NAME IS NOT NULL\n      AND s.COMPANY_ID IS NOT NULL AND s.COMPANY_NAME IS NOT NULL\n      AND s.COMPANY_TYPE IS NOT NULL\n      AND (s.ITEM_ID, s.CLASS_ID, s.DEPARTMENT_ID) NOT IN (\n          SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n          FROM bronze.STG_ITEM_MASTER\n          WHERE BATCH_ID = DATE '2026-11-13'\n          GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n      )\n) s\nON  t.ITEM_ID = s.ITEM_ID\nAND t.CLASS_ID = s.CLASS_ID\nAND t.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    ITEM_NAME = s.ITEM_NAME, COLOR = s.COLOR, SIZE = s.SIZE,\n    CLASS_NAME = s.CLASS_NAME, CLASS_DESCRIPTION = s.CLASS_DESCRIPTION,\n    DEPARTMENT_NAME = s.DEPARTMENT_NAME,\n    DEPARTMENT_MANAGER_NAME = s.DEPARTMENT_MANAGER_NAME,\n    COMPANY_ID = s.COMPANY_ID, COMPANY_NAME = s.COMPANY_NAME,\n    COMPANY_TYPE = s.COMPANY_TYPE,\n    _SRC_FILE_NM = s.SRC_FILE_NM, _BATCH_ID = DATE '2026-11-13',\n    _LOAD_TS = CURRENT_TIMESTAMP(), _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (ITEM_ID, ITEM_NAME, COLOR, SIZE, CLASS_ID, CLASS_NAME, CLASS_DESCRIPTION,\n     DEPARTMENT_ID, DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME,\n     COMPANY_ID, COMPANY_NAME, COMPANY_TYPE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.ITEM_ID, s.ITEM_NAME, s.COLOR, s.SIZE, s.CLASS_ID, s.CLASS_NAME, s.CLASS_DESCRIPTION,\n     s.DEPARTMENT_ID, s.DEPARTMENT_NAME, s.DEPARTMENT_MANAGER_NAME,\n     s.COMPANY_ID, s.COMPANY_NAME, s.COMPANY_TYPE,\n     s.SRC_FILE_NM, DATE '2026-11-13', CURRENT_TIMESTAMP(), s.ROW_HASH);\n\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_ITEM_MASTER WHERE BATCH_ID = DATE '2026-11-13'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-13' AND TARGET_TABLE = 'TMP_ITEM_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_ITEM_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-13'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-13' AND r.TARGET_TABLE = 'TMP_ITEM_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-13',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_ITEM_MASTER WHERE BATCH_ID = DATE '2026-11-13'),'item_master'),\n       'TMP_ITEM_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;\n\n\n-- ============================================================================\n-- 3. TMP_INVENTORY_MASTER   (key: INVENTORY_DT, ITEM_ID, LOCATION_ID)\n-- ============================================================================\n-- 3.1 cast failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_INVENTORY_MASTER',\n       'TYPE_CAST_FAILURE',\n       'INVENTORY_DT / STOCK_ON_HAND / IN_TRANSIT failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND ( TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NULL\n     OR TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NULL\n     OR TRY_TO_NUMBER(s.IN_TRANSIT)    IS NULL );\n\n-- 3.2 NULLs\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_INVENTORY_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required inventory field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NOT NULL\n  AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n  AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n  AND ( s.INVENTORY_DT IS NULL OR s.ITEM_ID IS NULL\n     OR s.LOCATION_ID IS NULL OR s.STOCK_ON_HAND IS NULL\n     OR s.IN_TRANSIT IS NULL );\n\n-- 3.3 negatives\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_INVENTORY_MASTER',\n       'NEGATIVE_AMOUNT', 'STOCK_ON_HAND or IN_TRANSIT negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n  AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.STOCK_ON_HAND) < 0\n     OR TRY_TO_NUMBER(s.IN_TRANSIT)   < 0 );\n\n-- 3.4 dup keys\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_INVENTORY_MASTER',\n       'DUP_BUSINESS_KEY',\n       '(INVENTORY_DT, ITEM_ID, LOCATION_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nJOIN (\n    SELECT TRY_TO_DATE(INVENTORY_DT,'YYYY-MM-DD') AS D, ITEM_ID, LOCATION_ID\n    FROM bronze.STG_INVENTORY_MASTER\n    WHERE BATCH_ID = DATE '2026-11-13'\n    GROUP BY 1,2,3 HAVING COUNT(*) > 1\n) d ON  d.D = TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD')\n    AND d.ITEM_ID = s.ITEM_ID\n    AND d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-13';\n\n-- 3.5 RI failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_INVENTORY_MASTER',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in dims',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND ( NOT EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER  i WHERE i.ITEM_ID     = s.ITEM_ID)\n     OR NOT EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID) );\n\n-- 3.6 MERGE\nMERGE INTO silver.TMP_INVENTORY_MASTER t\nUSING (\n    SELECT\n        TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') AS INVENTORY_DT,\n        s.ITEM_ID, s.LOCATION_ID,\n        TRY_TO_NUMBER(s.STOCK_ON_HAND) AS STOCK_ON_HAND,\n        TRY_TO_NUMBER(s.IN_TRANSIT)    AS IN_TRANSIT,\n        s.SRC_FILE_NM,\n        MD5(\n            TO_VARCHAR(TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD'))||'|'||\n            COALESCE(s.ITEM_ID,'')||'|'||COALESCE(s.LOCATION_ID,'')||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.STOCK_ON_HAND))||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.IN_TRANSIT))\n        ) AS ROW_HASH\n    FROM bronze.STG_INVENTORY_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-13'\n      AND TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NOT NULL\n      AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n      AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n      AND TRY_TO_NUMBER(s.STOCK_ON_HAND) >= 0\n      AND TRY_TO_NUMBER(s.IN_TRANSIT)    >= 0\n      AND s.ITEM_ID IS NOT NULL AND s.LOCATION_ID IS NOT NULL\n      AND EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER  i WHERE i.ITEM_ID     = s.ITEM_ID)\n      AND EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID)\n      AND NOT EXISTS (\n          SELECT 1 FROM (\n              SELECT TRY_TO_DATE(INVENTORY_DT,'YYYY-MM-DD') AS D,\n                     ITEM_ID, LOCATION_ID, COUNT(*) c\n              FROM bronze.STG_INVENTORY_MASTER\n              WHERE BATCH_ID = DATE '2026-11-13'\n              GROUP BY 1,2,3\n          ) d\n          WHERE d.D = TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD')\n            AND d.ITEM_ID = s.ITEM_ID\n            AND d.LOCATION_ID = s.LOCATION_ID\n            AND d.c > 1\n      )\n) s\nON  t.INVENTORY_DT = s.INVENTORY_DT\nAND t.ITEM_ID      = s.ITEM_ID\nAND t.LOCATION_ID  = s.LOCATION_ID\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    STOCK_ON_HAND = s.STOCK_ON_HAND, IN_TRANSIT = s.IN_TRANSIT,\n    _SRC_FILE_NM = s.SRC_FILE_NM, _BATCH_ID = DATE '2026-11-13',\n    _LOAD_TS = CURRENT_TIMESTAMP(), _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (INVENTORY_DT, ITEM_ID, LOCATION_ID, STOCK_ON_HAND, IN_TRANSIT,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.INVENTORY_DT, s.ITEM_ID, s.LOCATION_ID, s.STOCK_ON_HAND, s.IN_TRANSIT,\n     s.SRC_FILE_NM, DATE '2026-11-13', CURRENT_TIMESTAMP(), s.ROW_HASH);\n\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-13'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-13' AND TARGET_TABLE = 'TMP_INVENTORY_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-13'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-13' AND r.TARGET_TABLE = 'TMP_INVENTORY_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-13',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-13'),'inventory_master'),\n       'TMP_INVENTORY_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;\n\n\n-- ============================================================================\n-- 4. TMP_POS_SALES   (key: TRANSACTION_ID, TRANSACTION_LINE_NUMBER)\n-- ============================================================================\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_POS_SALES',\n       'TYPE_CAST_FAILURE',\n       'TRANSACTION_LINE_NUMBER / SALES_DT / SLS_QTY / SLS_AMT failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND ( TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER) IS NULL\n     OR TRY_TO_DATE  (s.SALES_DT,'YYYY-MM-DD')   IS NULL\n     OR TRY_TO_NUMBER(s.SLS_QTY)                 IS NULL\n     OR TRY_TO_NUMBER(s.SLS_AMT)                 IS NULL );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_POS_SALES',\n       'NULL_REQUIRED_FIELD', 'Required POS field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER) IS NOT NULL\n  AND TRY_TO_DATE  (s.SALES_DT,'YYYY-MM-DD')   IS NOT NULL\n  AND TRY_TO_NUMBER(s.SLS_QTY)                 IS NOT NULL\n  AND TRY_TO_NUMBER(s.SLS_AMT)                 IS NOT NULL\n  AND ( s.TRANSACTION_ID IS NULL OR s.TRANSACTION_LINE_NUMBER IS NULL\n     OR s.SALES_DT IS NULL OR s.ITEM_ID IS NULL OR s.LOCATION_ID IS NULL\n     OR s.CUSTOMER_ID IS NULL OR s.CUSTOMER_NAME IS NULL\n     OR s.CUSTOMER_EMAIL IS NULL OR s.CUSTOMER_PHONE IS NULL\n     OR s.SLS_QTY IS NULL OR s.SLS_AMT IS NULL );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_POS_SALES',\n       'NEGATIVE_AMOUNT', 'SLS_QTY or SLS_AMT negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND TRY_TO_NUMBER(s.SLS_QTY) IS NOT NULL\n  AND TRY_TO_NUMBER(s.SLS_AMT) IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.SLS_QTY) < 0 OR TRY_TO_NUMBER(s.SLS_AMT) < 0 );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_POS_SALES',\n       'DUP_BUSINESS_KEY',\n       '(TRANSACTION_ID, TRANSACTION_LINE_NUMBER) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nJOIN (\n    SELECT TRANSACTION_ID, TRY_TO_NUMBER(TRANSACTION_LINE_NUMBER) AS LN\n    FROM bronze.STG_POS_SALES\n    WHERE BATCH_ID = DATE '2026-11-13'\n    GROUP BY 1,2 HAVING COUNT(*) > 1\n) d ON  d.TRANSACTION_ID = s.TRANSACTION_ID\n    AND d.LN = TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER)\nWHERE s.BATCH_ID = DATE '2026-11-13';\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_POS_SALES',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in dims',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND (\n      NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_ITEM_MASTER i\n          WHERE i.ITEM_ID = s.ITEM_ID\n      )\n      OR NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_STORE_MASTER st\n          WHERE st.LOCATION_ID = s.LOCATION_ID\n      )\n  );\n-- 4.6 MERGE valid POS sales\nMERGE INTO silver.TMP_POS_SALES t\nUSING (\n    SELECT\n        s.TRANSACTION_ID,\n        TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER) AS TRANSACTION_LINE_NUMBER,\n        TRY_TO_DATE(s.SALES_DT,'YYYY-MM-DD') AS SALES_DT,\n        s.ITEM_ID, s.LOCATION_ID,\n        s.CUSTOMER_ID, s.CUSTOMER_NAME, s.CUSTOMER_EMAIL, s.CUSTOMER_PHONE,\n        TRY_TO_NUMBER(s.SLS_QTY) AS SLS_QTY,\n        TRY_TO_NUMBER(s.SLS_AMT) AS SLS_AMT,\n        s.SRC_FILE_NM,\n        MD5(\n            COALESCE(s.TRANSACTION_ID,'')||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER))||'|'||\n            TO_VARCHAR(TRY_TO_DATE(s.SALES_DT,'YYYY-MM-DD'))||'|'||\n            COALESCE(s.ITEM_ID,'')||'|'||COALESCE(s.LOCATION_ID,'')||'|'||\n            COALESCE(s.CUSTOMER_ID,'')||'|'||COALESCE(s.CUSTOMER_NAME,'')||'|'||\n            COALESCE(s.CUSTOMER_EMAIL,'')||'|'||COALESCE(s.CUSTOMER_PHONE,'')||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.SLS_QTY))||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.SLS_AMT))\n        ) AS ROW_HASH\n    FROM bronze.STG_POS_SALES s\n    WHERE s.BATCH_ID = DATE '2026-11-13'\n      AND s.TRANSACTION_ID IS NOT NULL\n      AND TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER) IS NOT NULL\n      AND TRY_TO_DATE(s.SALES_DT,'YYYY-MM-DD') IS NOT NULL\n      AND s.ITEM_ID IS NOT NULL AND s.LOCATION_ID IS NOT NULL\n      AND s.CUSTOMER_ID IS NOT NULL AND s.CUSTOMER_NAME IS NOT NULL\n      AND s.CUSTOMER_EMAIL IS NOT NULL AND s.CUSTOMER_PHONE IS NOT NULL\n      AND TRY_TO_NUMBER(s.SLS_QTY) IS NOT NULL\n      AND TRY_TO_NUMBER(s.SLS_AMT) IS NOT NULL\n      AND TRY_TO_NUMBER(s.SLS_QTY) >= 0\n      AND TRY_TO_NUMBER(s.SLS_AMT) >= 0\n      AND EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER i WHERE i.ITEM_ID = s.ITEM_ID)\n      AND EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID)\n      AND NOT EXISTS (\n          SELECT 1\n          FROM bronze.STG_POS_SALES d\n          WHERE d.BATCH_ID = DATE '2026-11-13'\n          GROUP BY d.TRANSACTION_ID, TRY_TO_NUMBER(d.TRANSACTION_LINE_NUMBER)\n          HAVING COUNT(*) > 1\n          AND d.TRANSACTION_ID = s.TRANSACTION_ID\n          AND TRY_TO_NUMBER(d.TRANSACTION_LINE_NUMBER) = TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER)\n      )\n) s\nON t.TRANSACTION_ID = s.TRANSACTION_ID\nAND t.TRANSACTION_LINE_NUMBER = s.TRANSACTION_LINE_NUMBER\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    SALES_DT = s.SALES_DT,\n    ITEM_ID = s.ITEM_ID,\n    LOCATION_ID = s.LOCATION_ID,\n    CUSTOMER_ID = s.CUSTOMER_ID,\n    CUSTOMER_NAME = s.CUSTOMER_NAME,\n    CUSTOMER_EMAIL = s.CUSTOMER_EMAIL,\n    CUSTOMER_PHONE = s.CUSTOMER_PHONE,\n    SLS_QTY = s.SLS_QTY,\n    SLS_AMT = s.SLS_AMT,\n    _SRC_FILE_NM = s.SRC_FILE_NM,\n    _BATCH_ID = DATE '2026-11-13',\n    _LOAD_TS = CURRENT_TIMESTAMP(),\n    _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (TRANSACTION_ID, TRANSACTION_LINE_NUMBER, SALES_DT, ITEM_ID, LOCATION_ID,\n     CUSTOMER_ID, CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE, SLS_QTY, SLS_AMT,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\nVALUES\n    (s.TRANSACTION_ID, s.TRANSACTION_LINE_NUMBER, s.SALES_DT, s.ITEM_ID, s.LOCATION_ID,\n     s.CUSTOMER_ID, s.CUSTOMER_NAME, s.CUSTOMER_EMAIL, s.CUSTOMER_PHONE, s.SLS_QTY, s.SLS_AMT,\n     s.SRC_FILE_NM, DATE '2026-11-13', CURRENT_TIMESTAMP(), s.ROW_HASH);\n\n-- 4.7 Recon\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_POS_SALES WHERE BATCH_ID = DATE '2026-11-13'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-13' AND TARGET_TABLE = 'TMP_POS_SALES'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_POS_SALES s\n        WHERE s.BATCH_ID = DATE '2026-11-13'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-13' AND r.TARGET_TABLE = 'TMP_POS_SALES'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-13',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_POS_SALES WHERE BATCH_ID = DATE '2026-11-13'),'pos_sales'),\n       'TMP_POS_SALES', b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;\n\n\n-- ============================================================================\n-- 5. TMP_PRICE_MASTER\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID, EFF_FROM_DATE)\n-- ============================================================================\n\n-- 5.1 Type-cast failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_PRICE_MASTER',\n       'TYPE_CAST_FAILURE',\n       'PRICE_DT / UNIT_PRICE_AMT / EFF_FROM_DATE / EFF_TO_DATE failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND (\n       TRY_TO_DATE(s.PRICE_DT, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_NUMBER(s.UNIT_PRICE_AMT) IS NULL\n    OR TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') IS NULL\n  );\n\n-- 5.2 NULL required fields\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_PRICE_MASTER',\n       'NULL_REQUIRED_FIELD',\n       'Required price master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND (\n       s.PRICE_DT IS NULL\n    OR s.ITEM_ID IS NULL\n    OR s.LOCATION_ID IS NULL\n    OR s.UNIT_PRICE_AMT IS NULL\n    OR s.EFF_FROM_DATE IS NULL\n    OR s.EFF_TO_DATE IS NULL\n  );\n\n-- 5.3 Negative price\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_PRICE_MASTER',\n       'NEGATIVE_AMOUNT',\n       'UNIT_PRICE_AMT is negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND TRY_TO_NUMBER(s.UNIT_PRICE_AMT) < 0;\n\n-- 5.4 Invalid effective date range\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_PRICE_MASTER',\n       'TYPE_CAST_FAILURE',\n       'EFF_TO_DATE is earlier than EFF_FROM_DATE',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') IS NOT NULL\n  AND TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') IS NOT NULL\n  AND TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD')\n      < TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD');\n\n-- 5.5 Duplicate business key\n-- Business key: ITEM_ID, LOCATION_ID, EFF_FROM_DATE\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_PRICE_MASTER',\n       'DUP_BUSINESS_KEY',\n       '(ITEM_ID, LOCATION_ID, EFF_FROM_DATE) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nJOIN (\n    SELECT\n        ITEM_ID,\n        LOCATION_ID,\n        EFF_FROM_DATE\n    FROM bronze.STG_PRICE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-13'\n    GROUP BY ITEM_ID, LOCATION_ID, EFF_FROM_DATE\n    HAVING COUNT(*) > 1\n) d\n    ON d.ITEM_ID = s.ITEM_ID\n   AND d.LOCATION_ID = s.LOCATION_ID\n   AND d.EFF_FROM_DATE = s.EFF_FROM_DATE\nWHERE s.BATCH_ID = DATE '2026-11-13';\n\n-- 5.6 Referential integrity\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_PRICE_MASTER',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in Silver master tables',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-13'\n  AND (\n      NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_ITEM_MASTER i\n          WHERE i.ITEM_ID = s.ITEM_ID\n      )\n      OR NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_STORE_MASTER st\n          WHERE st.LOCATION_ID = s.LOCATION_ID\n      )\n  );\n\n-- 5.7 MERGE valid records\nMERGE INTO silver.TMP_PRICE_MASTER t\nUSING (\n    SELECT\n        s.PRICE_DT::DATE AS PRICE_DT,\n        s.ITEM_ID,\n        s.LOCATION_ID,\n        TRY_TO_NUMBER(s.UNIT_PRICE_AMT)::NUMBER(18,2) AS UNIT_PRICE_AMT,\n        TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') AS EFF_FROM_DATE,\n        TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') AS EFF_TO_DATE,\n        s.SRC_FILE_NM,\n\n        MD5(\n            COALESCE(s.PRICE_DT, '') || '|' ||\n            COALESCE(s.ITEM_ID, '') || '|' ||\n            COALESCE(s.LOCATION_ID, '') || '|' ||\n            COALESCE(s.UNIT_PRICE_AMT, '') || '|' ||\n            COALESCE(s.EFF_FROM_DATE, '') || '|' ||\n            COALESCE(s.EFF_TO_DATE, '')\n        ) AS ROW_HASH\n\n    FROM bronze.STG_PRICE_MASTER s\n\n    WHERE s.BATCH_ID = DATE '2026-11-13'\n\n      -- Required fields\n      AND s.PRICE_DT IS NOT NULL\n      AND s.ITEM_ID IS NOT NULL\n      AND s.LOCATION_ID IS NOT NULL\n      AND s.UNIT_PRICE_AMT IS NOT NULL\n      AND s.EFF_FROM_DATE IS NOT NULL\n      AND s.EFF_TO_DATE IS NOT NULL\n\n      -- Valid data types\n      AND TRY_TO_DATE(s.PRICE_DT, 'YYYY-MM-DD') IS NOT NULL\n      AND TRY_TO_NUMBER(s.UNIT_PRICE_AMT) IS NOT NULL\n      AND TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') IS NOT NULL\n      AND TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') IS NOT NULL\n\n      -- Valid price and dates\n      AND TRY_TO_NUMBER(s.UNIT_PRICE_AMT) >= 0\n      AND TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD')\n          >= TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD')\n\n      -- Valid references\n      AND EXISTS (\n          SELECT 1\n          FROM silver.TMP_ITEM_MASTER i\n          WHERE i.ITEM_ID = s.ITEM_ID\n      )\n      AND EXISTS (\n          SELECT 1\n          FROM silver.TMP_STORE_MASTER st\n          WHERE st.LOCATION_ID = s.LOCATION_ID\n      )\n\n      -- Exclude duplicate business keys\n      AND NOT EXISTS (\n          SELECT 1\n          FROM bronze.STG_PRICE_MASTER d\n          WHERE d.BATCH_ID = DATE '2026-11-13'\n            AND d.ITEM_ID = s.ITEM_ID\n            AND d.LOCATION_ID = s.LOCATION_ID\n            AND d.EFF_FROM_DATE = s.EFF_FROM_DATE\n        GROUP BY d.ITEM_ID, d.LOCATION_ID, d.EFF_FROM_DATE\n        HAVING COUNT(*) > 1\n      )\n) s\n\nON  t.ITEM_ID = s.ITEM_ID\nAND t.LOCATION_ID = s.LOCATION_ID\nAND t.EFF_FROM_DATE = s.EFF_FROM_DATE\n\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN\nUPDATE SET\n    PRICE_DT = s.PRICE_DT,\n    UNIT_PRICE_AMT = s.UNIT_PRICE_AMT,\n    EFF_TO_DATE = s.EFF_TO_DATE,\n    _SRC_FILE_NM = s.SRC_FILE_NM,\n    _BATCH_ID = DATE '2026-11-13',\n    _LOAD_TS = CURRENT_TIMESTAMP(),\n    _ROW_HASH = s.ROW_HASH\n\nWHEN NOT MATCHED THEN\nINSERT (\n    PRICE_DT,\n    ITEM_ID,\n    LOCATION_ID,\n    UNIT_PRICE_AMT,\n    EFF_FROM_DATE,\n    EFF_TO_DATE,\n    _SRC_FILE_NM,\n    _BATCH_ID,\n    _LOAD_TS,\n    _ROW_HASH\n)\nVALUES (\n    s.PRICE_DT,\n    s.ITEM_ID,\n    s.LOCATION_ID,\n    s.UNIT_PRICE_AMT,\n    s.EFF_FROM_DATE,\n    s.EFF_TO_DATE,\n    s.SRC_FILE_NM,\n    DATE '2026-11-13',\n    CURRENT_TIMESTAMP(),\n    s.ROW_HASH\n);\n\n-- 5.8 Batch reconciliation\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE,\n     BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\n\nWITH b AS (\n    SELECT COUNT(*) c\n    FROM bronze.STG_PRICE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-13'\n),\nr AS (\n    SELECT COUNT(*) c\n    FROM control.C_REJ_TABLE\n    WHERE BATCH_ID = DATE '2026-11-13'\n      AND TARGET_TABLE = 'TMP_PRICE_MASTER'\n),\nt AS (\n    SELECT COUNT(*) c\n    FROM bronze.STG_PRICE_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-13'\n      AND NOT EXISTS (\n          SELECT 1\n          FROM control.C_REJ_TABLE r\n          WHERE r.BATCH_ID = DATE '2026-11-13'\n            AND r.TARGET_TABLE = 'TMP_PRICE_MASTER'\n            AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n            AND r.DETAILS:SRC_ROW_NUM::NUMBER = s.SRC_ROW_NUM\n      )\n)\nSELECT\n    DATE '2026-11-13',\n    COALESCE(\n        (SELECT MAX(SRC_FILE_NM)\n         FROM bronze.STG_PRICE_MASTER\n         WHERE BATCH_ID = DATE '2026-11-13'),\n        'price_master'\n    ),\n    'TMP_PRICE_MASTER',\n    b.c,\n    t.c,\n    r.c,\n    b.c - (t.c + r.c),\n    CASE\n        WHEN b.c = (t.c + r.c) THEN 'PASSED'\n        ELSE 'FAILED'\n    END\nFROM b, r, t;","try_number":1,"run_id":"scheduled__2026-11-13T18:15:00+00:00","ti_id":"01a1f34f-a04b-772a-a52e-c3cde63247f9","dag_id":"my_etl_dag","map_index":-1,"task_id":"load_silver_data","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
