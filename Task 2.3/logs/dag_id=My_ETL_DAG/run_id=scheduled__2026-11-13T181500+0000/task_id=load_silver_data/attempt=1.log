{"timestamp":"2026-11-19T10:18:02.571187Z","level":"info","event":"Running statement: -- 4.6 MERGE valid POS sales\nMERGE INTO silver.TMP_POS_SALES t\nUSING (\n    SELECT\n        s.TRANSACTION_ID,\n        TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER) AS TRANSACTION_LINE_NUMBER,\n        TRY_TO_DATE(s.SALES_DT,'YYYY-MM-DD') AS SALES_DT,\n        s.ITEM_ID, s.LOCATION_ID,\n        s.CUSTOMER_ID, s.CUSTOMER_NAME, s.CUSTOMER_EMAIL, s.CUSTOMER_PHONE,\n        TRY_TO_NUMBER(s.SLS_QTY) AS SLS_QTY,\n        TRY_TO_NUMBER(s.SLS_AMT) AS SLS_AMT,\n        s.SRC_FILE_NM,\n        MD5(\n            COALESCE(s.TRANSACTION_ID,'')||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER))||'|'||\n            TO_VARCHAR(TRY_TO_DATE(s.SALES_DT,'YYYY-MM-DD'))||'|'||\n            COALESCE(s.ITEM_ID,'')||'|'||COALESCE(s.LOCATION_ID,'')||'|'||\n            COALESCE(s.CUSTOMER_ID,'')||'|'||COALESCE(s.CUSTOMER_NAME,'')||'|'||\n            COALESCE(s.CUSTOMER_EMAIL,'')||'|'||COALESCE(s.CUSTOMER_PHONE,'')||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.SLS_QTY))||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.SLS_AMT))\n        ) AS ROW_HASH\n    FROM bronze.STG_POS_SALES s\n    WHERE s.BATCH_ID = DATE '2026-11-13'\n      AND s.TRANSACTION_ID IS NOT NULL\n      AND TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER) IS NOT NULL\n      AND TRY_TO_DATE(s.SALES_DT,'YYYY-MM-DD') IS NOT NULL\n      AND s.ITEM_ID IS NOT NULL AND s.LOCATION_ID IS NOT NULL\n      AND s.CUSTOMER_ID IS NOT NULL AND s.CUSTOMER_NAME IS NOT NULL\n      AND s.CUSTOMER_EMAIL IS NOT NULL AND s.CUSTOMER_PHONE IS NOT NULL\n      AND TRY_TO_NUMBER(s.SLS_QTY) IS NOT NULL\n      AND TRY_TO_NUMBER(s.SLS_AMT) IS NOT NULL\n      AND TRY_TO_NUMBER(s.SLS_QTY) >= 0\n      AND TRY_TO_NUMBER(s.SLS_AMT) >= 0\n      AND EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER i WHERE i.ITEM_ID = s.ITEM_ID)\n      AND EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID)\n      AND NOT EXISTS (\n          SELECT 1\n          FROM bronze.STG_POS_SALES d\n          WHERE d.BATCH_ID = DATE '2026-11-13'\n          GROUP BY d.TRANSACTION_ID, TRY_TO_NUMBER(d.TRANSACTION_LINE_NUMBER)\n          HAVING COUNT(*) > 1\n          AND d.TRANSACTION_ID = s.TRANSACTION_ID\n          AND TRY_TO_NUMBER(d.TRANSACTION_LINE_NUMBER) = TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER)\n      )\n) s\nON t.TRANSACTION_ID = s.TRANSACTION_ID\nAND t.TRANSACTION_LINE_NUMBER = s.TRANSACTION_LINE_NUMBER\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    SALES_DT = s.SALES_DT,\n    ITEM_ID = s.ITEM_ID,\n    LOCATION_ID = s.LOCATION_ID,\n    CUSTOMER_ID = s.CUSTOMER_ID,\n    CUSTOMER_NAME = s.CUSTOMER_NAME,\n    CUSTOMER_EMAIL = s.CUSTOMER_EMAIL,\n    CUSTOMER_PHONE = s.CUSTOMER_PHONE,\n    SLS_QTY = s.SLS_QTY,\n    SLS_AMT = s.SLS_AMT,\n    _SRC_FILE_NM = s.SRC_FILE_NM,\n    _BATCH_ID = DATE '2026-11-13',\n    _LOAD_TS = CURRENT_TIMESTAMP(),\n    _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (TRANSACTION_ID, TRANSACTION_LINE_NUMBER, SALES_DT, ITEM_ID, LOCATION_ID,\n     CUSTOMER_ID, CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE, SLS_QTY, SLS_AMT,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\nVALUES\n    (s.TRANSACTION_ID, s.TRANSACTION_LINE_NUMBER, s.SALES_DT, s.ITEM_ID, s.LOCATION_ID,\n     s.CUSTOMER_ID, s.CUSTOMER_NAME, s.CUSTOMER_EMAIL, s.CUSTOMER_PHONE, s.SLS_QTY, s.SLS_AMT,\n     s.SRC_FILE_NM, DATE '2026-11-13', CURRENT_TIMESTAMP(), s.ROW_HASH);, parameters: None","try_number":1,"run_id":"scheduled__2026-11-13T18:15:00+00:00","ti_id":"01a1f34f-a04b-772a-a52e-c3cde63247f9","dag_id":"my_etl_dag","map_index":-1,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
