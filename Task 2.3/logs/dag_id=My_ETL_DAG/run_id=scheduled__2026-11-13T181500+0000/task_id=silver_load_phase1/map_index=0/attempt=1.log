CODE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE, s.DISTRICT_ID, s.DISTRICT_NAME,\n     s.DISTRICT_CODE, s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n     s.SRC_FILE_NM, DATE '2026-11-13', CURRENT_TIMESTAMP(), s.ROW_HASH);, parameters: None","task_id":"silver_load_phase1","ti_id":"01a1f6f0-96cc-7d84-b9b2-ba57b2829e3f","run_id":"scheduled__2026-11-13T18:15:00+00:00","dag_id":"my_etl_dag","try_number":1,"map_index":0,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
