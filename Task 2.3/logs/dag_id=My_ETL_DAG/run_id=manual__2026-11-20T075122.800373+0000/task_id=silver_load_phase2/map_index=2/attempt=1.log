{"timestamp":"2026-11-20T07:52:14.486792Z","level":"info","event":"Running statement: -- 5.5 Duplicate business key\n-- Business key: ITEM_ID, LOCATION_ID, EFF_FROM_DATE\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-14', 'TMP_PRICE_MASTER',\n       'DUP_BUSINESS_KEY',\n       '(ITEM_ID, LOCATION_ID, EFF_FROM_DATE) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nJOIN (\n    SELECT\n        ITEM_ID,\n        LOCATION_ID,\n        EFF_FROM_DATE\n    FROM bronze.STG_PRICE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-14'\n    GROUP BY ITEM_ID, LOCATION_ID, EFF_FROM_DATE\n    HAVING COUNT(*) > 1\n) d\n    ON d.ITEM_ID = s.ITEM_ID\n   AND d.LOCATION_ID = s.LOCATION_ID\n   AND d.EFF_FROM_DATE = s.EFF_FROM_DATE\nWHERE s.BATCH_ID = DATE '2026-11-14';, parameters: None","map_index":2,"run_id":"manual__2026-11-20T07:51:22.800373+00:00","dag_id":"my_etl_dag","task_id":"silver_load_phase2","try_number":1,"ti_id":"01a1f7f0-4bf5-7bcc-96f9-a758fdbe94fb","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
