{"timestamp":"2026-11-20T07:10:23.887531Z","level":"info","event":"Snowflake query id: 01c8884e-0003-1f41-000f-4ff60012e5c6","map_index":1,"task_id":"gold_load_fct_phase1","dag_id":"my_etl_dag","try_number":1,"run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2dbd-7e6b-83e4-f4db0fa79643","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:10:23.887772Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3. MERGE valid rows into FCT_PRICE — idempotent on the grain.\n-- ----------------------------------------------------------------------------\nMERGE INTO gold.FCT_PRICE t\nUSING (\n    SELECT\n        DAY_KY, ITEM_KY, LOCATION_KY,\n        UNIT_PRICE_AMT,\n        SRC_EFF_FROM_DATE, SRC_EFF_TO_DATE\n    FROM TMP_FCT_PRICE_STG\n    WHERE RI_FAIL_FLG = FALSE\n) s\nON  t.DAY_KY      = s.DAY_KY\nAND t.ITEM_KY     = s.ITEM_KY\nAND t.LOCATION_KY = s.LOCATION_KY\n\nWHEN MATCHED AND (\n        COALESCE(t.UNIT_PRICE_AMT, -1) <> COALESCE(s.UNIT_PRICE_AMT, -1)\n     OR COALESCE(t.EFF_FROM_DATE, DATE '1900-01-01') <> COALESCE(s.SRC_EFF_FROM_DATE, DATE '1900-01-01')\n     OR COALESCE(t.EFF_TO_DATE,   DATE '9999-12-31') <> COALESCE(s.SRC_EFF_TO_DATE,   DATE '9999-12-31')\n) THEN UPDATE SET\n    UNIT_PRICE_AMT = s.UNIT_PRICE_AMT,\n    EFF_FROM_DATE  = s.SRC_EFF_FROM_DATE,\n    EFF_TO_DATE    = s.SRC_EFF_TO_DATE,\n    REC_UPDT_TS    = CURRENT_TIMESTAMP(),\n    BATCH_ID       = DATE '2026-11-20',\n    SRC_SYS_CD     = 'TMP_PRICE_MASTER'\n\nWHEN NOT MATCHED THEN INSERT (\n    DAY_KY, ITEM_KY, LOCATION_KY,\n    UNIT_PRICE_AMT,\n    EFF_FROM_DATE, EFF_TO_DATE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID\n)\nVALUES (\n    s.DAY_KY, s.ITEM_KY, s.LOCATION_KY,\n    s.UNIT_PRICE_AMT,\n    s.SRC_EFF_FROM_DATE, s.SRC_EFF_TO_DATE,\n    CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'TMP_PRICE_MASTER', DATE '2026-11-20'\n);, parameters: None","map_index":1,"task_id":"gold_load_fct_phase1","dag_id":"my_etl_dag","try_number":1,"run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2dbd-7e6b-83e4-f4db0fa79643","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
