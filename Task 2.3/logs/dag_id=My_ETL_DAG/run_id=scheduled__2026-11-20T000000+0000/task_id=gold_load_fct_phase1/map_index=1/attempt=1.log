{"timestamp":"2026-11-20T07:10:23.482536Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. Write join-miss rows to the reject table.\n-- ----------------------------------------------------------------------------\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT\n    s.SRC_FILE_NM,\n    DATE '2026-11-20',\n    'FCT_PRICE',\n    'REFERENTIAL_INTEGRITY_FAILURE',\n    'DAY_KY / ITEM_KY / LOCATION_KY could not be resolved as-of PRICE_DT',\n    OBJECT_CONSTRUCT(\n        'PRICE_DT',       s.PRICE_DT,\n        'ITEM_ID',        s.ITEM_ID,\n        'LOCATION_ID',    s.LOCATION_ID,\n        'UNIT_PRICE_AMT', s.UNIT_PRICE_AMT,\n        'EFF_FROM_DATE',  s.SRC_EFF_FROM_DATE,\n        'EFF_TO_DATE',    s.SRC_EFF_TO_DATE,\n        'DAY_KY',         s.DAY_KY,\n        'ITEM_KY',        s.ITEM_KY,\n        'LOCATION_KY',    s.LOCATION_KY,\n        'SRC_FILE_NM',    s.SRC_FILE_NM,\n        'SRC_ROW_HASH',   s.SRC_ROW_HASH\n    )\nFROM TMP_FCT_PRICE_STG s\nWHERE s.RI_FAIL_FLG = TRUE;, parameters: None","map_index":1,"task_id":"gold_load_fct_phase1","dag_id":"my_etl_dag","try_number":1,"run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2dbd-7e6b-83e4-f4db0fa79643","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
