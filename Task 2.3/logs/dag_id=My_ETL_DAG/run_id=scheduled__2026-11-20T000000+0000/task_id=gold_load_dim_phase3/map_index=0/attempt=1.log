{"timestamp":"2026-11-20T07:10:12.179040Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose CLASS_NAME (or parent) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CLASS tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-20'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-20'\nFROM TMP_DIM_CLASS_SRC src\nWHERE tgt.CLASS_ID = src.CLASS_ID\n  AND tgt.CURR_FLG = TRUE\n  AND (\n        COALESCE(tgt.CLASS_NAME, '') <> COALESCE(src.CLASS_NAME, '')\n     OR tgt.DEPARTMENT_KY <> src.DEPARTMENT_KY\n  );, parameters: None","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2db9-7c2b-a624-78ceeaee5a00","dag_id":"my_etl_dag","try_number":1,"map_index":0,"task_id":"gold_load_dim_phase3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
