{"timestamp":"2026-11-20T07:10:11.581835Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_CLASS\n-- Source : silver.TMP_ITEM_MASTER\n-- Parent : DIM_DEPARTMENT (DEPARTMENT_KY via DEPARTMENT_ID, CURR_FLG = TRUE)\n-- SCD    : CLASS_NAME        -> SCD2\n--          CLASS_DESCRIPTION -> SCD1\n-- Dedup  : one row per CLASS_ID from today's batch\n-- KY     : CLASS_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent DEPARTMENT_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_CLASS_SRC AS\nWITH ranked AS (\n    SELECT\n        s.CLASS_ID,\n        s.CLASS_NAME,\n        s.CLASS_DESCRIPTION,\n        s.DEPARTMENT_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.CLASS_ID\n            ORDER BY s._LOAD_TS DESC, s.ITEM_ID DESC\n        ) AS RN\n    FROM silver.TMP_ITEM_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-20'\n      AND s.CLASS_ID IS NOT NULL\n)\nSELECT\n    r.CLASS_ID,\n    r.CLASS_NAME,\n    r.CLASS_DESCRIPTION,\n    d.DEPARTMENT_KY\nFROM ranked r\nJOIN gold.DIM_DEPARTMENT d\n  ON d.DEPARTMENT_ID = r.DEPARTMENT_ID\n AND d.CURR_FLG       = TRUE\nWHERE r.RN = 1;, parameters: None","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2db9-7c2b-a624-78ceeaee5a00","dag_id":"my_etl_dag","try_number":1,"map_index":0,"task_id":"gold_load_dim_phase3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
