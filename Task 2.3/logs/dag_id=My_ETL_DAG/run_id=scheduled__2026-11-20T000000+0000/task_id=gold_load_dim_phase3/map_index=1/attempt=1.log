{"timestamp":"2026-11-20T07:10:12.227168Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for locations whose name (or parent)\n--     changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_LOCATION (\n    LOCATION_ID,\n    LOCATION_NAME, ADDRESS_LINE, DISTRICT_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.LOCATION_ID,\n    src.LOCATION_NAME,\n    src.ADDRESS_LINE,\n    src.DISTRICT_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_STORE_MASTER',\n    DATE '2026-11-20',\n    DATE '2026-11-20',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_LOCATION_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_LOCATION tgt\n    WHERE tgt.LOCATION_ID = src.LOCATION_ID\n      AND tgt.CURR_FLG    = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-20')\n      AND tgt.BATCH_ID    = DATE '2026-11-20'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_LOCATION tgt\n    WHERE tgt.LOCATION_ID = src.LOCATION_ID\n      AND tgt.CURR_FLG    = TRUE\n);, parameters: None","map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f7c9-2dba-7e60-a86b-68634065b648","try_number":1,"run_id":"scheduled__2026-11-20T00:00:00+00:00","task_id":"gold_load_dim_phase3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
