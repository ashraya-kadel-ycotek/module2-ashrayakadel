{"timestamp":"2026-11-20T07:10:11.926192Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose LOCATION_NAME (or parent) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_LOCATION tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-20'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-20'\nFROM TMP_DIM_LOCATION_SRC src\nWHERE tgt.LOCATION_ID = src.LOCATION_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND (\n        COALESCE(tgt.LOCATION_NAME, '') <> COALESCE(src.LOCATION_NAME, '')\n     OR tgt.DISTRICT_KY <> src.DISTRICT_KY\n  );, parameters: None","map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f7c9-2dba-7e60-a86b-68634065b648","try_number":1,"run_id":"scheduled__2026-11-20T00:00:00+00:00","task_id":"gold_load_dim_phase3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
