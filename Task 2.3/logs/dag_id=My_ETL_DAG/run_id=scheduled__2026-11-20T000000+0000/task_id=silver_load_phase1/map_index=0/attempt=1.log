{"timestamp":"2026-11-20T07:09:28.731258Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-20', 'TMP_STORE_MASTER',\n       'DUP_BUSINESS_KEY', 'LOCATION_ID duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nJOIN (\n    SELECT LOCATION_ID\n    FROM bronze.STG_STORE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-20' AND LOCATION_ID IS NOT NULL\n    GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n) d ON d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-20';, parameters: None","map_index":0,"task_id":"silver_load_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2dad-7823-ae97-713b933b86da","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
