{"timestamp":"2026-11-20T07:09:28.408478Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-20', 'TMP_STORE_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required store_master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-20'\n  AND ( s.LOCATION_ID IS NULL OR s.LOCATION_NAME IS NULL\n     OR s.ADDRESS_LINE IS NULL OR s.DISTRICT_ID IS NULL\n     OR s.DISTRICT_NAME IS NULL OR s.DISTRICT_CODE IS NULL\n     OR s.STATE_ID IS NULL OR s.STATE_NAME IS NULL\n     OR s.STATE_CODE IS NULL );, parameters: None","map_index":0,"task_id":"silver_load_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2dad-7823-ae97-713b933b86da","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
