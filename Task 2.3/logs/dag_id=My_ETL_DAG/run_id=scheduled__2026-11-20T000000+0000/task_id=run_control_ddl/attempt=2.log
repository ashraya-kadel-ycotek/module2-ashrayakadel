{"timestamp":"2026-11-20T08:52:51.744190Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------\n-- C_BATCH_RECON — extended for VALUE reconciliations (e.g. net sales).\n-- The base table (row-count recon shape) is created in silver_ddl.sql:\n--   BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT,\n--   VARIANCE, STATUS, RECON_TS\n-- The ALTER below adds value-recon columns. For value-recon rows the\n-- row-count columns are set to 0 and SRC_FILE_NM carries a synthetic\n-- identifier like 'RECON:NET_SLS_FCT_VS_POS' so the existing PK\n-- (BATCH_ID, SRC_FILE_NM, TARGET_TABLE) stays valid.\n-- This block must run AFTER silver_ddl.sql has created C_BATCH_RECON.\n-- ----------------------------------------------------------------------\nALTER TABLE MODULE2_ETL.CONTROL.C_BATCH_RECON\n    ADD COLUMN IF NOT EXISTS CHECK_NAME     VARCHAR(200),\n    ADD COLUMN IF NOT EXISTS SOURCE_A_TABLE VARCHAR(200),\n    ADD COLUMN IF NOT EXISTS SOURCE_A_VAL   NUMBER(38,6),\n    ADD COLUMN IF NOT EXISTS SOURCE_B_TABLE VARCHAR(200),\n    ADD COLUMN IF NOT EXISTS SOURCE_B_VAL   NUMBER(38,6),\n    ADD COLUMN IF NOT EXISTS DIFF_VAL       NUMBER(38,6);, parameters: None","dag_id":"my_etl_dag","map_index":-1,"task_id":"run_control_ddl","try_number":2,"run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f828-8068-7479-b984-7f755b65e484","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
