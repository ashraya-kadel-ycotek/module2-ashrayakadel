 ('gold',   5, 'fct_inventory_load.sql',           'FCT_INVENTORY',        TRUE),\n        ('gold',   6, 'fct_sales_per_week_load.sql',      'FCT_SALES_PER_WEEK',   TRUE)\n) AS s(LAYER, PHASE, SCRIPT_NAME, TARGET_TABLE, IS_ACTIVE)\nON t.SCRIPT_NAME = s.SCRIPT_NAME\nWHEN NOT MATCHED THEN INSERT (LAYER, PHASE, SCRIPT_NAME, TARGET_TABLE, IS_ACTIVE)\nVALUES (s.LAYER, s.PHASE, s.SCRIPT_NAME, s.TARGET_TABLE, s.IS_ACTIVE);, parameters: None","try_number":1,"ti_id":"01a1f7c9-2da1-7e3e-9ad5-cfa9fc17a0d9","dag_id":"my_etl_dag","map_index":-1,"task_id":"run_control_ddl","run_id":"scheduled__2026-11-20T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
