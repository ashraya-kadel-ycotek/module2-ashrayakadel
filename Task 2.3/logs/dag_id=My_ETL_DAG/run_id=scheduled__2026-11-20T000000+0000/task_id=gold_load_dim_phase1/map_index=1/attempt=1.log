{"timestamp":"2026-11-20T07:10:00.448989Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New states — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_STATE (\n    STATE_ID,\n    STATE_NAME, STATE_CODE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.STATE_ID,\n    src.STATE_NAME,\n    src.STATE_CODE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_STORE_MASTER',\n    DATE '2026-11-20',\n    DATE '2026-11-20',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_STATE_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_STATE tgt\n    WHERE tgt.STATE_ID = src.STATE_ID\n);, parameters: None","task_id":"gold_load_dim_phase1","try_number":1,"run_id":"scheduled__2026-11-20T00:00:00+00:00","dag_id":"my_etl_dag","map_index":1,"ti_id":"01a1f7c9-2db5-724d-99a8-a41853016540","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
