{"timestamp":"2026-11-20T07:10:00.878516Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same COMPANY_NAME, but COMPANY_TYPE changed. Overwrite.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_COMPANY tgt\nSET\n    COMPANY_TYPE = src.COMPANY_TYPE,\n    REC_UPDT_TS  = CURRENT_TIMESTAMP(),\n    BATCH_ID     = DATE '2026-11-20'\nFROM TMP_DIM_COMPANY_SRC src\nWHERE tgt.COMPANY_ID  = src.COMPANY_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.COMPANY_NAME, '') = COALESCE(src.COMPANY_NAME, '')\n  AND COALESCE(tgt.COMPANY_TYPE, '') <> COALESCE(src.COMPANY_TYPE, '');, parameters: None","task_id":"gold_load_dim_phase1","ti_id":"01a1f7c9-2db4-7fd3-9a77-8564749aeee3","run_id":"scheduled__2026-11-20T00:00:00+00:00","try_number":1,"map_index":0,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
