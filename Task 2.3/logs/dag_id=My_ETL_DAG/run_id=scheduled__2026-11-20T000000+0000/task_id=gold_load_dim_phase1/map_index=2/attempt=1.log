{"timestamp":"2026-11-20T07:09:59.428338Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_CUSTOMER\n-- Source : silver.TMP_POS_SALES\n-- SCD    : CUSTOMER_NAME / CUSTOMER_EMAIL  -> SCD1 (overwrite in place)\n--          CUSTOMER_PHONE                  -> SCD2 (close old row, open new row)\n-- Dedup  : one row per CUSTOMER_ID from today's batch\n--          ORDER BY SALES_DT DESC, TRANSACTION_ID DESC\n-- KY     : CUSTOMER_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source — exactly one row per CUSTOMER_ID.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_CUSTOMER_SRC AS\nWITH ranked AS (\n    SELECT\n        s.CUSTOMER_ID,\n        s.CUSTOMER_NAME,\n        s.CUSTOMER_EMAIL,\n        s.CUSTOMER_PHONE,\n        s.SALES_DT,\n        s.TRANSACTION_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.CUSTOMER_ID\n            ORDER BY s.SALES_DT DESC,\n                     s.TRANSACTION_ID DESC\n        ) AS RN\n    FROM silver.TMP_POS_SALES s\n    WHERE s._BATCH_ID = DATE '2026-11-20'\n      AND s.CUSTOMER_ID IS NOT NULL\n)\nSELECT\n    CUSTOMER_ID,\n    CUSTOMER_NAME,\n    CUSTOMER_EMAIL,\n    CUSTOMER_PHONE\nFROM ranked\nWHERE RN = 1;, parameters: None","map_index":2,"task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2db6-7408-833b-48064b6182af","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:09:59.973294Z","level":"info","event":"Rows affected: 1","map_index":2,"task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2db6-7408-833b-48064b6182af","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T07:09:59.973543Z","level":"info","event":"Snowflake query id: 01c8884d-0003-1f41-000f-4ff60012e57a","map_index":2,"task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2db6-7408-833b-48064b6182af","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:09:59.973640Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose phone is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CUSTOMER tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-20'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-20'\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.CUSTOMER_PHONE, '') <> COALESCE(src.CUSTOMER_PHONE, '');, parameters: None","map_index":2,"task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-20T00:00:00+00:00","ti_id":"01a1f7c9-2db6-7408-833b-48064b6182af","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
