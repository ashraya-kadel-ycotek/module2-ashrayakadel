{"timestamp":"2026-11-20T07:10:06.472714Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for departments whose name\n--     (or parent company) changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_DEPARTMENT (\n    DEPARTMENT_ID,\n    DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME, COMPANY_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.DEPARTMENT_ID,\n    src.DEPARTMENT_NAME,\n    src.DEPARTMENT_MANAGER_NAME,\n    src.COMPANY_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-20',\n    DATE '2026-11-20',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_DEPARTMENT_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_DEPARTMENT tgt\n    WHERE tgt.DEPARTMENT_ID = src.DEPARTMENT_ID\n      AND tgt.CURR_FLG      = FALSE\n      AND tgt.EFF_TO_DATE   = DATEADD('day', -1, DATE '2026-11-20')\n      AND tgt.BATCH_ID      = DATE '2026-11-20'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_DEPARTMENT tgt\n    WHERE tgt.DEPARTMENT_ID = src.DEPARTMENT_ID\n      AND tgt.CURR_FLG      = TRUE\n);, parameters: None","map_index":0,"ti_id":"01a1f7c9-2db7-7ff1-9d43-9c3519a8457c","try_number":1,"run_id":"scheduled__2026-11-20T00:00:00+00:00","task_id":"gold_load_dim_phase2","dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
