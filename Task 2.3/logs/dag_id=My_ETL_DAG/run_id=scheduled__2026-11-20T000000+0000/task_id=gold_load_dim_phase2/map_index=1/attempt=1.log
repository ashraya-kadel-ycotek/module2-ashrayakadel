{"timestamp":"2026-11-20T07:10:06.030529Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_DISTRICT\n-- Source : silver.TMP_STORE_MASTER\n-- Parent : DIM_STATE (STATE_KY via STATE_ID, CURR_FLG = TRUE)\n-- SCD    : DISTRICT_CODE -> SCD2\n--          DISTRICT_NAME -> SCD1\n-- Dedup  : one row per DISTRICT_ID from today's batch\n-- KY     : DISTRICT_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent STATE_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_DISTRICT_SRC AS\nWITH ranked AS (\n    SELECT\n        s.DISTRICT_ID,\n        s.DISTRICT_NAME,\n        s.DISTRICT_CODE,\n        s.STATE_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.DISTRICT_ID\n            ORDER BY s._LOAD_TS DESC, s.LOCATION_ID DESC\n        ) AS RN\n    FROM silver.TMP_STORE_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-20'\n      AND s.DISTRICT_ID IS NOT NULL\n)\nSELECT\n    r.DISTRICT_ID,\n    r.DISTRICT_NAME,\n    r.DISTRICT_CODE,\n    st.STATE_KY\nFROM ranked r\nJOIN gold.DIM_STATE st\n  ON st.STATE_ID = r.STATE_ID\n AND st.CURR_FLG = TRUE\nWHERE r.RN = 1;, parameters: None","task_id":"gold_load_dim_phase2","run_id":"scheduled__2026-11-20T00:00:00+00:00","try_number":1,"dag_id":"my_etl_dag","ti_id":"01a1f7c9-2db8-7ecd-bbc7-4bdeadd5ae66","map_index":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
