{"timestamp":"2026-11-19T06:09:25.484445Z","level":"info","event":"Running statement: -- ============================================================\n-- CONTROL.C_REJ_TABLE\n-- Rejected rows from all Silver TMP loads.\n-- details holds the full source row as JSON.\n-- ============================================================\nCREATE TABLE IF NOT EXISTS control.C_REJ_TABLE (\n    REJ_ID          NUMBER(38,0)    NOT NULL AUTOINCREMENT,\n    SRC_FILE_NM     VARCHAR(255)    NOT NULL,\n    BATCH_ID        DATE            NOT NULL,\n    TARGET_TABLE    VARCHAR(200)    NOT NULL,\n    FAILURE_TS      TIMESTAMP_NTZ(9) NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REASON_CODE     VARCHAR(50)     NOT NULL,\n    REASON          VARCHAR(1000)   NOT NULL,\n    DETAILS         VARIANT         NOT NULL,\n\n    CONSTRAINT PK_C_REJ_TABLE\n        PRIMARY KEY (REJ_ID),\n    CONSTRAINT CK_C_REJ_REASON_CODE\n        CHECK (REASON_CODE IN (\n            'DUP_BUSINESS_KEY',\n            'NEGATIVE_AMOUNT',\n            'NULL_REQUIRED_FIELD',\n            'REFERENTIAL_INTEGRITY_FAILURE',\n            'TYPE_CAST_FAILURE',\n            'OVERLAPPING_PRICE_RANGE'\n        ))\n)\nCOMMENT = 'Control: rejected rows from Silver layer loads';, parameters: None","ti_id":"01a1f26c-2e42-74f5-9934-3b955d54fde4","task_id":"run_silver_ddl","try_number":1,"run_id":"manual__2026-11-19T06:08:58.384867+00:00","dag_id":"my_etl_dag","map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
