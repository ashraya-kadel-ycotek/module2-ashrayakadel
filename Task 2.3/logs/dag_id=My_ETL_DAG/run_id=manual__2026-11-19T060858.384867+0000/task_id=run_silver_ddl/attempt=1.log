{"timestamp":"2026-11-19T06:09:25.890569Z","level":"info","event":"Running statement: -- ============================================================\n-- SILVER.TMP_INVENTORY_MASTER\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID)\n-- NOTE: referential integrity (ITEM_ID, LOCATION_ID) is\n--       checked in Load SQL, not via DB constraints.\n-- ============================================================\nCREATE TABLE IF NOT EXISTS silver.TMP_INVENTORY_MASTER (\n    -- business columns\n    INVENTORY_DT        DATE            NOT NULL,\n    ITEM_ID             VARCHAR(20)     NOT NULL,\n    LOCATION_ID         VARCHAR(20)     NOT NULL,\n    STOCK_ON_HAND       NUMBER(38,0)    NOT NULL,\n    IN_TRANSIT          NUMBER(38,0)    NOT NULL,\n\n    -- silver audit columns\n    _SRC_FILE_NM        VARCHAR(255)    NOT NULL,\n    _BATCH_ID           DATE            NOT NULL,\n    _LOAD_TS            TIMESTAMP_NTZ(9) NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n\n    CONSTRAINT PK_TMP_INVENTORY_MASTER\n        PRIMARY KEY (ITEM_ID, LOCATION_ID),\n    CONSTRAINT CK_TMP_INV_STOCK_ON_HAND\n        CHECK (STOCK_ON_HAND >= 0),\n    CONSTRAINT CK_TMP_INV_IN_TRANSIT\n        CHECK (IN_TRANSIT >= 0)\n)\nCOMMENT = 'Silver staging: validated inventory snapshot';, parameters: None","ti_id":"01a1f26c-2e42-74f5-9934-3b955d54fde4","task_id":"run_silver_ddl","try_number":1,"run_id":"manual__2026-11-19T06:08:58.384867+00:00","dag_id":"my_etl_dag","map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
