{"timestamp":"2026-11-19T09:51:42.484623Z","level":"info","event":"Running statement: -- 5.2 NULL required fields\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_PRICE_MASTER',\n       'NULL_REQUIRED_FIELD',\n       'Required price master field is NULL',\n       OBJECT_CONSTRUCT(*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND (\n       s.PRICE_DT IS NULL\n    OR s.ITEM_ID IS NULL\n    OR s.LOCATION_ID IS NULL\n    OR s.UNIT_PRICE_AMT IS NULL\n    OR s.EFF_FROM_DATE IS NULL\n    OR s.EFF_TO_DATE IS NULL\n  );, parameters: None","task_id":"load_silver_data","ti_id":"01a1f332-f04e-7351-aa2d-40b47483b75d","run_id":"manual__2026-11-19T09:46:04.200551+00:00","map_index":-1,"try_number":1,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
