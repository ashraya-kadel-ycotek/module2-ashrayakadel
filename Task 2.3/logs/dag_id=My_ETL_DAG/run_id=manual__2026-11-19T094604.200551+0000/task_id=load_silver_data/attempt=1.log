{"timestamp":"2026-11-19T09:51:43.895071Z","level":"info","event":"Running statement: -- 5.8 Batch reconciliation\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE,\n     BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\n\nWITH b AS (\n    SELECT COUNT(*) c\n    FROM bronze.STG_PRICE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-19'\n),\nr AS (\n    SELECT COUNT(*) c\n    FROM control.C_REJ_TABLE\n    WHERE BATCH_ID = DATE '2026-11-19'\n      AND TARGET_TABLE = 'TMP_PRICE_MASTER'\n),\nt AS (\n    SELECT COUNT(*) c\n    FROM bronze.STG_PRICE_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-19'\n      AND NOT EXISTS (\n          SELECT 1\n          FROM control.C_REJ_TABLE r\n          WHERE r.BATCH_ID = DATE '2026-11-19'\n            AND r.TARGET_TABLE = 'TMP_PRICE_MASTER'\n            AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n            AND r.DETAILS:SRC_ROW_NUM::NUMBER = s.SRC_ROW_NUM\n      )\n)\nSELECT\n    DATE '2026-11-19',\n    COALESCE(\n        (SELECT MAX(SRC_FILE_NM)\n         FROM bronze.STG_PRICE_MASTER\n         WHERE BATCH_ID = DATE '2026-11-19'),\n        'price_master'\n    ),\n    'TMP_PRICE_MASTER',\n    b.c,\n    t.c,\n    r.c,\n    b.c - (t.c + r.c),\n    CASE\n        WHEN b.c = (t.c + r.c) THEN 'PASSED'\n        ELSE 'FAILED'\n    END\nFROM b, r, t;, parameters: None","task_id":"load_silver_data","ti_id":"01a1f332-f04e-7351-aa2d-40b47483b75d","run_id":"manual__2026-11-19T09:46:04.200551+00:00","map_index":-1,"try_number":1,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
