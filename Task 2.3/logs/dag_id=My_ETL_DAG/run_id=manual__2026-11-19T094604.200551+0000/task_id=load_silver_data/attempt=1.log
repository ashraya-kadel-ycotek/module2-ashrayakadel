{"timestamp":"2026-11-19T09:51:36.867634Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_ITEM_MASTER',\n       'DUP_BUSINESS_KEY',\n       'Composite (ITEM_ID, CLASS_ID, DEPARTMENT_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(*)\nFROM bronze.STG_ITEM_MASTER s\nJOIN (\n    SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n    FROM bronze.STG_ITEM_MASTER\n    WHERE BATCH_ID = DATE '2026-11-19'\n    GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n) d ON  d.ITEM_ID = s.ITEM_ID\n    AND d.CLASS_ID = s.CLASS_ID\n    AND d.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHERE s.BATCH_ID = DATE '2026-11-19';, parameters: None","task_id":"load_silver_data","ti_id":"01a1f332-f04e-7351-aa2d-40b47483b75d","run_id":"manual__2026-11-19T09:46:04.200551+00:00","map_index":-1,"try_number":1,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
