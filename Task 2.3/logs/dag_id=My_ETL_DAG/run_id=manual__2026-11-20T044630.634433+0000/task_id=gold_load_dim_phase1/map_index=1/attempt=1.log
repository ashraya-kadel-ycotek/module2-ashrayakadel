{"timestamp":"2026-11-20T04:47:33.784445Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same STATE_CODE, but STATE_NAME changed. Overwrite.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_STATE tgt\nSET\n    STATE_NAME  = src.STATE_NAME,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-20'\nFROM TMP_DIM_STATE_SRC src\nWHERE tgt.STATE_ID  = src.STATE_ID\n  AND tgt.CURR_FLG  = TRUE\n  AND COALESCE(tgt.STATE_CODE, '') = COALESCE(src.STATE_CODE, '')\n  AND COALESCE(tgt.STATE_NAME, '') <> COALESCE(src.STATE_NAME, '');, parameters: None","task_id":"gold_load_dim_phase1","run_id":"manual__2026-11-20T04:46:30.634433+00:00","try_number":1,"map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f747-0b21-76f5-86af-29b7b3156bba","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
