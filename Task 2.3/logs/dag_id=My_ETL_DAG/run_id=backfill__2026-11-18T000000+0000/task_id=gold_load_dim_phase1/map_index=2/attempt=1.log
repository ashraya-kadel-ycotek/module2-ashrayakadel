{"timestamp":"2026-11-20T08:29:06.757401Z","level":"info","event":"Snowflake query id: 01c8889d-0003-1f41-000f-4ff60013d092","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f80a-9d1a-7eb2-bd65-635bb103a266","task_id":"gold_load_dim_phase1","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T08:29:06.757475Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose phone is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CUSTOMER tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-18'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-18'\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.CUSTOMER_PHONE, '') <> COALESCE(src.CUSTOMER_PHONE, '');, parameters: None","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f80a-9d1a-7eb2-bd65-635bb103a266","task_id":"gold_load_dim_phase1","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
