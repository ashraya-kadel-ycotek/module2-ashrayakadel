{"timestamp":"2026-11-20T09:59:23.611356Z","level":"info","event":"Running statement: -- Silver targets\n-- Append one load event per target for this (batch, run).\n-- NOT EXISTS makes a task retry/clear safe (Snowflake does not enforce the UNIQUE).\n\nINSERT INTO control.C_LOAD_DATES (TARGET_TABLE, LAYER, BATCH_ID, RUN_ID)\nSELECT s.TARGET_TABLE, s.LAYER, DATE '2026-11-18', 'backfill__2026-11-18T00:00:00+00:00'\nFROM (VALUES\n    ('silver', 'TMP_STORE_MASTER'),\n    ('silver', 'TMP_ITEM_MASTER'),\n    ('silver', 'TMP_INVENTORY_MASTER'),\n    ('silver', 'TMP_POS_SALES'),\n    ('silver', 'TMP_PRICE_MASTER')\n) AS s(LAYER, TARGET_TABLE)\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM control.C_LOAD_DATES t\n    WHERE t.TARGET_TABLE = s.TARGET_TABLE\n      AND t.BATCH_ID     = DATE '2026-11-18'\n      AND t.RUN_ID       = 'backfill__2026-11-18T00:00:00+00:00'\n);, parameters: None","dag_id":"my_etl_dag","map_index":-1,"task_id":"stamp_silver","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f85d-8a62-7a00-beb2-47aebb5c2df3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
