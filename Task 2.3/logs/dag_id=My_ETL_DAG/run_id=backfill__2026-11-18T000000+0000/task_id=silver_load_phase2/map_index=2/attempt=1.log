{"timestamp":"2026-11-20T06:31:13.127958Z","level":"info","event":"Running statement: -- 5.4 Invalid effective date range\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-18', 'TMP_PRICE_MASTER',\n       'TYPE_CAST_FAILURE',\n       'EFF_TO_DATE is earlier than EFF_FROM_DATE',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-18'\n  AND TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') IS NOT NULL\n  AND TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') IS NOT NULL\n  AND TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD')\n      < TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD');, parameters: None","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f79d-e2ce-7249-93d5-079b9197fa29","task_id":"silver_load_phase2","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
