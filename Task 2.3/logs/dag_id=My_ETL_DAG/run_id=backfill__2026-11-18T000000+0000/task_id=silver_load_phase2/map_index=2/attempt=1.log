{"timestamp":"2026-11-20T08:28:45.894453Z","level":"info","event":"Running statement: -- 5.2 NULL required fields\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-18', 'TMP_PRICE_MASTER',\n       'NULL_REQUIRED_FIELD',\n       'Required price master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-18'\n  AND (\n       s.PRICE_DT IS NULL\n    OR s.ITEM_ID IS NULL\n    OR s.LOCATION_ID IS NULL\n    OR s.UNIT_PRICE_AMT IS NULL\n    OR s.EFF_FROM_DATE IS NULL\n    OR s.EFF_TO_DATE IS NULL\n  );, parameters: None","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f80a-9d15-75bb-8f52-0ecad51274dc","task_id":"silver_load_phase2","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
