{"timestamp":"2026-11-20T08:28:23.640966Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA control;\n\n-- Watermark bronze targets after all bronze loads succeeded.\n-- The < DATE '2026-11-18' guard prevents backfills from moving watermarks backwards.\n\nMERGE INTO control.C_LOAD_DATES t\nUSING (SELECT 'bronze' AS LAYER, 'STG_STORE_MASTER' AS TARGET_TABLE) s\nON t.TARGET_TABLE = s.TARGET_TABLE\nWHEN MATCHED AND t.LAST_LOADED_DT < DATE '2026-11-18' THEN UPDATE SET\n    LAST_LOADED_DT = DATE '2026-11-18', LAST_RUN_ID = 'backfill__2026-11-18T00:00:00+00:00', LAST_UPDATED_AT = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN INSERT (TARGET_TABLE, LAYER, LAST_LOADED_DT, LAST_RUN_ID)\nVALUES (s.TARGET_TABLE, s.LAYER, DATE '2026-11-18', 'backfill__2026-11-18T00:00:00+00:00');\n\nMERGE INTO control.C_LOAD_DATES t\nUSING (SELECT 'bronze' AS LAYER, 'STG_ITEM_MASTER' AS TARGET_TABLE) s\nON t.TARGET_TABLE = s.TARGET_TABLE\nWHEN MATCHED AND t.LAST_LOADED_DT < DATE '2026-11-18' THEN UPDATE SET\n    LAST_LOADED_DT = DATE '2026-11-18', LAST_RUN_ID = 'backfill__2026-11-18T00:00:00+00:00', LAST_UPDATED_AT = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN INSERT (TARGET_TABLE, LAYER, LAST_LOADED_DT, LAST_RUN_ID)\nVALUES (s.TARGET_TABLE, s.LAYER, DATE '2026-11-18', 'backfill__2026-11-18T00:00:00+00:00');\n\nMERGE INTO control.C_LOAD_DATES t\nUSING (SELECT 'bronze' AS LAYER, 'STG_INVENTORY_MASTER' AS TARGET_TABLE) s\nON t.TARGET_TABLE = s.TARGET_TABLE\nWHEN MATCHED AND t.LAST_LOADED_DT < DATE '2026-11-18' THEN UPDATE SET\n    LAST_LOADED_DT = DATE '2026-11-18', LAST_RUN_ID = 'backfill__2026-11-18T00:00:00+00:00', LAST_UPDATED_AT = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN INSERT (TARGET_TABLE, LAYER, LAST_LOADED_DT, LAST_RUN_ID)\nVALUES (s.TARGET_TABLE, s.LAYER, DATE '2026-11-18', 'backfill__2026-11-18T00:00:00+00:00');\n\nMERGE INTO control.C_LOAD_DATES t\nUSING (SELECT 'bronze' AS LAYER, 'STG_POS_SALES' AS TARGET_TABLE) s\nON t.TARGET_TABLE = s.TARGET_TABLE\nWHEN MATCHED AND t.LAST_LOADED_DT < DATE '2026-11-18' THEN UPDATE SET\n    LAST_LOADED_DT = DATE '2026-11-18', LAST_RUN_ID = 'backfill__2026-11-18T00:00:00+00:00', LAST_UPDATED_AT = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN INSERT (TARGET_TABLE, LAYER, LAST_LOADED_DT, LAST_RUN_ID)\nVALUES (s.TARGET_TABLE, s.LAYER, DATE '2026-11-18', 'backfill__2026-11-18T00:00:00+00:00');\n\nMERGE INTO control.C_LOAD_DATES t\nUSING (SELECT 'bronze' AS LAYER, 'STG_PRICE_MASTER' AS TARGET_TABLE) s\nON t.TARGET_TABLE = s.TARGET_TABLE\nWHEN MATCHED AND t.LAST_LOADED_DT < DATE '2026-11-18' THEN UPDATE SET\n    LAST_LOADED_DT = DATE '2026-11-18', LAST_RUN_ID = 'backfill__2026-11-18T00:00:00+00:00', LAST_UPDATED_AT = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN INSERT (TARGET_TABLE, LAYER, LAST_LOADED_DT, LAST_RUN_ID)\nVALUES (s.TARGET_TABLE, s.LAYER, DATE '2026-11-18', 'backfill__2026-11-18T00:00:00+00:00');","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f80a-9d0e-7b31-9f9e-33f0550a9ebb","task_id":"stamp_bronze","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
