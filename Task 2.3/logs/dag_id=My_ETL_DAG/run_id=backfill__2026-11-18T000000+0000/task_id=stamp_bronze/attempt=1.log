{"timestamp":"2026-11-20T09:58:54.193674Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA control;\n\n-- Bronze targets\n-- Append one load event per target for this (batch, run).\n-- NOT EXISTS makes a task retry/clear safe (Snowflake does not enforce the UNIQUE).\n\nINSERT INTO control.C_LOAD_DATES (TARGET_TABLE, LAYER, BATCH_ID, RUN_ID)\nSELECT s.TARGET_TABLE, s.LAYER, DATE '2026-11-18', 'backfill__2026-11-18T00:00:00+00:00'\nFROM (VALUES\n    ('bronze', 'STG_STORE_MASTER'),\n    ('bronze', 'STG_ITEM_MASTER'),\n    ('bronze', 'STG_INVENTORY_MASTER'),\n    ('bronze', 'STG_POS_SALES'),\n    ('bronze', 'STG_PRICE_MASTER')\n) AS s(LAYER, TARGET_TABLE)\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM control.C_LOAD_DATES t\n    WHERE t.TARGET_TABLE = s.TARGET_TABLE\n      AND t.BATCH_ID     = DATE '2026-11-18'\n      AND t.RUN_ID       = 'backfill__2026-11-18T00:00:00+00:00'\n);","map_index":-1,"task_id":"stamp_bronze","dag_id":"my_etl_dag","try_number":1,"ti_id":"01a1f85d-8a5a-78e4-9d06-537cba5b0622","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
