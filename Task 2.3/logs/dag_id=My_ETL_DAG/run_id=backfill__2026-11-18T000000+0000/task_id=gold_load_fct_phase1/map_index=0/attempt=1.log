{"timestamp":"2026-11-20T07:23:12.997163Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. Write join-miss rows to the reject table.\n-- ----------------------------------------------------------------------------\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT\n    s.SRC_FILE_NM,\n    DATE '2026-11-18',\n    'FCT_SALES',\n    'REFERENTIAL_INTEGRITY_FAILURE',\n    'DAY_KY / ITEM_KY / LOCATION_KY / CUSTOMER_KY could not be resolved as-of SALES_DT',\n    OBJECT_CONSTRUCT(\n        'TRANSACTION_ID',          s.TRANSACTION_ID,\n        'TRANSACTION_LINE_NUMBER', s.TRANSACTION_LINE_NUMBER,\n        'SALES_DT',                s.SALES_DT,\n        'ITEM_ID',                 s.ITEM_ID,\n        'LOCATION_ID',             s.LOCATION_ID,\n        'CUSTOMER_ID',             s.CUSTOMER_ID,\n        'SLS_QTY',                 s.SLS_QTY,\n        'SLS_AMT',                 s.SLS_AMT,\n        'DAY_KY',                  s.DAY_KY,\n        'ITEM_KY',                 s.ITEM_KY,\n        'LOCATION_KY',             s.LOCATION_KY,\n        'CUSTOMER_KY',             s.CUSTOMER_KY,\n        'SRC_FILE_NM',             s.SRC_FILE_NM,\n        'SRC_ROW_HASH',            s.SRC_ROW_HASH\n    )\nFROM TMP_FCT_SALES_STG s\nWHERE s.RI_FAIL_FLG = TRUE;, parameters: None","task_id":"gold_load_fct_phase1","dag_id":"my_etl_dag","ti_id":"01a1f7ce-3924-7a65-a473-2a242ce762ba","map_index":0,"try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
