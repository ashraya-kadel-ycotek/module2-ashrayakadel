{"timestamp":"2026-11-20T07:22:55.121804Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same DISTRICT_CODE (and same parent), but NAME changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DISTRICT tgt\nSET\n    DISTRICT_NAME = src.DISTRICT_NAME,\n    REC_UPDT_TS   = CURRENT_TIMESTAMP(),\n    BATCH_ID      = DATE '2026-11-18'\nFROM TMP_DIM_DISTRICT_SRC src\nWHERE tgt.DISTRICT_ID = src.DISTRICT_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.DISTRICT_CODE, '') = COALESCE(src.DISTRICT_CODE, '')\n  AND tgt.STATE_KY = src.STATE_KY\n  AND COALESCE(tgt.DISTRICT_NAME, '') <> COALESCE(src.DISTRICT_NAME, '');, parameters: None","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f7ce-3920-7d5e-80ad-7a140b313ab6","task_id":"gold_load_dim_phase2","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
