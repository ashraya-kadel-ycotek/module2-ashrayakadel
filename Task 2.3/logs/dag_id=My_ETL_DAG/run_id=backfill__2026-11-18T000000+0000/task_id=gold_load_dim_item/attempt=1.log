{"timestamp":"2026-11-20T09:59:55.180941Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_ITEM\n-- Source : silver.TMP_ITEM_MASTER\n-- Parent : DIM_CLASS (CLASS_KY via CLASS_ID, CURR_FLG = TRUE)\n-- SCD    : ITEM_NAME, COLOR, SIZE -> SCD2 (all attrs are SCD2 per ERD)\n-- Dedup  : one row per ITEM_ID from today's batch\n-- KY     : ITEM_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent CLASS_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_ITEM_SRC AS\nWITH ranked AS (\n    SELECT\n        s.ITEM_ID,\n        s.ITEM_NAME,\n        s.COLOR,\n        s.SIZE,\n        s.CLASS_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.ITEM_ID\n            ORDER BY s._LOAD_TS DESC, s.ITEM_ID DESC\n        ) AS RN\n    FROM silver.TMP_ITEM_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-18'\n      AND s.ITEM_ID IS NOT NULL\n)\nSELECT\n    r.ITEM_ID,\n    r.ITEM_NAME,\n    r.COLOR,\n    r.SIZE,\n    c.CLASS_KY\nFROM ranked r\nJOIN gold.DIM_CLASS c\n  ON c.CLASS_ID = r.CLASS_ID\n AND c.CURR_FLG = TRUE\nWHERE r.RN = 1;, parameters: None","map_index":-1,"task_id":"gold_load_dim_item","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f85d-8a6b-7819-92aa-7bba0fcb6b86","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
