{"timestamp":"2026-11-20T07:23:06.476176Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for items whose attributes\n--     (or parent class) changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_ITEM (\n    ITEM_ID,\n    ITEM_NAME, COLOR, SIZE, CLASS_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.ITEM_ID,\n    src.ITEM_NAME,\n    src.COLOR,\n    src.SIZE,\n    src.CLASS_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-18',\n    DATE '2026-11-18',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_ITEM_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_ITEM tgt\n    WHERE tgt.ITEM_ID = src.ITEM_ID\n      AND tgt.CURR_FLG = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-18')\n      AND tgt.BATCH_ID = DATE '2026-11-18'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_ITEM tgt\n    WHERE tgt.ITEM_ID = src.ITEM_ID\n      AND tgt.CURR_FLG = TRUE\n);, parameters: None","map_index":-1,"task_id":"gold_load_dim_item","dag_id":"my_etl_dag","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f7ce-3923-708f-bca7-3bb9305f8c27","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
