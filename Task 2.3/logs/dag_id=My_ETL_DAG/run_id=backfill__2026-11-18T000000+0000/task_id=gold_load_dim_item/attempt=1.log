{"timestamp":"2026-11-20T07:23:05.795462Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_ITEM\n-- Source : silver.TMP_ITEM_MASTER\n-- Parent : DIM_CLASS (CLASS_KY via CLASS_ID, CURR_FLG = TRUE)\n-- SCD    : ITEM_NAME, COLOR, SIZE -> SCD2 (all attrs are SCD2 per ERD)\n-- Dedup  : one row per ITEM_ID from today's batch\n-- KY     : ITEM_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent CLASS_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_ITEM_SRC AS\nWITH ranked AS (\n    SELECT\n        s.ITEM_ID,\n        s.ITEM_NAME,\n        s.COLOR,\n        s.SIZE,\n        s.CLASS_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.ITEM_ID\n            ORDER BY s._LOAD_TS DESC, s.ITEM_ID DESC\n        ) AS RN\n    FROM silver.TMP_ITEM_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-18'\n      AND s.ITEM_ID IS NOT NULL\n)\nSELECT\n    r.ITEM_ID,\n    r.ITEM_NAME,\n    r.COLOR,\n    r.SIZE,\n    c.CLASS_KY\nFROM ranked r\nJOIN gold.DIM_CLASS c\n  ON c.CLASS_ID = r.CLASS_ID\n AND c.CURR_FLG = TRUE\nWHERE r.RN = 1;, parameters: None","map_index":-1,"task_id":"gold_load_dim_item","dag_id":"my_etl_dag","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f7ce-3923-708f-bca7-3bb9305f8c27","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:23:06.273522Z","level":"info","event":"Rows affected: 1","map_index":-1,"task_id":"gold_load_dim_item","dag_id":"my_etl_dag","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f7ce-3923-708f-bca7-3bb9305f8c27","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T07:23:06.273764Z","level":"info","event":"Snowflake query id: 01c8885b-0003-1f16-000f-4ff600134066","map_index":-1,"task_id":"gold_load_dim_item","dag_id":"my_etl_dag","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f7ce-3923-708f-bca7-3bb9305f8c27","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:23:06.273825Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose ITEM_NAME / COLOR / SIZE\n--    (or parent CLASS_KY) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_ITEM tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-18'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-18'\nFROM TMP_DIM_ITEM_SRC src\nWHERE tgt.ITEM_ID = src.ITEM_ID\n  AND tgt.CURR_FLG = TRUE\n  AND (\n        COALESCE(tgt.ITEM_NAME, '') <> COALESCE(src.ITEM_NAME, '')\n     OR COALESCE(tgt.COLOR,     '') <> COALESCE(src.COLOR,     '')\n     OR COALESCE(tgt.SIZE,      '') <> COALESCE(src.SIZE,      '')\n     OR tgt.CLASS_KY <> src.CLASS_KY\n  );, parameters: None","map_index":-1,"task_id":"gold_load_dim_item","dag_id":"my_etl_dag","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f7ce-3923-708f-bca7-3bb9305f8c27","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
