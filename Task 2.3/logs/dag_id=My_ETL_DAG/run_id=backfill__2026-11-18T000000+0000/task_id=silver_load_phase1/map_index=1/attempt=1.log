{"timestamp":"2026-11-20T09:59:09.109679Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-18', 'TMP_ITEM_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required item_master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_ITEM_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-18'\n  AND ( s.ITEM_ID IS NULL OR s.ITEM_NAME IS NULL OR s.COLOR IS NULL\n     OR s.SIZE IS NULL OR s.CLASS_ID IS NULL OR s.CLASS_NAME IS NULL\n     OR s.CLASS_DESCRIPTION IS NULL OR s.DEPARTMENT_ID IS NULL\n     OR s.DEPARTMENT_NAME IS NULL OR s.DEPARTMENT_MANAGER_NAME IS NULL\n     OR s.COMPANY_ID IS NULL OR s.COMPANY_NAME IS NULL\n     OR s.COMPANY_TYPE IS NULL );, parameters: None","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f85d-8a5e-7304-8307-8248c191e5f4","task_id":"silver_load_phase1","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
