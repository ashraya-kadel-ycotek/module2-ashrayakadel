{"timestamp":"2026-11-20T09:59:09.515911Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-18', 'TMP_ITEM_MASTER',\n       'DUP_BUSINESS_KEY',\n       'Composite (ITEM_ID, CLASS_ID, DEPARTMENT_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_ITEM_MASTER s\nJOIN (\n    SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n    FROM bronze.STG_ITEM_MASTER\n    WHERE BATCH_ID = DATE '2026-11-18'\n    GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n) d ON  d.ITEM_ID = s.ITEM_ID\n    AND d.CLASS_ID = s.CLASS_ID\n    AND d.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHERE s.BATCH_ID = DATE '2026-11-18';, parameters: None","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f85d-8a5e-7304-8307-8248c191e5f4","task_id":"silver_load_phase1","run_id":"backfill__2026-11-18T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
