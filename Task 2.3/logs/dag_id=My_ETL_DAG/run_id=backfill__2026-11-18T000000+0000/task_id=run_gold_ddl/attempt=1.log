{"timestamp":"2026-11-20T07:22:41.262728Z","level":"info","event":"Running statement: -- DIM_QUARTER\nMERGE INTO MODULE2_ETL.GOLD.DIM_QUARTER t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT YEAR(q) * 10 + QUARTER(q) AS QUARTER_ID,\n               QUARTER(q) AS QUARTER_NUMBER,\n               'Q' || TO_VARCHAR(QUARTER(q)) || ' ' || TO_VARCHAR(YEAR(q)) AS QUARTER_NAME,\n               py.YEAR_KY\n        FROM qtr\n        JOIN MODULE2_ETL.GOLD.DIM_YEAR py ON py.YEAR_ID = YEAR(q) AND py.CURR_FLG = TRUE\n        ORDER BY q\n      ) s\n   ON t.QUARTER_ID = s.QUARTER_ID\nWHEN NOT MATCHED THEN INSERT (QUARTER_ID, QUARTER_NUMBER, QUARTER_NAME, YEAR_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.QUARTER_ID, s.QUARTER_NUMBER, s.QUARTER_NAME, s.YEAR_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);, parameters: None","dag_id":"my_etl_dag","run_id":"backfill__2026-11-18T00:00:00+00:00","ti_id":"01a1f7ce-391b-7b94-a42e-b5211e13cc18","task_id":"run_gold_ddl",