{"timestamp":"2026-11-20T09:59:29.728175Z","level":"info","event":"Running statement: -- DIM_MONTH\nMERGE INTO MODULE2_ETL.GOLD.DIM_MONTH t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT YEAR(m) * 100 + MONTH(m) AS MONTH_ID,\n               DECODE(MONTH(m), 1,'January',2,'February',3,'March',4,'April',5,'May',6,'June',7,'July',8,'August',9,'September',10,'October',11,'November',12,'December') AS MONTH_NAME,\n               MONTH(m) AS MONTH_NUMBER,\n               DAY(LAST_DAY(m)) AS DAYS_IN_MONTH_NUMBER,\n               pq.QUARTER_KY\n        FROM mth\n        JOIN MODULE2_ETL.GOLD.DIM_QUARTER pq ON pq.QUARTER_ID = YEAR(m) * 10 + QUARTER(m) AND pq.CURR_FLG = TRUE\n        ORDER BY m\n      ) s\n   ON t.MONTH_ID = s.MONTH_ID\nWHEN NOT MATCHED THEN INSERT (MONTH_ID, MONTH_NAME, MONTH_NUMBER, DAYS_IN_MONTH_NUMBER, QUARTER_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.MONTH_ID, s.MONTH_NAME, s.MONTH_NUMBER, s.DAYS_IN_MONTH_NUMBER, s.QUARTER_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);, parameters: None","dag_id":"my_etl_dag","task_id":"run_gold_ddl","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","map_index":-1,"ti_id":"01a1f85d-8a63-7767-9d91-04505a3d091b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
