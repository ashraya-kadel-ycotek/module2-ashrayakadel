{"timestamp":"2026-11-20T08:29:02.778840Z","level":"info","event":"Running statement: -- DIM_DAY\nMERGE INTO MODULE2_ETL.GOLD.DIM_DAY t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        )\n        SELECT YEAR(dt) * 10000 + MONTH(dt) * 100 + DAY(dt) AS DAY_ID,\n               dt AS CALENDAR_DT,\n               DAYOFWEEKISO(dt) AS DAY_OF_WEEK_NUMBER,\n               DAY(dt) AS DAY_OF_MONTH_NUMBER,\n               (DAYOFWEEKISO(dt) >= 6) AS WEEKEND_FLG,\n               pw.WEEK_KY\n        FROM d\n        JOIN MODULE2_ETL.GOLD.DIM_WEEK pw\n          ON pw.WEEK_ID = YEAROFWEEKISO(dt) * 100 + WEEKISO(dt)\n         AND pw.CURR_FLG = TRUE\n        ORDER BY dt\n      ) s\n   ON t.DAY_ID = s.DAY_ID\nWHEN NOT MATCHED THEN INSERT (DAY_ID, CALENDAR_DT, DAY_OF_WEEK_NUMBER, DAY_OF_MONTH_NUMBER, WEEKEND_FLG, WEEK_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.DAY_ID, s.CALENDAR_DT, s.DAY_OF_WEEK_NUMBER, s.DAY_OF_MONTH_NUMBER, s.WEEKEND_FLG, s.WEEK_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);, parameters: None","try_number":1,"task_id":"run_gold_ddl","map_index":-1,"run_id":"backfill__2026-11-18T00:00:00+00:00","dag_id":"my_etl_dag","ti_id":"01a1f80a-9d17-7d31-8d2a-d5a942d4c6de","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno