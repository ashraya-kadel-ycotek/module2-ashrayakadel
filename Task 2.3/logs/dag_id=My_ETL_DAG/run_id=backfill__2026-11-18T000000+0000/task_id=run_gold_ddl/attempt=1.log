{"timestamp":"2026-11-20T09:59:30.137540Z","level":"info","event":"Running statement: -- DIM_WEEK\nMERGE INTO MODULE2_ETL.GOLD.DIM_WEEK t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT wy * 100 + wn AS WEEK_ID,\n               wstart AS WEEK_START_DT,\n               DATEADD(DAY, 6, wstart) AS WEEK_END_DT,\n               wn AS WEEK_OF_YEAR_NUMBER,\n               pm.MONTH_KY\n        FROM wk\n        JOIN MODULE2_ETL.GOLD.DIM_MONTH pm\n          ON pm.MONTH_ID = YEAR(DATEADD(DAY, 3, wstart)) * 100 + MONTH(DATEADD(DAY, 3, wstart))\n         AND pm.CURR_FLG = TRUE\n        ORDER BY wstart\n      ) s\n   ON t.WEEK_ID = s.WEEK_ID\nWHEN NOT MATCHED THEN INSERT (WEEK_ID, WEEK_START_DT, WEEK_END_DT, WEEK_OF_YEAR_NUMBER, MONTH_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.WEEK_ID, s.WEEK_START_DT, s.WEEK_END_DT, s.WEEK_OF_YEAR_NUMBER, s.MONTH_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);, parameters: None","dag_id":"my_etl_dag","task_id":"run_gold_ddl","try_number":1,"run_id":"backfill__2026-11-18T00:00:00+00:00","map_index":-1,"ti_id":"01a1f85d-8a63-7767-9d91-04505a3d091b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
