{"timestamp":"2026-11-20T03:20:34.056037Z","level":"info","event":"Running statement: -- 4.7 Recon\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_POS_SALES WHERE BATCH_ID = DATE '2026-11-18'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-18' AND TARGET_TABLE = 'TMP_POS_SALES'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_POS_SALES s\n        WHERE s.BATCH_ID = DATE '2026-11-18'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-18' AND r.TARGET_TABLE = 'TMP_POS_SALES'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-18',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_POS_SALES WHERE BATCH_ID = DATE '2026-11-18'),'pos_sales'),\n       'TMP_POS_SALES', b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;, parameters: None","task_id":"silver_load_phase2","ti_id":"01a1f6f2-821a-7070-a1ef-28041aee1f13","run_id":"backfill__2026-11-18T18:15:00+00:00","dag_id":"my_etl_dag","map_index":1,"try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
