{"timestamp":"2026-11-20T09:49:07.535703Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but DESCRIPTION changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CLASS tgt\nSET\n    CLASS_DESCRIPTION = src.CLASS_DESCRIPTION,\n    REC_UPDT_TS       = CURRENT_TIMESTAMP(),\n    BATCH_ID          = DATE '2026-11-14'\nFROM TMP_DIM_CLASS_SRC src\nWHERE tgt.CLASS_ID = src.CLASS_ID\n  AND tgt.CURR_FLG = TRUE\n  AND COALESCE(tgt.CLASS_NAME, '') = COALESCE(src.CLASS_NAME, '')\n  AND tgt.DEPARTMENT_KY = src.DEPARTMENT_KY\n  AND COALESCE(tgt.CLASS_DESCRIPTION, '') <> COALESCE(src.CLASS_DESCRIPTION, '');, parameters: None","task_id":"gold_load_dim_phase3","try_number":2,"ti_id":"01a1f85b-209e-7c93-bcc7-19a866906498","dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","map_index":0,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
