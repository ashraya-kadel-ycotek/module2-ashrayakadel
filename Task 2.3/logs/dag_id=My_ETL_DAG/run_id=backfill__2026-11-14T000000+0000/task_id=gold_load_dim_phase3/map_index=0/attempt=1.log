{"timestamp":"2026-11-20T07:15:35.156600Z","level":"info","event":"Snowflake query id: 01c88853-0003-1f61-000f-4ff600129a92","map_index":0,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f7ce-3809-7bea-8525-0676e962e4f8","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:15:35.156764Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose CLASS_NAME (or parent) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CLASS tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-14'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-14'\nFROM TMP_DIM_CLASS_SRC src\nWHERE tgt.CLASS_ID = src.CLASS_ID\n  AND tgt.CURR_FLG = TRUE\n  AND (\n        COALESCE(tgt.CLASS_NAME, '') <> COALESCE(src.CLASS_NAME, '')\n     OR tgt.DEPARTMENT_KY <> src.DEPARTMENT_KY\n  );, parameters: None","map_index":0,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f7ce-3809-7bea-8525-0676e962e4f8","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
