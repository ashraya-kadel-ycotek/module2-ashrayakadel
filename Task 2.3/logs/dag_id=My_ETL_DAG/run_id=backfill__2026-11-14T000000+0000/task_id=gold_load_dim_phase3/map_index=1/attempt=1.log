{"timestamp":"2026-11-20T08:21:41.941913Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but ADDRESS_LINE changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_LOCATION tgt\nSET\n    ADDRESS_LINE = src.ADDRESS_LINE,\n    REC_UPDT_TS  = CURRENT_TIMESTAMP(),\n    BATCH_ID     = DATE '2026-11-14'\nFROM TMP_DIM_LOCATION_SRC src\nWHERE tgt.LOCATION_ID = src.LOCATION_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.LOCATION_NAME, '') = COALESCE(src.LOCATION_NAME, '')\n  AND tgt.DISTRICT_KY = src.DISTRICT_KY\n  AND COALESCE(tgt.ADDRESS_LINE, '') <> COALESCE(src.ADDRESS_LINE, '');, parameters: None","task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","map_index":1,"ti_id":"01a1f80a-9c06-774b-80a6-62efc69ae363","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
