{"timestamp":"2026-11-20T07:15:35.642067Z","level":"info","event":"Snowflake query id: 01c88853-0003-1ebf-000f-4ff600122bf2","task_id":"gold_load_dim_phase3","try_number":1,"run_id":"backfill__2026-11-14T00:00:00+00:00","dag_id":"my_etl_dag","map_index":1,"ti_id":"01a1f7ce-380a-7323-b3ce-2018f24a55cc","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:15:35.642195Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose LOCATION_NAME (or parent) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_LOCATION tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-14'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-14'\nFROM TMP_DIM_LOCATION_SRC src\nWHERE tgt.LOCATION_ID = src.LOCATION_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND (\n        COALESCE(tgt.LOCATION_NAME, '') <> COALESCE(src.LOCATION_NAME, '')\n     OR tgt.DISTRICT_KY <> src.DISTRICT_KY\n  );, parameters: None","task_id":"gold_load_dim_phase3","try_number":1,"run_id":"backfill__2026-11-14T00:00:00+00:00","dag_id":"my_etl_dag","map_index":1,"ti_id":"01a1f7ce-380a-7323-b3ce-2018f24a55cc","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
