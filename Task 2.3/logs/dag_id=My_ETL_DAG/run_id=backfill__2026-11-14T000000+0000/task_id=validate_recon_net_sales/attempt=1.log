{"timestamp":"2026-11-20T09:52:39.533466Z","level":"info","event":"Running statement: -- --------------------------------------------------------------------------\n-- 2) Fail the DAG if this batch's net-sales recon is not PASSED.\n--    Division by zero raises an error only when a FAILED row exists.\n-- --------------------------------------------------------------------------\n\nSELECT 1 / 0\nFROM MODULE2_ETL.CONTROL.C_BATCH_RECON\nWHERE BATCH_ID = %(batch_id)s\n  AND SRC_FILE_NM = 'RECON:NET_SLS_FCT_VS_POS'\n  AND TARGET_TABLE = 'FCT_SALES / TMP_POS_SALES'\n  AND STATUS = 'FAILED';, parameters: {'batch_id': '2026-11-14'}","map_index":-1,"dag_id":"my_etl_dag","ti_id":"01a1f85d-8951-7dd6-9cc9-5d07ce13a975","try_number":1,"run_id":"backfill__2026-11-14T00:00:00+00:00","task_id":"validate_recon_net_sales","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
