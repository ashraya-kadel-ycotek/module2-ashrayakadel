{"timestamp":"2026-11-20T09:51:24.914200Z","level":"info","event":"Running statement: MERGE INTO silver.TMP_ITEM_MASTER t\nUSING (\n    SELECT\n        s.ITEM_ID, s.ITEM_NAME, s.COLOR, s.SIZE,\n        s.CLASS_ID, s.CLASS_NAME, s.CLASS_DESCRIPTION,\n        s.DEPARTMENT_ID, s.DEPARTMENT_NAME, s.DEPARTMENT_MANAGER_NAME,\n        s.COMPANY_ID, s.COMPANY_NAME, s.COMPANY_TYPE,\n        s.SRC_FILE_NM,\n        MD5(\n            COALESCE(s.ITEM_ID,'')||'|'||COALESCE(s.ITEM_NAME,'')||'|'||\n            COALESCE(s.COLOR,'')||'|'||COALESCE(s.SIZE,'')||'|'||\n            COALESCE(s.CLASS_ID,'')||'|'||COALESCE(s.CLASS_NAME,'')||'|'||\n            COALESCE(s.CLASS_DESCRIPTION,'')||'|'||COALESCE(s.DEPARTMENT_ID,'')||'|'||\n            COALESCE(s.DEPARTMENT_NAME,'')||'|'||COALESCE(s.DEPARTMENT_MANAGER_NAME,'')||'|'||\n            COALESCE(s.COMPANY_ID,'')||'|'||COALESCE(s.COMPANY_NAME,'')||'|'||\n            COALESCE(s.COMPANY_TYPE,'')\n        ) AS ROW_HASH\n    FROM bronze.STG_ITEM_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-14'\n      AND s.ITEM_ID IS NOT NULL AND s.ITEM_NAME IS NOT NULL\n      AND s.COLOR IS NOT NULL AND s.SIZE IS NOT NULL\n      AND s.CLASS_ID IS NOT NULL AND s.CLASS_NAME IS NOT NULL\n      AND s.CLASS_DESCRIPTION IS NOT NULL AND s.DEPARTMENT_ID IS NOT NULL\n      AND s.DEPARTMENT_NAME IS NOT NULL AND s.DEPARTMENT_MANAGER_NAME IS NOT NULL\n      AND s.COMPANY_ID IS NOT NULL AND s.COMPANY_NAME IS NOT NULL\n      AND s.COMPANY_TYPE IS NOT NULL\n      AND (s.ITEM_ID, s.CLASS_ID, s.DEPARTMENT_ID) NOT IN (\n          SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n          FROM bronze.STG_ITEM_MASTER\n          WHERE BATCH_ID = DATE '2026-11-14'\n          GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n      )\n) s\nON  t.ITEM_ID = s.ITEM_ID\nAND t.CLASS_ID = s.CLASS_ID\nAND t.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    ITEM_NAME = s.ITEM_NAME, COLOR = s.COLOR, SIZE = s.SIZE,\n    CLASS_NAME = s.CLASS_NAME, CLASS_DESCRIPTION = s.CLASS_DESCRIPTION,\n    DEPARTMENT_NAME = s.DEPARTMENT_NAME,\n    DEPARTMENT_MANAGER_NAME = s.DEPARTMENT_MANAGER_NAME,\n    COMPANY_ID = s.COMPANY_ID, COMPANY_NAME = s.COMPANY_NAME,\n    COMPANY_TYPE = s.COMPANY_TYPE,\n    _SRC_FILE_NM = s.SRC_FILE_NM, _BATCH_ID = DATE '2026-11-14',\n    _LOAD_TS = CURRENT_TIMESTAMP(), _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (ITEM_ID, ITEM_NAME, COLOR, SIZE, CLASS_ID, CLASS_NAME, CLASS_DESCRIPTION,\n     DEPARTMENT_ID, DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME,\n     COMPANY_ID, COMPANY_NAME, COMPANY_TYPE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.ITEM_ID, s.ITEM_NAME, s.COLOR, s.SIZE, s.CLASS_ID, s.CLASS_NAME, s.CLASS_DESCRIPTION,\n     s.DEPARTMENT_ID, s.DEPARTMENT_NAME, s.DEPARTMENT_MANAGER_NAME,\n     s.COMPANY_ID, s.COMPANY_NAME, s.COMPANY_TYPE,\n     s.SRC_FILE_NM, DATE '2026-11-14', CURRENT_TIMESTAMP(), s.ROW_HASH);, parameters: None","dag_id":"my_etl_dag","try_number":1,"run_id":"backfill__2026-11-14T00:00:00+00:00","task_id":"silver_load_phase1","map_index":1,"ti_id":"01a1f85d-893e-77a9-b7bc-e1c748413fed","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
