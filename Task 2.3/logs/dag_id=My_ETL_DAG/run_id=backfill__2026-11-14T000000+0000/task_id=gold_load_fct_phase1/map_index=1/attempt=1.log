{"timestamp":"2026-11-20T09:52:23.966008Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. Write join-miss rows to the reject table.\n-- ----------------------------------------------------------------------------\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT\n    s.SRC_FILE_NM,\n    DATE '2026-11-14',\n    'FCT_PRICE',\n    'REFERENTIAL_INTEGRITY_FAILURE',\n    'DAY_KY / ITEM_KY / LOCATION_KY could not be resolved as-of PRICE_DT',\n    OBJECT_CONSTRUCT(\n        'PRICE_DT',       s.PRICE_DT,\n        'ITEM_ID',        s.ITEM_ID,\n        'LOCATION_ID',    s.LOCATION_ID,\n        'UNIT_PRICE_AMT', s.UNIT_PRICE_AMT,\n        'EFF_FROM_DATE',  s.SRC_EFF_FROM_DATE,\n        'EFF_TO_DATE',    s.SRC_EFF_TO_DATE,\n        'DAY_KY',         s.DAY_KY,\n        'ITEM_KY',        s.ITEM_KY,\n        'LOCATION_KY',    s.LOCATION_KY,\n        'SRC_FILE_NM',    s.SRC_FILE_NM,\n        'SRC_ROW_HASH',   s.SRC_ROW_HASH\n    )\nFROM TMP_FCT_PRICE_STG s\nWHERE s.RI_FAIL_FLG = TRUE;, parameters: None","map_index":1,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85d-894d-7926-8232-d92880af0276","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T09:52:24.187638Z","level":"info","event":"Rows affected: 0","map_index":1,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85d-894d-7926-8232-d92880af0276","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T09:52:24.188067Z","level":"info","event":"Snowflake query id: 01c888f0-0003-1f56-000f-4ff6001403de","map_index":1,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85d-894d-7926-8232-d92880af0276","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T09:52:24.188242Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3. MERGE valid rows into FCT_PRICE — idempotent on the grain.\n-- ----------------------------------------------------------------------------\nMERGE INTO gold.FCT_PRICE t\nUSING (\n    SELECT\n        DAY_KY, ITEM_KY, LOCATION_KY,\n        UNIT_PRICE_AMT,\n        SRC_EFF_FROM_DATE, SRC_EFF_TO_DATE\n    FROM TMP_FCT_PRICE_STG\n    WHERE RI_FAIL_FLG = FALSE\n) s\nON  t.DAY_KY      = s.DAY_KY\nAND t.ITEM_KY     = s.ITEM_KY\nAND t.LOCATION_KY = s.LOCATION_KY\n\nWHEN MATCHED AND (\n        COALESCE(t.UNIT_PRICE_AMT, -1) <> COALESCE(s.UNIT_PRICE_AMT, -1)\n     OR COALESCE(t.EFF_FROM_DATE, DATE '1900-01-01') <> COALESCE(s.SRC_EFF_FROM_DATE, DATE '1900-01-01')\n     OR COALESCE(t.EFF_TO_DATE,   DATE '9999-12-31') <> COALESCE(s.SRC_EFF_TO_DATE,   DATE '9999-12-31')\n) THEN UPDATE SET\n    UNIT_PRICE_AMT = s.UNIT_PRICE_AMT,\n    EFF_FROM_DATE  = s.SRC_EFF_FROM_DATE,\n    EFF_TO_DATE    = s.SRC_EFF_TO_DATE,\n    REC_UPDT_TS    = CURRENT_TIMESTAMP(),\n    BATCH_ID       = DATE '2026-11-14',\n    SRC_SYS_CD     = 'TMP_PRICE_MASTER'\n\nWHEN NOT MATCHED THEN INSERT (\n    DAY_KY, ITEM_KY, LOCATION_KY,\n    UNIT_PRICE_AMT,\n    EFF_FROM_DATE, EFF_TO_DATE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID\n)\nVALUES (\n    s.DAY_KY, s.ITEM_KY, s.LOCATION_KY,\n    s.UNIT_PRICE_AMT,\n    s.SRC_EFF_FROM_DATE, s.SRC_EFF_TO_DATE,\n    CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'TMP_PRICE_MASTER', DATE '2026-11-14'\n);, parameters: None","map_index":1,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85d-894d-7926-8232-d92880af0276","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
