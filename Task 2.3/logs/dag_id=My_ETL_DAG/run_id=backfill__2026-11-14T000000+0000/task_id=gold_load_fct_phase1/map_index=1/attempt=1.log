{"timestamp":"2026-11-20T09:52:24.886385Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. Cleanup\n-- ----------------------------------------------------------------------------\nDROP TABLE IF EXISTS TMP_FCT_PRICE_STG;, parameters: None","map_index":1,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85d-894d-7926-8232-d92880af0276","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
