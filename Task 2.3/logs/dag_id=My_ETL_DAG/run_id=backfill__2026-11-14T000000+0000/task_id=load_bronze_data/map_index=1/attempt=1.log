{"timestamp":"2026-11-20T07:14:26.533943Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA bronze;\n\nCREATE OR REPLACE TEMPORARY STAGE BRONZE.TMP_DAILY_STAGE\n    FILE_FORMAT = (\n        TYPE = CSV\n        FIELD_DELIMITER = ','\n        SKIP_HEADER = 1\n        FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n        EMPTY_FIELD_AS_NULL = TRUE\n        NULL_IF = ('', 'NULL')\n        TRIM_SPACE = TRUE\n    );\n\nPUT file:///opt/airflow/data/item_master_20261114.csv\n    @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\n\nBEGIN;\n\nDELETE FROM BRONZE.STG_ITEM_MASTER\nWHERE BATCH_ID = '2026-11-14'::DATE;\n\nCOPY INTO BRONZE.STG_ITEM_MASTER (\n    ITEM_ID, ITEM_NAME, COLOR, SIZE, CLASS_ID, CLASS_NAME, CLASS_DESCRIPTION,\n    DEPARTMENT_ID, DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME,\n    COMPANY_ID, COMPANY_NAME, COMPANY_TYPE,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5, t.$6, t.$7,\n        t.$8, t.$9, t.$10, t.$11, t.$12, t.$13,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-14'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/item_master_20261114.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f7ce-37f6-7e4d-ba76-70c7d3cca1a2","task_id":"load_bronze_data","run_id":"backfill__2026-11-14T00:00:00+00:00","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
