{"timestamp":"2026-11-20T09:48:29.194344Z","level":"info","event":"Running statement: -- 4.7 Recon\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_POS_SALES WHERE BATCH_ID = DATE '2026-11-14'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-14' AND TARGET_TABLE = 'TMP_POS_SALES'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_POS_SALES s\n        WHERE s.BATCH_ID = DATE '2026-11-14'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-14' AND r.TARGET_TABLE = 'TMP_POS_SALES'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-14',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_POS_SALES WHERE BATCH_ID = DATE '2026-11-14'),'pos_sales'),\n       'TMP_POS_SALES', b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;, parameters: None","map_index":1,"task_id":"silver_load_phase2","try_number":2,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85b-208c-7804-bc2f-9dd783f8c883","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
