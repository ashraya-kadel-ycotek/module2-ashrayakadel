{"timestamp":"2026-11-20T08:21:04.145814Z","level":"info","event":"Running statement: -- 5.2 NULL required fields\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-14', 'TMP_PRICE_MASTER',\n       'NULL_REQUIRED_FIELD',\n       'Required price master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-14'\n  AND (\n       s.PRICE_DT IS NULL\n    OR s.ITEM_ID IS NULL\n    OR s.LOCATION_ID IS NULL\n    OR s.UNIT_PRICE_AMT IS NULL\n    OR s.EFF_FROM_DATE IS NULL\n    OR s.EFF_TO_DATE IS NULL\n  );, parameters: None","map_index":2,"task_id":"silver_load_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f80a-9bfd-7310-9b87-41401598f094","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
