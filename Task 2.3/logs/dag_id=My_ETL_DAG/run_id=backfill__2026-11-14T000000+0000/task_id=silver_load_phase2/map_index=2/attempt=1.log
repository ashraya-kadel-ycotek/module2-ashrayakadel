{"timestamp":"2026-11-20T06:22:20.887819Z","level":"info","event":"Running statement: -- 5.3 Negative price\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-14', 'TMP_PRICE_MASTER',\n       'NEGATIVE_AMOUNT',\n       'UNIT_PRICE_AMT is negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-14'\n  AND TRY_TO_NUMBER(s.UNIT_PRICE_AMT) < 0;, parameters: None","map_index":2,"run_id":"backfill__2026-11-14T00:00:00+00:00","dag_id":"my_etl_dag","task_id":"silver_load_phase2","try_number":1,"ti_id":"01a1f79d-e1b6-7c3d-900d-1e0c5e755623","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
