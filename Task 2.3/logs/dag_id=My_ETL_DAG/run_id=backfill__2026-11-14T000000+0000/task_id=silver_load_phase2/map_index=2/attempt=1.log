{"timestamp":"2026-11-20T09:51:30.749974Z","level":"info","event":"Running statement: -- ============================================================================\n-- 5. TMP_PRICE_MASTER\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID, EFF_FROM_DATE)\n-- ============================================================================\n\n-- 5.1 Type-cast failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-14', 'TMP_PRICE_MASTER',\n       'TYPE_CAST_FAILURE',\n       'PRICE_DT / UNIT_PRICE_AMT / EFF_FROM_DATE / EFF_TO_DATE failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-14'\n  AND (\n       TRY_TO_DATE(s.PRICE_DT, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_NUMBER(s.UNIT_PRICE_AMT) IS NULL\n    OR TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') IS NULL\n  );, parameters: None","map_index":2,"task_id":"silver_load_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85d-8941-724d-8c85-1b5068a6ddcd","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
