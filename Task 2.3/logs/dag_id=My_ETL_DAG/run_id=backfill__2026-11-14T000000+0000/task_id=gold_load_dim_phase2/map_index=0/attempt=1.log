{"timestamp":"2026-11-20T07:15:30.803946Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but MANAGER changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DEPARTMENT tgt\nSET\n    DEPARTMENT_MANAGER_NAME = src.DEPARTMENT_MANAGER_NAME,\n    REC_UPDT_TS             = CURRENT_TIMESTAMP(),\n    BATCH_ID                = DATE '2026-11-14'\nFROM TMP_DIM_DEPARTMENT_SRC src\nWHERE tgt.DEPARTMENT_ID = src.DEPARTMENT_ID\n  AND tgt.CURR_FLG      = TRUE\n  AND COALESCE(tgt.DEPARTMENT_NAME, '') = COALESCE(src.DEPARTMENT_NAME, '')\n  AND tgt.COMPANY_KY = src.COMPANY_KY\n  AND COALESCE(tgt.DEPARTMENT_MANAGER_NAME, '') <> COALESCE(src.DEPARTMENT_MANAGER_NAME, '');, parameters: None","map_index":0,"run_id":"backfill__2026-11-14T00:00:00+00:00","dag_id":"my_etl_dag","task_id":"gold_load_dim_phase2","ti_id":"01a1f7ce-3807-7bdc-a141-825109521313","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
