{"timestamp":"2026-11-20T07:15:23.229708Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose phone is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CUSTOMER tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-14'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-14'\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.CUSTOMER_PHONE, '') <> COALESCE(src.CUSTOMER_PHONE, '');, parameters: None","map_index":2,"run_id":"backfill__2026-11-14T00:00:00+00:00","dag_id":"my_etl_dag","task_id":"gold_load_dim_phase1","ti_id":"01a1f7ce-3806-70ee-b449-b03c31e58797","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:15:23.539693Z","level":"info","event":"Rows affected: 0","map_index":2,"run_id":"backfill__2026-11-14T00:00:00+00:00","dag_id":"my_etl_dag","task_id":"gold_load_dim_phase1","ti_id":"01a1f7ce-3806-70ee-b449-b03c31e58797","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
