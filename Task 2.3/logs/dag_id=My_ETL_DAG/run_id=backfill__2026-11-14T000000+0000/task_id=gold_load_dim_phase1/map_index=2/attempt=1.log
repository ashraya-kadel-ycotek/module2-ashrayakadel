{"timestamp":"2026-11-20T06:22:42.916299Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA gold;\n\n-- ============================================================================\n-- GOLD LOAD: DIM_CUSTOMER\n-- Source : silver.TMP_POS_SALES\n-- SCD    : CUSTOMER_NAME / CUSTOMER_EMAIL  -> SCD1 (overwrite in place)\n--          CUSTOMER_PHONE                  -> SCD2 (close old row, open new row)\n-- Dedup  : one row per CUSTOMER_ID from today's batch\n--          ORDER BY SALES_DT DESC, TRANSACTION_ID DESC\n-- KY     : CUSTOMER_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source — exactly one row per CUSTOMER_ID.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_CUSTOMER_SRC AS\nWITH ranked AS (\n    SELECT\n        s.CUSTOMER_ID,\n        s.CUSTOMER_NAME,\n        s.CUSTOMER_EMAIL,\n        s.CUSTOMER_PHONE,\n        s.SALES_DT,\n        s.TRANSACTION_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.CUSTOMER_ID\n            ORDER BY s.SALES_DT DESC,\n                     s.TRANSACTION_ID DESC\n        ) AS RN\n    FROM silver.TMP_POS_SALES s\n    WHERE s._BATCH_ID = DATE '2026-11-14'\n      AND s.CUSTOMER_ID IS NOT NULL\n)\nSELECT\n    CUSTOMER_ID,\n    CUSTOMER_NAME,\n    CUSTOMER_EMAIL,\n    CUSTOMER_PHONE\nFROM ranked\nWHERE RN = 1;\n\n-- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose phone is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CUSTOMER tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-14'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-14'\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.CUSTOMER_PHONE, '') <> COALESCE(src.CUSTOMER_PHONE, '');\n\n-- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for customers whose phone changed.\n--     (the old row was just closed in step 2)\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_CUSTOMER (\n    CUSTOMER_ID,\n    CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.CUSTOMER_ID,\n    src.CUSTOMER_NAME,\n    src.CUSTOMER_EMAIL,\n    src.CUSTOMER_PHONE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_POS_SALES',\n    DATE '2026-11-14',\n    DATE '2026-11-14',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_CUSTOMER tgt\n    WHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n      AND tgt.CURR_FLG    = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-14')\n      AND tgt.BATCH_ID    = DATE '2026-11-14'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_CUSTOMER tgt\n    WHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n      AND tgt.CURR_FLG    = TRUE\n);\n\n-- ----------------------------------------------------------------------------\n-- 3b. New customers — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_CUSTOMER (\n    CUSTOMER_ID,\n    CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.CUSTOMER_ID,\n    src.CUSTOMER_NAME,\n    src.CUSTOMER_EMAIL,\n    src.CUSTOMER_PHONE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_POS_SALES',\n    DATE '2026-11-14',\n    DATE '2026-11-14',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_CUSTOMER tgt\n    WHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n);\n\n-- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same phone, but NAME or EMAIL changed. Overwrite in place.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CUSTOMER tgt\nSET\n    CUSTOMER_NAME  = src.CUSTOMER_NAME,\n    CUSTOMER_EMAIL = src.CUSTOMER_EMAIL,\n    REC_UPDT_TS    = CURRENT_TIMESTAMP(),\n    BATCH_ID       = DATE '2026-11-14'\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.CUSTOMER_PHONE, '') = COALESCE(src.CUSTOMER_PHONE, '')\n  AND (\n        COALESCE(tgt.CUSTOMER_NAME,  '') <> COALESCE(src.CUSTOMER_NAME,  '')\n     OR COALESCE(tgt.CUSTOMER_EMAIL, '') <> COALESCE(src.CUSTOMER_EMAIL, '')\n  );\n\n-- ----------------------------------------------------------------------------\n-- 5. Cleanup\n-- ----------------------------------------------------------------------------\nDROP TABLE IF EXISTS TMP_DIM_CUSTOMER_SRC;","task_id":"gold_load_dim_phase1","ti_id":"01a1f79d-e1bb-73d7-b821-03a30d786e02","run_id":"backfill__2026-11-14T00:00:00+00:00","try_number":1,"map_index":2,"dag_id":"my_etl_dag","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
