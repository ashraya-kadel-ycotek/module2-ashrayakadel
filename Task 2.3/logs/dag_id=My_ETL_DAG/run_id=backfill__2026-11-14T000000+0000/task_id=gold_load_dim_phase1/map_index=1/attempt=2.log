{"timestamp":"2026-11-20T09:48:52.267693Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose STATE_CODE is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_STATE tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-14'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-14'\nFROM TMP_DIM_STATE_SRC src\nWHERE tgt.STATE_ID = src.STATE_ID\n  AND tgt.CURR_FLG = TRUE\n  AND COALESCE(tgt.STATE_CODE, '') <> COALESCE(src.STATE_CODE, '');, parameters: None","dag_id":"my_etl_dag","task_id":"gold_load_dim_phase1","try_number":2,"map_index":1,"run_id":"backfill__2026-11-14T00:00:00+00:00","ti_id":"01a1f85b-20c1-7f5e-b4f7-32f02ab86692","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
