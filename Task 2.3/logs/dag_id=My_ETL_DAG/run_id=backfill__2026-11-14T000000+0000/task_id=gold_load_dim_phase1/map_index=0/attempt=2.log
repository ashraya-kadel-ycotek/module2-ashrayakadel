{"timestamp":"2026-11-20T09:48:51.638256Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_COMPANY\n-- Source : silver.TMP_ITEM_MASTER\n-- SCD    : COMPANY_NAME -> SCD2 (close + open new row on change)\n--          COMPANY_TYPE -> SCD1 (overwrite in place)\n-- Dedup  : one row per COMPANY_ID from today's batch\n-- KY     : COMPANY_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source — exactly one row per COMPANY_ID.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_COMPANY_SRC AS\nWITH ranked AS (\n    SELECT\n        s.COMPANY_ID,\n        s.COMPANY_NAME,\n        s.COMPANY_TYPE,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.COMPANY_ID\n            ORDER BY s._LOAD_TS DESC, s.ITEM_ID DESC\n        ) AS RN\n    FROM silver.TMP_ITEM_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-14'\n      AND s.COMPANY_ID IS NOT NULL\n)\nSELECT COMPANY_ID, COMPANY_NAME, COMPANY_TYPE\nFROM ranked\nWHERE RN = 1;, parameters: None","map_index":0,"task_id":"gold_load_dim_phase1","try_number":2,"ti_id":"01a1f85b-20bf-76a0-8599-2a90aef8ec25","dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
