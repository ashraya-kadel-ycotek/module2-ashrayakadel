{"timestamp":"2026-11-20T09:48:52.858053Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New companies — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_COMPANY (\n    COMPANY_ID,\n    COMPANY_NAME, COMPANY_TYPE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.COMPANY_ID,\n    src.COMPANY_NAME,\n    src.COMPANY_TYPE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-14',\n    DATE '2026-11-14',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_COMPANY_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_COMPANY tgt\n    WHERE tgt.COMPANY_ID = src.COMPANY_ID\n);, parameters: None","map_index":0,"task_id":"gold_load_dim_phase1","try_number":2,"ti_id":"01a1f85b-20bf-76a0-8599-2a90aef8ec25","dag_id":"my_etl_dag","run_id":"backfill__2026-11-14T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
