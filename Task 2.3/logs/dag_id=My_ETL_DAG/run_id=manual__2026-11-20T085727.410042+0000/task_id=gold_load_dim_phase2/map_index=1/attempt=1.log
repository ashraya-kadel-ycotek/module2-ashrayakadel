{"timestamp":"2026-11-20T08:58:57.639381Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same DISTRICT_CODE (and same parent), but NAME changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DISTRICT tgt\nSET\n    DISTRICT_NAME = src.DISTRICT_NAME,\n    REC_UPDT_TS   = CURRENT_TIMESTAMP(),\n    BATCH_ID      = DATE '2026-11-14'\nFROM TMP_DIM_DISTRICT_SRC src\nWHERE tgt.DISTRICT_ID = src.DISTRICT_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.DISTRICT_CODE, '') = COALESCE(src.DISTRICT_CODE, '')\n  AND tgt.STATE_KY = src.STATE_KY\n  AND COALESCE(tgt.DISTRICT_NAME, '') <> COALESCE(src.DISTRICT_NAME, '');, parameters: None","map_index":1,"task_id":"gold_load_dim_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"manual__2026-11-20T08:57:27.410042+00:00","ti_id":"01a1f82c-cac3-717d-93b8-44204392a028","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
