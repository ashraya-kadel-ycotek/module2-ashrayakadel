{"timestamp":"2026-11-20T09:12:46.060464Z","level":"info","event":"Executing: -- ======================================================================\n-- validate_recon.sql\n-- Test 1: Net sales reconciliation\n--   Source A : MODULE2_ETL.GOLD.FCT_SALES        SUM(SLS_AMT)  [ct_sales]\n--   Source B : MODULE2_ETL.SILVER.TMP_POS_SALES  SUM(SLS_AMT)  [pos_sales]\n-- Both filtered to :batch_id.\n-- Writes one row to MODULE2_ETL.CONTROL.C_BATCH_RECON.\n-- Fails the DAG (1/0) if the sums do NOT match.\n-- Idempotent on rerun: MERGE on (BATCH_ID, SRC_FILE_NM, TARGET_TABLE).\n-- Self-contained: adds the value-recon columns to C_BATCH_RECON if missing,\n-- so control_ddl.sql / silver_ddl.sql do NOT need to change.\n-- ======================================================================\n\nUSE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\n\n-- ----------------------------------------------------------------------\n-- 0) Idempotent schema extension for value recon.\n--    C_BATCH_RECON is created by silver_ddl.sql; these ALTERs are no-ops\n--    once the columns exist. Keeps control_ddl.sql untouched.\n--    One column per statement — Snowflake does not accept repeated\n--    \"ADD COLUMN IF NOT EXISTS\" within a single multi-column ALTER.\n-- ----------------------------------------------------------------------\nALTER TABLE MODULE2_ETL.CONTROL.C_BATCH_RECON ADD COLUMN IF NOT EXISTS CHECK_NAME     VARCHAR(200);\nALTER TABLE MODULE2_ETL.CONTROL.C_BATCH_RECON ADD COLUMN IF NOT EXISTS SOURCE_A_TABLE VARCHAR(200);\nALTER TABLE MODULE2_ETL.CONTROL.C_BATCH_RECON ADD COLUMN IF NOT EXISTS SOURCE_A_VAL   NUMBER(38,6);\nALTER TABLE MODULE2_ETL.CONTROL.C_BATCH_RECON ADD COLUMN IF NOT EXISTS SOURCE_B_TABLE VARCHAR(200);\nALTER TABLE MODULE2_ETL.CONTROL.C_BATCH_RECON ADD COLUMN IF NOT EXISTS SOURCE_B_VAL   NUMBER(38,6);\nALTER TABLE MODULE2_ETL.CONTROL.C_BATCH_RECON ADD COLUMN IF NOT EXISTS DIFF_VAL       NUMBER(38,6);\n\n-- ----------------------------------------------------------------------\n-- 1) Compute both sums and MERGE the result into C_BATCH_RECON\n-- ----------------------------------------------------------------------\nMERGE INTO MODULE2_ETL.CONTROL.C_BATCH_RECON t\nUSING (\n    WITH a AS (\n        SELECT COALESCE(SUM(SLS_AMT), 0) AS SLS_AMT\n        FROM MODULE2_ETL.GOLD.FCT_SALES\n        WHERE BATCH_ID = :batch_id\n    ),\n    b AS (\n        SELECT COALESCE(SUM(SLS_AMT), 0) AS SLS_AMT\n        FROM MODULE2_ETL.SILVER.TMP_POS_SALES\n        WHERE _BATCH_ID = :batch_id\n    )\n    SELECT\n        :batch_id                                         AS BATCH_ID,\n        'RECON:NET_SLS_FCT_VS_POS'                        AS SRC_FILE_NM,\n        'FCT_SALES / TMP_POS_SALES'                       AS TARGET_TABLE,\n        0                                                 AS BRONZE_CNT,\n        0                                                 AS TMP_CNT,\n        0                                                 AS REJ_CNT,\n        a.SLS_AMT - b.SLS_AMT                             AS VARIANCE,\n        IFF(a.SLS_AMT = b.SLS_AMT, 'PASSED', 'FAILED')    AS STATUS,\n        'NET_SLS_FCT_VS_POS'                              AS CHECK_NAME,\n        'GOLD.FCT_SALES'                                  AS SOURCE_A_TABLE,\n        a.SLS_AMT                                         AS SOURCE_A_VAL,\n        'SILVER.TMP_POS_SALES'                            AS SOURCE_B_TABLE,\n        b.SLS_AMT                                         AS SOURCE_B_VAL,\n        a.SLS_AMT - b.SLS_AMT                             AS DIFF_VAL\n    FROM a CROSS JOIN b\n) s\nON  t.BATCH_ID     = s.BATCH_ID\nAND t.SRC_FILE_NM  = s.SRC_FILE_NM\nAND t.TARGET_TABLE = s.TARGET_TABLE\nWHEN MATCHED THEN UPDATE SET\n    VARIANCE       = s.VARIANCE,\n    STATUS         = s.STATUS,\n    CHECK_NAME     = s.CHECK_NAME,\n    SOURCE_A_TABLE = s.SOURCE_A_TABLE,\n    SOURCE_A_VAL   = s.SOURCE_A_VAL,\n    SOURCE_B_TABLE = s.SOURCE_B_TABLE,\n    SOURCE_B_VAL   = s.SOURCE_B_VAL,\n    DIFF_VAL       = s.DIFF_VAL,\n    RECON_TS       = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN INSERT\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE,\n     BRONZE_CNT, TMP_CNT, REJ_CNT,\n     VARIANCE, STATUS,\n     CHECK_NAME, SOURCE_A_TABLE, SOURCE_A_VAL,\n     SOURCE_B_TABLE, SOURCE_B_VAL, DIFF_VAL)\nVALUES\n    (s.BATCH_ID, s.SRC_FILE_NM, s.TARGET_TABLE,\n     s.BRONZE_CNT, s.TMP_CNT, s.REJ_CNT,\n     s.VARIANCE, s.STATUS,\n     s.CHECK_NAME, s.SOURCE_A_TABLE, s.SOURCE_A_VAL,\n     s.SOURCE_B_TABLE, s.SOURCE_B_VAL, s.DIFF_VAL);\n\n-- ----------------------------------------------------------------------\n-- 2) Fail the DAG if this batch's net-sales recon is not PASSED.\n--    SELECT 1/0 raises \"Division by zero\" only when a FAILED row exists,\n--    which propagates as a task failure in Airflow.\n-- ----------------------------------------------------------------------\nSELECT 1 / 0\nFROM MODULE2_ETL.CONTROL.C_BATCH_RECON\nWHERE BATCH_ID     = :batch_id\n  AND SRC_FILE_NM  = 'RECON:NET_SLS_FCT_VS_POS'\n  AND TARGET_TABLE = 'FCT_SALES / TMP_POS_SALES'\n  AND STATUS       = 'FAILED';","dag_id":"my_etl_dag","map_index":-1,"try_number":5,"ti_id":"01a1f83a-cb11-7470-a4cf-ab371d2e407a","task_id":"validate_recon_net_sales","run_id":"manual__2026-11-20T08:57:27.410042+00:00","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
