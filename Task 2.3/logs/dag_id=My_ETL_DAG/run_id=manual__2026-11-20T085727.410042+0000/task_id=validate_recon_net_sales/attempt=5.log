{"timestamp":"2026-11-20T09:12:50.440942Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------\n-- 1) Compute both sums and MERGE the result into C_BATCH_RECON\n-- ----------------------------------------------------------------------\nMERGE INTO MODULE2_ETL.CONTROL.C_BATCH_RECON t\nUSING (\n    WITH a AS (\n        SELECT COALESCE(SUM(SLS_AMT), 0) AS SLS_AMT\n        FROM MODULE2_ETL.GOLD.FCT_SALES\n        WHERE BATCH_ID = :batch_id\n    ),\n    b AS (\n        SELECT COALESCE(SUM(SLS_AMT), 0) AS SLS_AMT\n        FROM MODULE2_ETL.SILVER.TMP_POS_SALES\n        WHERE _BATCH_ID = :batch_id\n    )\n    SELECT\n        :batch_id                                         AS BATCH_ID,\n        'RECON:NET_SLS_FCT_VS_POS'                        AS SRC_FILE_NM,\n        'FCT_SALES / TMP_POS_SALES'                       AS TARGET_TABLE,\n        0                                                 AS BRONZE_CNT,\n        0                                                 AS TMP_CNT,\n        0                                                 AS REJ_CNT,\n        a.SLS_AMT - b.SLS_AMT                             AS VARIANCE,\n        IFF(a.SLS_AMT = b.SLS_AMT, 'PASSED', 'FAILED')    AS STATUS,\n        'NET_SLS_FCT_VS_POS'                              AS CHECK_NAME,\n        'GOLD.FCT_SALES'                                  AS SOURCE_A_TABLE,\n        a.SLS_AMT                                         AS SOURCE_A_VAL,\n        'SILVER.TMP_POS_SALES'                            AS SOURCE_B_TABLE,\n        b.SLS_AMT                                         AS SOURCE_B_VAL,\n        a.SLS_AMT - b.SLS_AMT                             AS DIFF_VAL\n    FROM a CROSS JOIN b\n) s\nON  t.BATCH_ID     = s.BATCH_ID\nAND t.SRC_FILE_NM  = s.SRC_FILE_NM\nAND t.TARGET_TABLE = s.TARGET_TABLE\nWHEN MATCHED THEN UPDATE SET\n    VARIANCE       = s.VARIANCE,\n    STATUS         = s.STATUS,\n    CHECK_NAME     = s.CHECK_NAME,\n    SOURCE_A_TABLE = s.SOURCE_A_TABLE,\n    SOURCE_A_VAL   = s.SOURCE_A_VAL,\n    SOURCE_B_TABLE = s.SOURCE_B_TABLE,\n    SOURCE_B_VAL   = s.SOURCE_B_VAL,\n    DIFF_VAL       = s.DIFF_VAL,\n    RECON_TS       = CURRENT_TIMESTAMP()\nWHEN NOT MATCHED THEN INSERT\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE,\n     BRONZE_CNT, TMP_CNT, REJ_CNT,\n     VARIANCE, STATUS,\n     CHECK_NAME, SOURCE_A_TABLE, SOURCE_A_VAL,\n     SOURCE_B_TABLE, SOURCE_B_VAL, DIFF_VAL)\nVALUES\n    (s.BATCH_ID, s.SRC_FILE_NM, s.TARGET_TABLE,\n     s.BRONZE_CNT, s.TMP_CNT, s.REJ_CNT,\n     s.VARIANCE, s.STATUS,\n     s.CHECK_NAME, s.SOURCE_A_TABLE, s.SOURCE_A_VAL,\n     s.SOURCE_B_TABLE, s.SOURCE_B_VAL, s.DIFF_VAL);, parameters: None","dag_id":"my_etl_dag","map_index":-1,"try_number":5,"ti_id":"01a1f83a-cb11-7470-a4cf-ab371d2e407a","task_id":"validate_recon_net_sales","run_id":"manual__2026-11-20T08:57:27.410042+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
