{"timestamp":"2026-11-20T09:22:05.548484Z","level":"info","event":"Running statement: -- --------------------------------------------------------------------------\n-- 1) Compute both sums and MERGE the result into C_BATCH_RECON\n-- --------------------------------------------------------------------------\n\nMERGE INTO MODULE2_ETL.CONTROL.C_BATCH_RECON t\nUSING (\n    WITH a AS (\n        SELECT COALESCE(SUM(SLS_AMT), 0) AS SLS_AMT\n        FROM MODULE2_ETL.GOLD.FCT_SALES\n        WHERE BATCH_ID = %(batch_id)s\n    ),\n    b AS (\n        SELECT COALESCE(SUM(SLS_AMT), 0) AS SLS_AMT\n        FROM MODULE2_ETL.SILVER.TMP_POS_SALES\n        WHERE _BATCH_ID = %(batch_id)s\n    )\n    SELECT\n        %(batch_id)s AS BATCH_ID,\n        'RECON:NET_SLS_FCT_VS_POS' AS SRC_FILE_NM,\n        'FCT_SALES / TMP_POS_SALES' AS TARGET_TABLE,\n        0 AS BRONZE_CNT,\n        0 AS TMP_CNT,\n        0 AS REJ_CNT,\n        a.SLS_AMT - b.SLS_AMT AS VARIANCE,\n        IFF(a.SLS_AMT = b.SLS_AMT, 'PASSED', 'FAILED') AS STATUS,\n        'NET_SLS_FCT_VS_POS' AS CHECK_NAME,\n        'GOLD.FCT_SALES' AS SOURCE_A_TABLE,\n        a.SLS_AMT AS SOURCE_A_VAL,\n        'SILVER.TMP_POS_SALES' AS SOURCE_B_TABLE,\n        b.SLS_AMT AS SOURCE_B_VAL,\n        a.SLS_AMT - b.SLS_AMT AS DIFF_VAL\n    FROM a\n    CROSS JOIN b\n) s\nON  t.BATCH_ID = s.BATCH_ID\nAND t.SRC_FILE_NM = s.SRC_FILE_NM\nAND t.TARGET_TABLE = s.TARGET_TABLE\n\nWHEN MATCHED THEN UPDATE SET\n    VARIANCE = s.VARIANCE,\n    STATUS = s.STATUS,\n    CHECK_NAME = s.CHECK_NAME,\n    SOURCE_A_TABLE = s.SOURCE_A_TABLE,\n    SOURCE_A_VAL = s.SOURCE_A_VAL,\n    SOURCE_B_TABLE = s.SOURCE_B_TABLE,\n    SOURCE_B_VAL = s.SOURCE_B_VAL,\n    DIFF_VAL = s.DIFF_VAL,\n    RECON_TS = CURRENT_TIMESTAMP()\n\nWHEN NOT MATCHED THEN INSERT\n    (\n        BATCH_ID,\n        SRC_FILE_NM,\n        TARGET_TABLE,\n        BRONZE_CNT,\n        TMP_CNT,\n        REJ_CNT,\n        VARIANCE,\n        STATUS,\n        CHECK_NAME,\n        SOURCE_A_TABLE,\n        SOURCE_A_VAL,\n        SOURCE_B_TABLE,\n        SOURCE_B_VAL,\n        DIFF_VAL\n    )\nVALUES\n    (\n        s.BATCH_ID,\n        s.SRC_FILE_NM,\n        s.TARGET_TABLE,\n        s.BRONZE_CNT,\n        s.TMP_CNT,\n        s.REJ_CNT,\n        s.VARIANCE,\n        s.STATUS,\n        s.CHECK_NAME,\n        s.SOURCE_A_TABLE,\n        s.SOURCE_A_VAL,\n        s.SOURCE_B_TABLE,\n        s.SOURCE_B_VAL,\n        s.DIFF_VAL\n    );, parameters: {'batch_id': '2026-11-14'}","map_index":-1,"task_id":"validate_recon_net_sales","try_number":8,"dag_id":"my_etl_dag","run_id":"manual__2026-11-20T08:57:27.410042+00:00","ti_id":"01a1f843-445a-7942-b9f7-6ed3408be669","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T09:22:07.138108Z","level":"info","event":"Rows affected: 1","map_index":-1,"task_id":"validate_recon_net_sales","try_number":8,"dag_id":"my_etl_dag","run_id":"manual__2026-11-20T08:57:27.410042+00:00","ti_id":"01a1f843-445a-7942-b9f7-6ed3408be669","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T09:22:07.138441Z","level":"info","event":"Snowflake query id: 01c888d2-0003-1ebf-000f-4ff60013b8a6","map_index":-1,"task_id":"validate_recon_net_sales","try_number":8,"dag_id":"my_etl_dag","run_id":"manual__2026-11-20T08:57:27.410042+00:00","ti_id":"01a1f843-445a-7942-b9f7-6ed3408be669","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T09:22:07.138535Z","level":"info","event":"Running statement: -- --------------------------------------------------------------------------\n-- 2) Fail the DAG if this batch's net-sales recon is not PASSED.\n--    Division by zero raises an error only when a FAILED row exists.\n-- --------------------------------------------------------------------------\n\nSELECT 1 / 0\nFROM MODULE2_ETL.CONTROL.C_BATCH_RECON\nWHERE BATCH_ID = %(batch_id)s\n  AND SRC_FILE_NM = 'RECON:NET_SLS_FCT_VS_POS'\n  AND TARGET_TABLE = 'FCT_SALES / TMP_POS_SALES'\n  AND STATUS = 'FAILED';, parameters: {'batch_id': '2026-11-14'}","map_index":-1,"task_id":"validate_recon_net_sales","try_number":8,"dag_id":"my_etl_dag","run_id":"manual__2026-11-20T08:57:27.410042+00:00","ti_id":"01a1f843-445a-7942-b9f7-6ed3408be669","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
