{"timestamp":"2026-11-20T08:24:45.899685Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-16', 'TMP_ITEM_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required item_master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_ITEM_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-16'\n  AND ( s.ITEM_ID IS NULL OR s.ITEM_NAME IS NULL OR s.COLOR IS NULL\n     OR s.SIZE IS NULL OR s.CLASS_ID IS NULL OR s.CLASS_NAME IS NULL\n     OR s.CLASS_DESCRIPTION IS NULL OR s.DEPARTMENT_ID IS NULL\n     OR s.DEPARTMENT_NAME IS NULL OR s.DEPARTMENT_MANAGER_NAME IS NULL\n     OR s.COMPANY_ID IS NULL OR s.COMPANY_NAME IS NULL\n     OR s.COMPANY_TYPE IS NULL );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-16', 'TMP_ITEM_MASTER',\n       'DUP_BUSINESS_KEY',\n       'Composite (ITEM_ID, CLASS_ID, DEPARTMENT_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_ITEM_MASTER s\nJOIN (\n    SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n    FROM bronze.STG_ITEM_MASTER\n    WHERE BATCH_ID = DATE '2026-11-16'\n    GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n) d ON  d.ITEM_ID = s.ITEM_ID\n    AND d.CLASS_ID = s.CLASS_ID\n    AND d.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHERE s.BATCH_ID = DATE '2026-11-16';\n\nMERGE INTO silver.TMP_ITEM_MASTER t\nUSING (\n    SELECT\n        s.ITEM_ID, s.ITEM_NAME, s.COLOR, s.SIZE,\n        s.CLASS_ID, s.CLASS_NAME, s.CLASS_DESCRIPTION,\n        s.DEPARTMENT_ID, s.DEPARTMENT_NAME, s.DEPARTMENT_MANAGER_NAME,\n        s.COMPANY_ID, s.COMPANY_NAME, s.COMPANY_TYPE,\n        s.SRC_FILE_NM,\n        MD5(\n            COALESCE(s.ITEM_ID,'')||'|'||COALESCE(s.ITEM_NAME,'')||'|'||\n            COALESCE(s.COLOR,'')||'|'||COALESCE(s.SIZE,'')||'|'||\n            COALESCE(s.CLASS_ID,'')||'|'||COALESCE(s.CLASS_NAME,'')||'|'||\n            COALESCE(s.CLASS_DESCRIPTION,'')||'|'||COALESCE(s.DEPARTMENT_ID,'')||'|'||\n            COALESCE(s.DEPARTMENT_NAME,'')||'|'||COALESCE(s.DEPARTMENT_MANAGER_NAME,'')||'|'||\n            COALESCE(s.COMPANY_ID,'')||'|'||COALESCE(s.COMPANY_NAME,'')||'|'||\n            COALESCE(s.COMPANY_TYPE,'')\n        ) AS ROW_HASH\n    FROM bronze.STG_ITEM_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-16'\n      AND s.ITEM_ID IS NOT NULL AND s.ITEM_NAME IS NOT NULL\n      AND s.COLOR IS NOT NULL AND s.SIZE IS NOT NULL\n      AND s.CLASS_ID IS NOT NULL AND s.CLASS_NAME IS NOT NULL\n      AND s.CLASS_DESCRIPTION IS NOT NULL AND s.DEPARTMENT_ID IS NOT NULL\n      AND s.DEPARTMENT_NAME IS NOT NULL AND s.DEPARTMENT_MANAGER_NAME IS NOT NULL\n      AND s.COMPANY_ID IS NOT NULL AND s.COMPANY_NAME IS NOT NULL\n      AND s.COMPANY_TYPE IS NOT NULL\n      AND (s.ITEM_ID, s.CLASS_ID, s.DEPARTMENT_ID) NOT IN (\n          SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n          FROM bronze.STG_ITEM_MASTER\n          WHERE BATCH_ID = DATE '2026-11-16'\n          GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n      )\n) s\nON  t.ITEM_ID = s.ITEM_ID\nAND t.CLASS_ID = s.CLASS_ID\nAND t.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    ITEM_NAME = s.ITEM_NAME, COLOR = s.COLOR, SIZE = s.SIZE,\n    CLASS_NAME = s.CLASS_NAME, CLASS_DESCRIPTION = s.CLASS_DESCRIPTION,\n    DEPARTMENT_NAME = s.DEPARTMENT_NAME,\n    DEPARTMENT_MANAGER_NAME = s.DEPARTMENT_MANAGER_NAME,\n    COMPANY_ID = s.COMPANY_ID, COMPANY_NAME = s.COMPANY_NAME,\n    COMPANY_TYPE = s.COMPANY_TYPE,\n    _SRC_FILE_NM = s.SRC_FILE_NM, _BATCH_ID = DATE '2026-11-16',\n    _LOAD_TS = CURRENT_TIMESTAMP(), _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (ITEM_ID, ITEM_NAME, COLOR, SIZE, CLASS_ID, CLASS_NAME, CLASS_DESCRIPTION,\n     DEPARTMENT_ID, DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME,\n     COMPANY_ID, COMPANY_NAME, COMPANY_TYPE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.ITEM_ID, s.ITEM_NAME, s.COLOR, s.SIZE, s.CLASS_ID, s.CLASS_NAME, s.CLASS_DESCRIPTION,\n     s.DEPARTMENT_ID, s.DEPARTMENT_NAME, s.DEPARTMENT_MANAGER_NAME,\n     s.COMPANY_ID, s.COMPANY_NAME, s.COMPANY_TYPE,\n     s.SRC_FILE_NM, DATE '2026-11-16', CURRENT_TIMESTAMP(), s.ROW_HASH);\n\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_ITEM_MASTER WHERE BATCH_ID = DATE '2026-11-16'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-16' AND TARGET_TABLE = 'TMP_ITEM_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_ITEM_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-16'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-16' AND r.TARGET_TABLE = 'TMP_ITEM_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-16',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_ITEM_MASTER WHERE BATCH_ID = DATE '2026-11-16'),'item_master'),\n       'TMP_ITEM_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f80a-9c86-7dea-8657-9f8d0e85c9dc","task_id":"silver_load_phase1","run_id":"backfill__2026-11-16T00:00:00+00:00","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
