CODE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE, s.DISTRICT_ID, s.DISTRICT_NAME,\n     s.DISTRICT_CODE, s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n     s.SRC_FILE_NM, DATE '2026-11-16', CURRENT_TIMESTAMP(), s.ROW_HASH);, parameters: None","dag_id":"my_etl_dag","task_id":"silver_load_phase1","try_number":1,"map_index":0,"run_id":"backfill__2026-11-16T00:00:00+00:00","ti_id":"01a1f79d-e23e-79fd-9775-49f8662867e1","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
