{"timestamp":"2026-11-20T07:19:10.971066Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose DEPARTMENT_NAME is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DEPARTMENT tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-16'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-16'\nFROM TMP_DIM_DEPARTMENT_SRC src\nWHERE tgt.DEPARTMENT_ID = src.DEPARTMENT_ID\n  AND tgt.CURR_FLG      = TRUE\n  AND (\n        COALESCE(tgt.DEPARTMENT_NAME, '') <> COALESCE(src.DEPARTMENT_NAME, '')\n     OR tgt.COMPANY_KY <> src.COMPANY_KY\n  );, parameters: None","task_id":"gold_load_dim_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-16T00:00:00+00:00","map_index":0,"ti_id":"01a1f7ce-3893-7cb8-9bd6-27de7f34d18a","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
