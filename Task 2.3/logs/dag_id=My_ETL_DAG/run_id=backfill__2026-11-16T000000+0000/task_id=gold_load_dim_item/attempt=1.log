{"timestamp":"2026-11-20T09:56:12.549817Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose ITEM_NAME / COLOR / SIZE\n--    (or parent CLASS_KY) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_ITEM tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-16'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-16'\nFROM TMP_DIM_ITEM_SRC src\nWHERE tgt.ITEM_ID = src.ITEM_ID\n  AND tgt.CURR_FLG = TRUE\n  AND (\n        COALESCE(tgt.ITEM_NAME, '') <> COALESCE(src.ITEM_NAME, '')\n     OR COALESCE(tgt.COLOR,     '') <> COALESCE(src.COLOR,     '')\n     OR COALESCE(tgt.SIZE,      '') <> COALESCE(src.SIZE,      '')\n     OR tgt.CLASS_KY <> src.CLASS_KY\n  );, parameters: None","map_index":-1,"dag_id":"my_etl_dag","ti_id":"01a1f85d-89db-7eb5-848c-7449c92d94a9","try_number":1,"run_id":"backfill__2026-11-16T00:00:00+00:00","task_id":"gold_load_dim_item","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
