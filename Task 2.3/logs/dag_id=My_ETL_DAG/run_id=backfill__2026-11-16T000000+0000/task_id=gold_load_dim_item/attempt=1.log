{"timestamp":"2026-11-20T07:19:19.466053Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA gold;\n\n-- ============================================================================\n-- GOLD LOAD: DIM_ITEM\n-- Source : silver.TMP_ITEM_MASTER\n-- Parent : DIM_CLASS (CLASS_KY via CLASS_ID, CURR_FLG = TRUE)\n-- SCD    : ITEM_NAME, COLOR, SIZE -> SCD2 (all attrs are SCD2 per ERD)\n-- Dedup  : one row per ITEM_ID from today's batch\n-- KY     : ITEM_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent CLASS_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_ITEM_SRC AS\nWITH ranked AS (\n    SELECT\n        s.ITEM_ID,\n        s.ITEM_NAME,\n        s.COLOR,\n        s.SIZE,\n        s.CLASS_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.ITEM_ID\n            ORDER BY s._LOAD_TS DESC, s.ITEM_ID DESC\n        ) AS RN\n    FROM silver.TMP_ITEM_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-16'\n      AND s.ITEM_ID IS NOT NULL\n)\nSELECT\n    r.ITEM_ID,\n    r.ITEM_NAME,\n    r.COLOR,\n    r.SIZE,\n    c.CLASS_KY\nFROM ranked r\nJOIN gold.DIM_CLASS c\n  ON c.CLASS_ID = r.CLASS_ID\n AND c.CURR_FLG = TRUE\nWHERE r.RN = 1;\n\n-- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose ITEM_NAME / COLOR / SIZE\n--    (or parent CLASS_KY) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_ITEM tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-16'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-16'\nFROM TMP_DIM_ITEM_SRC src\nWHERE tgt.ITEM_ID = src.ITEM_ID\n  AND tgt.CURR_FLG = TRUE\n  AND (\n        COALESCE(tgt.ITEM_NAME, '') <> COALESCE(src.ITEM_NAME, '')\n     OR COALESCE(tgt.COLOR,     '') <> COALESCE(src.COLOR,     '')\n     OR COALESCE(tgt.SIZE,      '') <> COALESCE(src.SIZE,      '')\n     OR tgt.CLASS_KY <> src.CLASS_KY\n  );\n\n-- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for items whose attributes\n--     (or parent class) changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_ITEM (\n    ITEM_ID,\n    ITEM_NAME, COLOR, SIZE, CLASS_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.ITEM_ID,\n    src.ITEM_NAME,\n    src.COLOR,\n    src.SIZE,\n    src.CLASS_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-16',\n    DATE '2026-11-16',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_ITEM_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_ITEM tgt\n    WHERE tgt.ITEM_ID = src.ITEM_ID\n      AND tgt.CURR_FLG = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-16')\n      AND tgt.BATCH_ID = DATE '2026-11-16'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_ITEM tgt\n    WHERE tgt.ITEM_ID = src.ITEM_ID\n      AND tgt.CURR_FLG = TRUE\n);\n\n-- ----------------------------------------------------------------------------\n-- 3b. New items — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_ITEM (\n    ITEM_ID,\n    ITEM_NAME, COLOR, SIZE, CLASS_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.ITEM_ID,\n    src.ITEM_NAME,\n    src.COLOR,\n    src.SIZE,\n    src.CLASS_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-16',\n    DATE '2026-11-16',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_ITEM_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_ITEM tgt\n    WHERE tgt.ITEM_ID = src.ITEM_ID\n);\n\n-- ----------------------------------------------------------------------------\n-- 4. Cleanup\n-- ----------------------------------------------------------------------------\nDROP TABLE IF EXISTS TMP_DIM_ITEM_SRC;","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f7ce-3897-7e4e-aebe-23daaee2287f","task_id":"gold_load_dim_item","run_id":"backfill__2026-11-16T00:00:00+00:00","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
