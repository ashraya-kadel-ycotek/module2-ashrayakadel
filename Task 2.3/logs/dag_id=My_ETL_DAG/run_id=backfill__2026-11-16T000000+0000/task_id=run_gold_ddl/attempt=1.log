{"timestamp":"2026-11-20T06:27:11.535164Z","level":"info","event":"Running statement: -- ======================================================================\n-- DATE SEED (insert-only, individually idempotent MERGE statements)\n-- BATCH_ID is DATE — seed writes CURRENT_DATE().\n-- Order matters: YEAR -> QUARTER -> MONTH -> WEEK -> DAY (each joins parent _KY).\n-- ======================================================================\n\n-- DIM_YEAR\nMERGE INTO MODULE2_ETL.GOLD.DIM_YEAR t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT YEAR(y) AS YEAR_ID,\n               YEAR(y) AS CALENDAR_YEAR,\n               ((YEAR(y) % 4 = 0 AND YEAR(y) % 100 <> 0) OR YEAR(y) % 400 = 0) AS LEAP_YEAR_FLG,\n               'FY' || TO_VARCHAR(YEAR(y)) AS FISCAL_YEAR_LABEL\n        FROM yr\n        ORDER BY y\n      ) s\n   ON t.YEAR_ID = s.YEAR_ID\nWHEN NOT MATCHED THEN INSERT (YEAR_ID, CALENDAR_YEAR, LEAP_YEAR_FLG, FISCAL_YEAR_LABEL, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.YEAR_ID, s.CALENDAR_YEAR, s.LEAP_YEAR_FLG, s.FISCAL_YEAR_LABEL, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);, parameters: None","task_id":"run_gold_ddl","run_id":"backfill__2026-11-16T00:00:00+00:00","ti_id":"01a1f79d-e244-7371-9cad-f009b03cc008","dag_id":"my_etl_dag","try_number":1,"map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
