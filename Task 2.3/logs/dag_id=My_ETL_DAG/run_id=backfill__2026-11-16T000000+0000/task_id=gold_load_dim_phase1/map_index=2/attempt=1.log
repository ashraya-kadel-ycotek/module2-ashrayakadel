{"timestamp":"2026-11-20T09:55:54.546693Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New customers — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_CUSTOMER (\n    CUSTOMER_ID,\n    CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.CUSTOMER_ID,\n    src.CUSTOMER_NAME,\n    src.CUSTOMER_EMAIL,\n    src.CUSTOMER_PHONE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_POS_SALES',\n    DATE '2026-11-16',\n    DATE '2026-11-16',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_CUSTOMER tgt\n    WHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n);, parameters: None","map_index":2,"dag_id":"my_etl_dag","ti_id":"01a1f85d-89d6-7005-89b4-bc149bc74973","try_number":1,"run_id":"backfill__2026-11-16T00:00:00+00:00","task_id":"gold_load_dim_phase1","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
