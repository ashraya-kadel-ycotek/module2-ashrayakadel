{"timestamp":"2026-11-20T07:19:03.777015Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose STATE_CODE is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_STATE tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-16'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-16'\nFROM TMP_DIM_STATE_SRC src\nWHERE tgt.STATE_ID = src.STATE_ID\n  AND tgt.CURR_FLG = TRUE\n  AND COALESCE(tgt.STATE_CODE, '') <> COALESCE(src.STATE_CODE, '');, parameters: None","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f7ce-3891-7970-9f27-45a2d81d528d","task_id":"gold_load_dim_phase1","run_id":"backfill__2026-11-16T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
