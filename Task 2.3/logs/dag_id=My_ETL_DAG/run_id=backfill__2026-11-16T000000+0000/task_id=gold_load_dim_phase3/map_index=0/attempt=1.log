{"timestamp":"2026-11-20T07:19:17.548161Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but DESCRIPTION changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CLASS tgt\nSET\n    CLASS_DESCRIPTION = src.CLASS_DESCRIPTION,\n    REC_UPDT_TS       = CURRENT_TIMESTAMP(),\n    BATCH_ID          = DATE '2026-11-16'\nFROM TMP_DIM_CLASS_SRC src\nWHERE tgt.CLASS_ID = src.CLASS_ID\n  AND tgt.CURR_FLG = TRUE\n  AND COALESCE(tgt.CLASS_NAME, '') = COALESCE(src.CLASS_NAME, '')\n  AND tgt.DEPARTMENT_KY = src.DEPARTMENT_KY\n  AND COALESCE(tgt.CLASS_DESCRIPTION, '') <> COALESCE(src.CLASS_DESCRIPTION, '');, parameters: None","task_id":"gold_load_dim_phase3","ti_id":"01a1f7ce-3895-73e1-8dda-ce39cdcf25a9","run_id":"backfill__2026-11-16T00:00:00+00:00","try_number":1,"map_index":0,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
