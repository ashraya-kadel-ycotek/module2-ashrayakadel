{"timestamp":"2026-11-20T08:25:44.804442Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3. Re-INSERT the aggregate for the affected weeks, from FCT_SALES.\n--    Grain: (WEEK_KY, ITEM_KY, LOCATION_KY)\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.FCT_SALES_PER_WEEK (\n    WEEK_KY, ITEM_KY, LOCATION_KY,\n    SLS_QTY, SLS_AMT,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID\n)\nSELECT\n    d.WEEK_KY,\n    f.ITEM_KY,\n    f.LOCATION_KY,\n    SUM(f.SLS_QTY)  AS SLS_QTY,\n    SUM(f.SLS_AMT)  AS SLS_AMT,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'DERIVED',\n    DATE '2026-11-16'\nFROM gold.FCT_SALES f\nJOIN gold.DIM_DAY d\n  ON d.DAY_KY = f.DAY_KY\nWHERE d.WEEK_KY IN (SELECT WEEK_KY FROM TMP_FCT_WEEK_KEYS)\nGROUP BY d.WEEK_KY, f.ITEM_KY, f.LOCATION_KY;, parameters: None","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f80a-9c97-7bc7-9776-11a8283992b9","task_id":"gold_load_fct_sales_per_week","run_id":"backfill__2026-11-16T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
