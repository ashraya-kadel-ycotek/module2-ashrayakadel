{"timestamp":"2026-11-20T06:26:51.921398Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-16', 'TMP_POS_SALES',\n       'NEGATIVE_AMOUNT', 'SLS_QTY or SLS_AMT negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-16'\n  AND TRY_TO_NUMBER(s.SLS_QTY) IS NOT NULL\n  AND TRY_TO_NUMBER(s.SLS_AMT) IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.SLS_QTY) < 0 OR TRY_TO_NUMBER(s.SLS_AMT) < 0 );, parameters: None","map_index":1,"task_id":"silver_load_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-16T00:00:00+00:00","ti_id":"01a1f79d-e241-7724-ab9f-623115da420c","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
