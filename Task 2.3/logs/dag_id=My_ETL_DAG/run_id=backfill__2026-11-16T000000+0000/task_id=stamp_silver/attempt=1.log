{"timestamp":"2026-11-20T09:55:37.302279Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA control;\n\n-- Silver targets\n-- Append one load event per target for this (batch, run).\n-- NOT EXISTS makes a task retry/clear safe (Snowflake does not enforce the UNIQUE).\n\nINSERT INTO control.C_LOAD_DATES (TARGET_TABLE, LAYER, BATCH_ID, RUN_ID)\nSELECT s.TARGET_TABLE, s.LAYER, DATE '2026-11-16', 'backfill__2026-11-16T00:00:00+00:00'\nFROM (VALUES\n    ('silver', 'TMP_STORE_MASTER'),\n    ('silver', 'TMP_ITEM_MASTER'),\n    ('silver', 'TMP_INVENTORY_MASTER'),\n    ('silver', 'TMP_POS_SALES'),\n    ('silver', 'TMP_PRICE_MASTER')\n) AS s(LAYER, TARGET_TABLE)\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM control.C_LOAD_DATES t\n    WHERE t.TARGET_TABLE = s.TARGET_TABLE\n      AND t.BATCH_ID     = DATE '2026-11-16'\n      AND t.RUN_ID       = 'backfill__2026-11-16T00:00:00+00:00'\n);","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f85d-89d2-79a2-8055-9414f9767022","task_id":"stamp_silver","run_id":"backfill__2026-11-16T00:00:00+00:00","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
