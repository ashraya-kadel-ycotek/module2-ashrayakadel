{"timestamp":"2026-11-19T09:17:49.997643Z","level":"info","event":"Running statement: -- ---------------------------- 0. Idempotency ----------------------------\nDELETE FROM control.C_REJ_TABLE\n WHERE BATCH_ID = DATE '2026-11-19'\n   AND TARGET_TABLE IN\n       ('TMP_STORE_MASTER','TMP_ITEM_MASTER','TMP_INVENTORY_MASTER',\n        'TMP_POS_SALES','TMP_PRICE_MASTER');, parameters: None","try_number":1,"dag_id":"my_etl_dag","task_id":"load_silver_data","run_id":"manual__2026-11-19T09:17:22.656972+00:00","map_index":-1,"ti_id":"01a1f318-ab7c-75ba-9565-3290a9041f3e","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
