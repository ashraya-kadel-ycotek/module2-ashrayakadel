{"timestamp":"2026-11-20T05:54:13.364970Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-20', 'TMP_STORE_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required store_master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-20'\n  AND ( s.LOCATION_ID IS NULL OR s.LOCATION_NAME IS NULL\n     OR s.ADDRESS_LINE IS NULL OR s.DISTRICT_ID IS NULL\n     OR s.DISTRICT_NAME IS NULL OR s.DISTRICT_CODE IS NULL\n     OR s.STATE_ID IS NULL OR s.STATE_NAME IS NULL\n     OR s.STATE_CODE IS NULL );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-20', 'TMP_STORE_MASTER',\n       'DUP_BUSINESS_KEY', 'LOCATION_ID duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nJOIN (\n    SELECT LOCATION_ID\n    FROM bronze.STG_STORE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-20' AND LOCATION_ID IS NOT NULL\n    GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n) d ON d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-20';\n\nMERGE INTO silver.TMP_STORE_MASTER t\nUSING (\n    SELECT\n        s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE,\n        s.DISTRICT_ID, s.DISTRICT_NAME, s.DISTRICT_CODE,\n        s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n        s.SRC_FILE_NM,\n        MD5(\n            COALESCE(s.LOCATION_ID  ,'')||'|'||COALESCE(s.LOCATION_NAME ,'')||'|'||\n            COALESCE(s.ADDRESS_LINE ,'')||'|'||COALESCE(s.DISTRICT_ID   ,'')||'|'||\n            COALESCE(s.DISTRICT_NAME,'')||'|'||COALESCE(s.DISTRICT_CODE ,'')||'|'||\n            COALESCE(s.STATE_ID     ,'')||'|'||COALESCE(s.STATE_NAME    ,'')||'|'||\n            COALESCE(s.STATE_CODE   ,'')\n        ) AS ROW_HASH\n    FROM bronze.STG_STORE_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-20'\n      AND s.LOCATION_ID IS NOT NULL AND s.LOCATION_NAME IS NOT NULL\n      AND s.ADDRESS_LINE IS NOT NULL AND s.DISTRICT_ID IS NOT NULL\n      AND s.DISTRICT_NAME IS NOT NULL AND s.DISTRICT_CODE IS NOT NULL\n      AND s.STATE_ID IS NOT NULL AND s.STATE_NAME IS NOT NULL\n      AND s.STATE_CODE IS NOT NULL\n      AND s.LOCATION_ID NOT IN (\n          SELECT LOCATION_ID FROM bronze.STG_STORE_MASTER\n          WHERE BATCH_ID = DATE '2026-11-20' AND LOCATION_ID IS NOT NULL\n          GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n      )\n) s\nON t.LOCATION_ID = s.LOCATION_ID\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    LOCATION_NAME = s.LOCATION_NAME, ADDRESS_LINE = s.ADDRESS_LINE,\n    DISTRICT_ID = s.DISTRICT_ID, DISTRICT_NAME = s.DISTRICT_NAME,\n    DISTRICT_CODE = s.DISTRICT_CODE, STATE_ID = s.STATE_ID,\n    STATE_NAME = s.STATE_NAME, STATE_CODE = s.STATE_CODE,\n    _SRC_FILE_NM = s.SRC_FILE_NM, _BATCH_ID = DATE '2026-11-20',\n    _LOAD_TS = CURRENT_TIMESTAMP(), _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (LOCATION_ID, LOCATION_NAME, ADDRESS_LINE, DISTRICT_ID, DISTRICT_NAME,\n     DISTRICT_CODE, STATE_ID, STATE_NAME, STATE_CODE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE, s.DISTRICT_ID, s.DISTRICT_NAME,\n     s.DISTRICT_CODE, s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n     s.SRC_FILE_NM, DATE '2026-11-20', CURRENT_TIMESTAMP(), s.ROW_HASH);\n\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_STORE_MASTER WHERE BATCH_ID = DATE '2026-11-20'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-20' AND TARGET_TABLE = 'TMP_STORE_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_STORE_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-20'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-20' AND r.TARGET_TABLE = 'TMP_STORE_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-20',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_STORE_MASTER WHERE BATCH_ID = DATE '2026-11-20'),'store_master'),\n       'TMP_STORE_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;","task_id":"silver_load_phase1","try_number":1,"run_id":"manual__2026-11-20T05:47:10.381231+00:00","dag_id":"my_etl_dag","map_index":0,"ti_id":"01a1f77e-94ea-7088-8999-bc9204a7271f","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
