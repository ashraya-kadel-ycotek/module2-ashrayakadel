CODE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE, s.DISTRICT_ID, s.DISTRICT_NAME,\n     s.DISTRICT_CODE, s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n     s.SRC_FILE_NM, DATE '2026-11-20', CURRENT_TIMESTAMP(), s.ROW_HASH);, parameters: None","task_id":"silver_load_phase1","try_number":1,"run_id":"manual__2026-11-20T05:47:10.381231+00:00","dag_id":"my_etl_dag","map_index":0,"ti_id":"01a1f77e-94ea-7088-8999-bc9204a7271f","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
