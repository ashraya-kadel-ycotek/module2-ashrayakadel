{"timestamp":"2026-11-20T06:10:13.780911Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for customers whose phone changed.\n--     (the old row was just closed in step 2)\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_CUSTOMER (\n    CUSTOMER_ID,\n    CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.CUSTOMER_ID,\n    src.CUSTOMER_NAME,\n    src.CUSTOMER_EMAIL,\n    src.CUSTOMER_PHONE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_POS_SALES',\n    DATE '2026-11-18',\n    DATE '2026-11-18',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_CUSTOMER tgt\n    WHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n      AND tgt.CURR_FLG    = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-18')\n      AND tgt.BATCH_ID    = DATE '2026-11-18'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_CUSTOMER tgt\n    WHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n      AND tgt.CURR_FLG    = TRUE\n);, parameters: None","map_index":2,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-18T18:15:00+00:00","task_id":"gold_load_dim_phase1","ti_id":"01a1f792-4b48-7c15-aa57-6395009d1ae3","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
