{"timestamp":"2026-11-20T06:10:12.665546Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_STATE\n-- Source : silver.TMP_STORE_MASTER\n-- SCD    : STATE_CODE -> SCD2 (close + open new row on change)\n--          STATE_NAME -> SCD1 (overwrite in place)\n-- Dedup  : one row per STATE_ID from today's batch\n-- KY     : STATE_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source — exactly one row per STATE_ID.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_STATE_SRC AS\nWITH ranked AS (\n    SELECT\n        s.STATE_ID,\n        s.STATE_NAME,\n        s.STATE_CODE,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.STATE_ID\n            ORDER BY s._LOAD_TS DESC, s.LOCATION_ID DESC\n        ) AS RN\n    FROM silver.TMP_STORE_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-18'\n      AND s.STATE_ID IS NOT NULL\n)\nSELECT STATE_ID, STATE_NAME, STATE_CODE\nFROM ranked\nWHERE RN = 1;, parameters: None","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f792-4b47-7b5b-82a0-a3c54daeb1f7","task_id":"gold_load_dim_phase1","run_id":"scheduled__2026-11-18T18:15:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
