{"timestamp":"2026-11-20T06:10:20.181877Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose DEPARTMENT_NAME is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DEPARTMENT tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-18'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-18'\nFROM TMP_DIM_DEPARTMENT_SRC src\nWHERE tgt.DEPARTMENT_ID = src.DEPARTMENT_ID\n  AND tgt.CURR_FLG      = TRUE\n  AND (\n        COALESCE(tgt.DEPARTMENT_NAME, '') <> COALESCE(src.DEPARTMENT_NAME, '')\n     OR tgt.COMPANY_KY <> src.COMPANY_KY\n  );, parameters: None","task_id":"gold_load_dim_phase2","try_number":1,"run_id":"scheduled__2026-11-18T18:15:00+00:00","map_index":0,"dag_id":"my_etl_dag","ti_id":"01a1f792-4b49-752e-9b26-24900e19ce50","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
