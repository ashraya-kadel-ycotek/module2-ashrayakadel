{"timestamp":"2026-11-20T06:10:20.596598Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose DISTRICT_CODE is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DISTRICT tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-18'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-18'\nFROM TMP_DIM_DISTRICT_SRC src\nWHERE tgt.DISTRICT_ID = src.DISTRICT_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND (\n        COALESCE(tgt.DISTRICT_CODE, '') <> COALESCE(src.DISTRICT_CODE, '')\n     OR tgt.STATE_KY <> src.STATE_KY\n  );, parameters: None","map_index":1,"run_id":"scheduled__2026-11-18T18:15:00+00:00","dag_id":"my_etl_dag","task_id":"gold_load_dim_phase2","ti_id":"01a1f792-4b4a-7c5f-b10d-6a28465a2693","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
