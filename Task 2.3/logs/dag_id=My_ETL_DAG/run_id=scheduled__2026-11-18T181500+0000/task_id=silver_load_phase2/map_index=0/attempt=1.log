{"timestamp":"2026-11-20T04:42:01.540306Z","level":"info","event":"Running statement: INSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-18'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-18' AND TARGET_TABLE = 'TMP_INVENTORY_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-18'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-18' AND r.TARGET_TABLE = 'TMP_INVENTORY_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-18',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-18'),'inventory_master'),\n       'TMP_INVENTORY_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;, parameters: None","task_id":"silver_load_phase2","ti_id":"01a1f742-61e6-7d59-b224-b5c9b0d5562b","run_id":"scheduled__2026-11-18T18:15:00+00:00","try_number":1,"map_index":0,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
