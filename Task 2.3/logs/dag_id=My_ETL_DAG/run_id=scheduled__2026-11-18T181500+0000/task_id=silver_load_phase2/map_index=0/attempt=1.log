{"timestamp":"2026-11-20T04:41:59.951081Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-18', 'TMP_INVENTORY_MASTER',\n       'DUP_BUSINESS_KEY',\n       '(INVENTORY_DT, ITEM_ID, LOCATION_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nJOIN (\n    SELECT TRY_TO_DATE(INVENTORY_DT,'YYYY-MM-DD') AS D, ITEM_ID, LOCATION_ID\n    FROM bronze.STG_INVENTORY_MASTER\n    WHERE BATCH_ID = DATE '2026-11-18'\n    GROUP BY 1,2,3 HAVING COUNT(*) > 1\n) d ON  d.D = TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD')\n    AND d.ITEM_ID = s.ITEM_ID\n    AND d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-18';, parameters: None","task_id":"silver_load_phase2","ti_id":"01a1f742-61e6-7d59-b224-b5c9b0d5562b","run_id":"scheduled__2026-11-18T18:15:00+00:00","try_number":1,"map_index":0,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
