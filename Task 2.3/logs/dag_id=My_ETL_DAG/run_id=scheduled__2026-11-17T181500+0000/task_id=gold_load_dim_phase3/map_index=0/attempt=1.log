{"timestamp":"2026-11-20T04:41:16.935796Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New classes — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_CLASS (\n    CLASS_ID,\n    CLASS_NAME, CLASS_DESCRIPTION, DEPARTMENT_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.CLASS_ID,\n    src.CLASS_NAME,\n    src.CLASS_DESCRIPTION,\n    src.DEPARTMENT_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-17',\n    DATE '2026-11-17',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_CLASS_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_CLASS tgt\n    WHERE tgt.CLASS_ID = src.CLASS_ID\n);, parameters: None","task_id":"gold_load_dim_phase3","run_id":"scheduled__2026-11-17T18:15:00+00:00","try_number":1,"map_index":0,"dag_id":"my_etl_dag","ti_id":"01a1f741-3d21-7ab9-895e-0e806cddb041","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
