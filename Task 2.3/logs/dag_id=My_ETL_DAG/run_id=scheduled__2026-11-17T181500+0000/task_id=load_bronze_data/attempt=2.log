{"timestamp":"2026-11-19T10:20:37.705335Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA bronze;\n\n-- ============================================================\n-- 1. CREATE A TEMPORARY STAGE FOR THE DAILY FILES\n-- ============================================================\nCREATE OR REPLACE TEMPORARY STAGE BRONZE.TMP_DAILY_STAGE\n    FILE_FORMAT = (\n        TYPE = CSV\n        FIELD_DELIMITER = ','\n        SKIP_HEADER = 1\n        FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n        EMPTY_FIELD_AS_NULL = TRUE\n        NULL_IF = ('', 'NULL')\n        TRIM_SPACE = TRUE\n    );\n\n\nPUT file:///opt/airflow/data/store_master_20261117.csv     @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/item_master_20261117.csv      @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/inventory_master_20261117.csv @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/pos_sales_20261117.csv        @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/price_master_20261117.csv     @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\n-- ============================================================\n-- 2. UPLOAD FILES (paths templated by Airflow; no creds here)\n-- ============================================================\n-- ============================================================\n-- 3. COPY INTO STAGING TABLES WITH AUDIT COLUMNS\n--    - All business columns are VARCHAR (no casting, no drops)\n--    - Idempotent: DELETE existing batch, then COPY (AC1)\n--    - ON_ERROR = 'CONTINUE' so bad rows pass through to Silver\n--      for quarantining (AC3)\n--    - Wrapped in BEGIN/COMMIT per table\n-- ============================================================\n\n-- ------------------------------------------------------------\n-- STG_STORE_MASTER\n-- ------------------------------------------------------------\nBEGIN;\n\nDELETE FROM BRONZE.STG_STORE_MASTER\nWHERE BATCH_ID = '2026-11-17'::DATE;\n\nCOPY INTO BRONZE.STG_STORE_MASTER (\n    LOCATION_ID, LOCATION_NAME, ADDRESS_LINE, DISTRICT_ID, DISTRICT_NAME,\n    DISTRICT_CODE, STATE_ID, STATE_NAME, STATE_CODE,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5,\n        t.$6, t.$7, t.$8, t.$9,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/store_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;\n\n-- ------------------------------------------------------------\n-- STG_ITEM_MASTER\n-- ------------------------------------------------------------\nBEGIN;\n\nDELETE FROM BRONZE.STG_ITEM_MASTER\nWHERE BATCH_ID = '2026-11-17'::DATE;\n\nCOPY INTO BRONZE.STG_ITEM_MASTER (\n    ITEM_ID, ITEM_NAME, COLOR, SIZE, CLASS_ID, CLASS_NAME, CLASS_DESCRIPTION,\n    DEPARTMENT_ID, DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME, COMPANY_ID, COMPANY_NAME, COMPANY_TYPE,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5, t.$6, t.$7,\n        t.$8, t.$9, t.$10, t.$11, t.$12, t.$13,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/item_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;\n\n-- ------------------------------------------------------------\n-- STG_INVENTORY_MASTER\n-- ------------------------------------------------------------\nBEGIN;\n\nDELETE FROM BRONZE.STG_INVENTORY_MASTER\nWHERE BATCH_ID = '2026-11-17'::DATE;\n\nCOPY INTO BRONZE.STG_INVENTORY_MASTER (\n    INVENTORY_DT, ITEM_ID, LOCATION_ID, STOCK_ON_HAND, IN_TRANSIT,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/inventory_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;\n\n-- ------------------------------------------------------------\n-- STG_POS_SALES\n-- ------------------------------------------------------------\nBEGIN;\n\nDELETE FROM BRONZE.STG_POS_SALES\nWHERE BATCH_ID = '2026-11-17'::DATE;\n\nCOPY INTO BRONZE.STG_POS_SALES (\n    TRANSACTION_ID, TRANSACTION_LINE_NUMBER, SALES_DT, ITEM_ID, LOCATION_ID,\n    CUSTOMER_ID, CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE, SLS_QTY, SLS_AMT,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5,\n        t.$6, t.$7, t.$8, t.$9, t.$10, t.$11,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/pos_sales_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;\n\n-- ------------------------------------------------------------\n-- STG_PRICE_MASTER\n-- ------------------------------------------------------------\nBEGIN;\n\nDELETE FROM BRONZE.STG_PRICE_MASTER\nWHERE BATCH_ID = '2026-11-17'::DATE;\n\nCOPY INTO BRONZE.STG_PRICE_MASTER (\n    PRICE_DT, ITEM_ID, LOCATION_ID, UNIT_PRICE_AMT, EFF_FROM_DATE, EFF_TO_DATE,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5, t.$6,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/price_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;","try_number":2,"run_id":"scheduled__2026-11-17T18:15:00+00:00","ti_id":"01a1f34f-a199-70d2-a10a-3f8f1ced0c78","dag_id":"my_etl_dag","map_index":-1,"task_id":"load_bronze_data","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
