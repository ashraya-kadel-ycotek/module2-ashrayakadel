{"timestamp":"2026-11-19T10:21:06.483309Z","level":"info","event":"Running statement: -- 5.2 NULL required fields\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-17', 'TMP_PRICE_MASTER',\n       'NULL_REQUIRED_FIELD',\n       'Required price master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-17'\n  AND (\n       s.PRICE_DT IS NULL\n    OR s.ITEM_ID IS NULL\n    OR s.LOCATION_ID IS NULL\n    OR s.UNIT_PRICE_AMT IS NULL\n    OR s.EFF_FROM_DATE IS NULL\n    OR s.EFF_TO_DATE IS NULL\n  );, parameters: None","try_number":1,"run_id":"scheduled__2026-11-17T18:15:00+00:00","ti_id":"01a1f34f-a1d9-78a3-915f-b920bcbbb43a","dag_id":"my_etl_dag","map_index":-1,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
