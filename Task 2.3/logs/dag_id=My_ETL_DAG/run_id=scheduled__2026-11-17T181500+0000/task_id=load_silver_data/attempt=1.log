{"timestamp":"2026-11-19T10:20:56.088958Z","level":"info","event":"Running statement: -- 1.2 DUP rejects\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-17', 'TMP_STORE_MASTER',\n       'DUP_BUSINESS_KEY', 'LOCATION_ID duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nJOIN (\n    SELECT LOCATION_ID\n    FROM bronze.STG_STORE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-17' AND LOCATION_ID IS NOT NULL\n    GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n) d ON d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-17';, parameters: None","try_number":1,"run_id":"scheduled__2026-11-17T18:15:00+00:00","ti_id":"01a1f34f-a1d9-78a3-915f-b920bcbbb43a","dag_id":"my_etl_dag","map_index":-1,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
