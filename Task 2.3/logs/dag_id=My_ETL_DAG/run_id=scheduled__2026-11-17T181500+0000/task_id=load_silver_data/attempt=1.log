{"timestamp":"2026-11-19T10:20:59.833738Z","level":"info","event":"Running statement: -- 3.3 negatives\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-17', 'TMP_INVENTORY_MASTER',\n       'NEGATIVE_AMOUNT', 'STOCK_ON_HAND or IN_TRANSIT negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-17'\n  AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n  AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.STOCK_ON_HAND) < 0\n     OR TRY_TO_NUMBER(s.IN_TRANSIT)   < 0 );, parameters: None","try_number":1,"run_id":"scheduled__2026-11-17T18:15:00+00:00","ti_id":"01a1f34f-a1d9-78a3-915f-b920bcbbb43a","dag_id":"my_etl_dag","map_index":-1,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
