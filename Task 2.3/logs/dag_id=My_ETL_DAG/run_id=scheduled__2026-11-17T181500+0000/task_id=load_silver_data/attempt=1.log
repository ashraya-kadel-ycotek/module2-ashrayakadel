{"timestamp":"2026-11-19T10:20:55.663527Z","level":"info","event":"Running statement: -- ============================================================================\n-- 1. TMP_STORE_MASTER   (key: LOCATION_ID)\n-- ============================================================================\n-- 1.1 NULL rejects\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-17', 'TMP_STORE_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required store_master field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-17'\n  AND ( s.LOCATION_ID IS NULL OR s.LOCATION_NAME IS NULL\n     OR s.ADDRESS_LINE IS NULL OR s.DISTRICT_ID IS NULL\n     OR s.DISTRICT_NAME IS NULL OR s.DISTRICT_CODE IS NULL\n     OR s.STATE_ID IS NULL OR s.STATE_NAME IS NULL\n     OR s.STATE_CODE IS NULL );, parameters: None","try_number":1,"run_id":"scheduled__2026-11-17T18:15:00+00:00","ti_id":"01a1f34f-a1d9-78a3-915f-b920bcbbb43a","dag_id":"my_etl_dag","map_index":-1,"task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
