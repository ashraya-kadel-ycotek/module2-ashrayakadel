{"timestamp":"2026-11-20T03:05:32.463133Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA bronze;\n\nCREATE OR REPLACE TEMPORARY STAGE BRONZE.TMP_DAILY_STAGE\n    FILE_FORMAT = (\n        TYPE = CSV\n        FIELD_DELIMITER = ','\n        SKIP_HEADER = 1\n        FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n        EMPTY_FIELD_AS_NULL = TRUE\n        NULL_IF = ('', 'NULL')\n        TRIM_SPACE = TRUE\n    );\n\nPUT file:///opt/airflow/data/price_master_20261120.csv\n    @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\n\nBEGIN;\n\nDELETE FROM BRONZE.STG_PRICE_MASTER\nWHERE BATCH_ID = '2026-11-20'::DATE;\n\nCOPY INTO BRONZE.STG_PRICE_MASTER (\n    PRICE_DT, ITEM_ID, LOCATION_ID, UNIT_PRICE_AMT, EFF_FROM_DATE, EFF_TO_DATE,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5, t.$6,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-20'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/price_master_20261120.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;","run_id":"manual__2026-11-20T03:05:21.821631+00:00","ti_id":"01a1f6ea-70d5-7cbc-a251-491a50ab484b","try_number":1,"dag_id":"my_etl_dag","task_id":"load_bronze_data","map_index":3,"logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
