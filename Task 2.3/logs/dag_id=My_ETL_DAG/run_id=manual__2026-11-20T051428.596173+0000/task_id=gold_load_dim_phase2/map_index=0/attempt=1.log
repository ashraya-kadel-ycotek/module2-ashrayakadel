{"timestamp":"2026-11-20T05:15:37.797825Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New departments — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_DEPARTMENT (\n    DEPARTMENT_ID,\n    DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME, COMPANY_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.DEPARTMENT_ID,\n    src.DEPARTMENT_NAME,\n    src.DEPARTMENT_MANAGER_NAME,\n    src.COMPANY_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-20',\n    DATE '2026-11-20',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_DEPARTMENT_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_DEPARTMENT tgt\n    WHERE tgt.DEPARTMENT_ID = src.DEPARTMENT_ID\n);, parameters: None","task_id":"gold_load_dim_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"manual__2026-11-20T05:14:28.596173+00:00","map_index":0,"ti_id":"01a1f760-a5b1-78e7-9877-1c28823d9fa7","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
