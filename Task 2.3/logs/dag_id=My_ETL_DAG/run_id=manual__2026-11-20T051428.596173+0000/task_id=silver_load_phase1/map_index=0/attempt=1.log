CODE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE, s.DISTRICT_ID, s.DISTRICT_NAME,\n     s.DISTRICT_CODE, s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n     s.SRC_FILE_NM, DATE '2026-11-20', CURRENT_TIMESTAMP(), s.ROW_HASH);, parameters: None","dag_id":"my_etl_dag","ti_id":"01a1f760-a5a8-7d59-9426-d98fe37ab516","map_index":0,"run_id":"manual__2026-11-20T05:14:28.596173+00:00","task_id":"silver_load_phase1","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
