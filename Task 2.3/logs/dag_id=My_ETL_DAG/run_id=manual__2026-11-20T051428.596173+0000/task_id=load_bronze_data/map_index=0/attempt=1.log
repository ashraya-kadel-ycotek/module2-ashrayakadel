{"timestamp":"2026-11-20T05:14:39.885868Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA bronze;\n\nCREATE OR REPLACE TEMPORARY STAGE BRONZE.TMP_DAILY_STAGE\n    FILE_FORMAT = (\n        TYPE = CSV\n        FIELD_DELIMITER = ','\n        SKIP_HEADER = 1\n        FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n        EMPTY_FIELD_AS_NULL = TRUE\n        NULL_IF = ('', 'NULL')\n        TRIM_SPACE = TRUE\n    );\n\nPUT file:///opt/airflow/data/inventory_master_20261120.csv\n    @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\n\nBEGIN;\n\nDELETE FROM BRONZE.STG_INVENTORY_MASTER\nWHERE BATCH_ID = '2026-11-20'::DATE;\n\nCOPY INTO BRONZE.STG_INVENTORY_MASTER (\n    INVENTORY_DT, ITEM_ID, LOCATION_ID, STOCK_ON_HAND, IN_TRANSIT,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-20'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/inventory_master_20261120.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;","dag_id":"my_etl_dag","run_id":"manual__2026-11-20T05:14:28.596173+00:00","map_index":0,"task_id":"load_bronze_data","ti_id":"01a1f760-a5a1-7953-971c-2825655763c9","try_number":1,"logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
