{"timestamp":"2026-11-20T03:18:41.444202Z","level":"info","event":"Running statement: INSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_ITEM_MASTER WHERE BATCH_ID = DATE '2026-11-16'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-16' AND TARGET_TABLE = 'TMP_ITEM_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_ITEM_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-16'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-16' AND r.TARGET_TABLE = 'TMP_ITEM_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-16',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_ITEM_MASTER WHERE BATCH_ID = DATE '2026-11-16'),'item_master'),\n       'TMP_ITEM_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;, parameters: None","map_index":1,"task_id":"silver_load_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-16T18:15:00+00:00","ti_id":"01a1f6f2-81d0-7092-9ea6-0467ca09f078","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
