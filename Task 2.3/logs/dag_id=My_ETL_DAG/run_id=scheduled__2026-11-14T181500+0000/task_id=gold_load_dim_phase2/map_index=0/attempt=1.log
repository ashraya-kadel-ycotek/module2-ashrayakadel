{"timestamp":"2026-11-20T04:37:19.685918Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but MANAGER changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DEPARTMENT tgt\nSET\n    DEPARTMENT_MANAGER_NAME = src.DEPARTMENT_MANAGER_NAME,\n    REC_UPDT_TS             = CURRENT_TIMESTAMP(),\n    BATCH_ID                = DATE '2026-11-14'\nFROM TMP_DIM_DEPARTMENT_SRC src\nWHERE tgt.DEPARTMENT_ID = src.DEPARTMENT_ID\n  AND tgt.CURR_FLG      = TRUE\n  AND COALESCE(tgt.DEPARTMENT_NAME, '') = COALESCE(src.DEPARTMENT_NAME, '')\n  AND tgt.COMPANY_KY = src.COMPANY_KY\n  AND COALESCE(tgt.DEPARTMENT_MANAGER_NAME, '') <> COALESCE(src.DEPARTMENT_MANAGER_NAME, '');, parameters: None","map_index":0,"task_id":"gold_load_dim_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-14T18:15:00+00:00","ti_id":"01a1f73d-b266-7fee-bd7f-dbc164afaacd","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
