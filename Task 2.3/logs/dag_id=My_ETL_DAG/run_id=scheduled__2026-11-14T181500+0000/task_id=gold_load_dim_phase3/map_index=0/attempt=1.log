{"timestamp":"2026-11-20T04:37:25.684167Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but DESCRIPTION changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CLASS tgt\nSET\n    CLASS_DESCRIPTION = src.CLASS_DESCRIPTION,\n    REC_UPDT_TS       = CURRENT_TIMESTAMP(),\n    BATCH_ID          = DATE '2026-11-14'\nFROM TMP_DIM_CLASS_SRC src\nWHERE tgt.CLASS_ID = src.CLASS_ID\n  AND tgt.CURR_FLG = TRUE\n  AND COALESCE(tgt.CLASS_NAME, '') = COALESCE(src.CLASS_NAME, '')\n  AND tgt.DEPARTMENT_KY = src.DEPARTMENT_KY\n  AND COALESCE(tgt.CLASS_DESCRIPTION, '') <> COALESCE(src.CLASS_DESCRIPTION, '');, parameters: None","map_index":0,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"scheduled__2026-11-14T18:15:00+00:00","ti_id":"01a1f73d-b268-7369-b777-442e844400f1","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
