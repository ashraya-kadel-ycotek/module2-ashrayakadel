{"timestamp":"2026-11-20T04:15:01.527594Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-20', 'TMP_POS_SALES',\n       'NEGATIVE_AMOUNT', 'SLS_QTY or SLS_AMT negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-20'\n  AND TRY_TO_NUMBER(s.SLS_QTY) IS NOT NULL\n  AND TRY_TO_NUMBER(s.SLS_AMT) IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.SLS_QTY) < 0 OR TRY_TO_NUMBER(s.SLS_AMT) < 0 );, parameters: None","run_id":"manual__2026-11-20T04:14:23.100617+00:00","task_id":"silver_load_phase2","map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f729-a1ae-7ffa-afec-7920c08761cd","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
