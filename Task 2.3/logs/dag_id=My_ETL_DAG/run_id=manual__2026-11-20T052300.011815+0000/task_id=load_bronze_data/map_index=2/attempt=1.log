{"timestamp":"2026-11-20T05:23:12.025886Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA bronze;\n\nCREATE OR REPLACE TEMPORARY STAGE BRONZE.TMP_DAILY_STAGE\n    FILE_FORMAT = (\n        TYPE = CSV\n        FIELD_DELIMITER = ','\n        SKIP_HEADER = 1\n        FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n        EMPTY_FIELD_AS_NULL = TRUE\n        NULL_IF = ('', 'NULL')\n        TRIM_SPACE = TRUE\n    );\n\nPUT file:///opt/airflow/data/pos_sales_20261120.csv\n    @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\n\nBEGIN;\n\nDELETE FROM BRONZE.STG_POS_SALES\nWHERE BATCH_ID = '2026-11-20'::DATE;\n\nCOPY INTO BRONZE.STG_POS_SALES (\n    TRANSACTION_ID, TRANSACTION_LINE_NUMBER, SALES_DT, ITEM_ID, LOCATION_ID,\n    CUSTOMER_ID, CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE,\n    SLS_QTY, SLS_AMT,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5,\n        t.$6, t.$7, t.$8, t.$9, t.$10, t.$11,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-20'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/pos_sales_20261120.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;","task_id":"load_bronze_data","try_number":1,"ti_id":"01a1f768-7362-7d7c-bf83-5eeee9d3bf02","run_id":"manual__2026-11-20T05:23:00.011815+00:00","dag_id":"my_etl_dag","map_index":2,"logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
