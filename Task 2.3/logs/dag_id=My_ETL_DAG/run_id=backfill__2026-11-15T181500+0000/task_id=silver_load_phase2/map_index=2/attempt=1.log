{"timestamp":"2026-11-20T03:17:58.689565Z","level":"info","event":"Running statement: -- 5.3 Negative price\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_PRICE_MASTER',\n       'NEGATIVE_AMOUNT',\n       'UNIT_PRICE_AMT is negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND TRY_TO_NUMBER(s.UNIT_PRICE_AMT) < 0;, parameters: None","task_id":"silver_load_phase2","try_number":1,"run_id":"backfill__2026-11-15T18:15:00+00:00","map_index":2,"dag_id":"my_etl_dag","ti_id":"01a1f6f2-81af-7aa3-88d9-de221705a0c2","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
