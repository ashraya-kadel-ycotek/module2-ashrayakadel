{"timestamp":"2026-11-20T03:16:50.017968Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_POS_SALES',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in dims',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND (\n      NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_ITEM_MASTER i\n          WHERE i.ITEM_ID = s.ITEM_ID\n      )\n      OR NOT EXISTS (\n          SELECT 1\n          FROM silver.TMP_STORE_MASTER st\n          WHERE st.LOCATION_ID = s.LOCATION_ID\n      )\n  );, parameters: None","task_id":"silver_load_phase2","ti_id":"01a1f6f4-5e69-7225-b2e0-ff7ea58634a2","run_id":"scheduled__2026-11-19T18:15:00+00:00","dag_id":"my_etl_dag","map_index":1,"try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
