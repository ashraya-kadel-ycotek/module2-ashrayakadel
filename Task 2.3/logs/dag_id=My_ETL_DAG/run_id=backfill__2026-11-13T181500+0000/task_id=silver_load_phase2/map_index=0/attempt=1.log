{"timestamp":"2026-11-20T03:14:49.161836Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-13', 'TMP_INVENTORY_MASTER',\n       'DUP_BUSINESS_KEY',\n       '(INVENTORY_DT, ITEM_ID, LOCATION_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nJOIN (\n    SELECT TRY_TO_DATE(INVENTORY_DT,'YYYY-MM-DD') AS D, ITEM_ID, LOCATION_ID\n    FROM bronze.STG_INVENTORY_MASTER\n    WHERE BATCH_ID = DATE '2026-11-13'\n    GROUP BY 1,2,3 HAVING COUNT(*) > 1\n) d ON  d.D = TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD')\n    AND d.ITEM_ID = s.ITEM_ID\n    AND d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-13';, parameters: None","task_id":"silver_load_phase2","ti_id":"01a1f6f2-8165-7516-92f5-a51ce9f98e66","run_id":"backfill__2026-11-13T18:15:00+00:00","dag_id":"my_etl_dag","map_index":0,"try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
