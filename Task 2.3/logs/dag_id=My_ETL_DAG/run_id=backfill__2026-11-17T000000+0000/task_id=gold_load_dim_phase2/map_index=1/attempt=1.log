{"timestamp":"2026-11-20T07:21:01.074648Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_DISTRICT\n-- Source : silver.TMP_STORE_MASTER\n-- Parent : DIM_STATE (STATE_KY via STATE_ID, CURR_FLG = TRUE)\n-- SCD    : DISTRICT_CODE -> SCD2\n--          DISTRICT_NAME -> SCD1\n-- Dedup  : one row per DISTRICT_ID from today's batch\n-- KY     : DISTRICT_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent STATE_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_DISTRICT_SRC AS\nWITH ranked AS (\n    SELECT\n        s.DISTRICT_ID,\n        s.DISTRICT_NAME,\n        s.DISTRICT_CODE,\n        s.STATE_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.DISTRICT_ID\n            ORDER BY s._LOAD_TS DESC, s.LOCATION_ID DESC\n        ) AS RN\n    FROM silver.TMP_STORE_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-17'\n      AND s.DISTRICT_ID IS NOT NULL\n)\nSELECT\n    r.DISTRICT_ID,\n    r.DISTRICT_NAME,\n    r.DISTRICT_CODE,\n    st.STATE_KY\nFROM ranked r\nJOIN gold.DIM_STATE st\n  ON st.STATE_ID = r.STATE_ID\n AND st.CURR_FLG = TRUE\nWHERE r.RN = 1;, parameters: None","map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f7ce-38da-779c-83ad-59372a383602","try_number":1,"run_id":"backfill__2026-11-17T00:00:00+00:00","task_id":"gold_load_dim_phase2","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:21:01.653345Z","level":"info","event":"Rows affected: 1","map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f7ce-38da-779c-83ad-59372a383602","try_number":1,"run_id":"backfill__2026-11-17T00:00:00+00:00","task_id":"gold_load_dim_phase2","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T07:21:01.653608Z","level":"info","event":"Snowflake query id: 01c88859-0003-1f3e-000f-4ff6001331aa","map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f7ce-38da-779c-83ad-59372a383602","try_number":1,"run_id":"backfill__2026-11-17T00:00:00+00:00","task_id":"gold_load_dim_phase2","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:21:01.653729Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose DISTRICT_CODE is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_DISTRICT tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-17'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-17'\nFROM TMP_DIM_DISTRICT_SRC src\nWHERE tgt.DISTRICT_ID = src.DISTRICT_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND (\n        COALESCE(tgt.DISTRICT_CODE, '') <> COALESCE(src.DISTRICT_CODE, '')\n     OR tgt.STATE_KY <> src.STATE_KY\n  );, parameters: None","map_index":1,"dag_id":"my_etl_dag","ti_id":"01a1f7ce-38da-779c-83ad-59372a383602","try_number":1,"run_id":"backfill__2026-11-17T00:00:00+00:00","task_id":"gold_load_dim_phase2","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
