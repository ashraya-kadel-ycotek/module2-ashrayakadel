{"timestamp":"2026-11-20T07:21:00.910508Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_DEPARTMENT\n-- Source : silver.TMP_ITEM_MASTER\n-- Parent : DIM_COMPANY (COMPANY_KY via COMPANY_ID, CURR_FLG = TRUE)\n-- SCD    : DEPARTMENT_NAME         -> SCD2\n--          DEPARTMENT_MANAGER_NAME -> SCD1\n-- Dedup  : one row per DEPARTMENT_ID from today's batch\n-- KY     : DEPARTMENT_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent COMPANY_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_DEPARTMENT_SRC AS\nWITH ranked AS (\n    SELECT\n        s.DEPARTMENT_ID,\n        s.DEPARTMENT_NAME,\n        s.DEPARTMENT_MANAGER_NAME,\n        s.COMPANY_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.DEPARTMENT_ID\n            ORDER BY s._LOAD_TS DESC, s.ITEM_ID DESC\n        ) AS RN\n    FROM silver.TMP_ITEM_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-17'\n      AND s.DEPARTMENT_ID IS NOT NULL\n)\nSELECT\n    r.DEPARTMENT_ID,\n    r.DEPARTMENT_NAME,\n    r.DEPARTMENT_MANAGER_NAME,\n    c.COMPANY_KY\nFROM ranked r\nJOIN gold.DIM_COMPANY c\n  ON c.COMPANY_ID = r.COMPANY_ID\n AND c.CURR_FLG   = TRUE\nWHERE r.RN = 1;, parameters: None","dag_id":"my_etl_dag","map_index":0,"try_number":1,"ti_id":"01a1f7ce-38d9-7483-9da0-bd226dc1649c","task_id":"gold_load_dim_phase2","run_id":"backfill__2026-11-17T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:21:01.417887Z","level":"info","event":"Rows affected: 1","dag_id":"my_etl_dag","map_index":0,"try_number":1,"ti_id":"01a1f7ce-38d9-7483-9da0-bd226dc1649c","task_id":"gold_load_dim_phase2","run_id":"backfill__2026-11-17T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
