MER c\n       ON c.CUSTOMER_ID = src.CUSTOMER_ID\n      AND src.SALES_DT BETWEEN c.EFF_FROM_DATE AND c.EFF_TO_DATE\n\nWHERE src._BATCH_ID = DATE '2026-11-17';, parameters: None","dag_id":"my_etl_dag","map_index":0,"try_number":1,"ti_id":"01a1f85d-8a24-78ad-bba4-665273d63168","task_id":"gold_load_fct_phase1","run_id":"backfill__2026-11-17T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
