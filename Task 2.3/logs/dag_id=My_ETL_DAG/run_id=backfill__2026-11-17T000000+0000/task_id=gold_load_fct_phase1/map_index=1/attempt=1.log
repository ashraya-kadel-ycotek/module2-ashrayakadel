{"timestamp":"2026-11-20T09:58:09.300730Z","level":"info","event":"Snowflake query id: 01c888f6-0003-1ebf-000f-4ff6001453fa","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f85d-8a25-7508-b8bc-6adc10de5c0a","task_id":"gold_load_fct_phase1","run_id":"backfill__2026-11-17T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T09:58:09.300810Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3. MERGE valid rows into FCT_PRICE — idempotent on the grain.\n-- ----------------------------------------------------------------------------\nMERGE INTO gold.FCT_PRICE t\nUSING (\n    SELECT\n        DAY_KY, ITEM_KY, LOCATION_KY,\n        UNIT_PRICE_AMT,\n        SRC_EFF_FROM_DATE, SRC_EFF_TO_DATE\n    FROM TMP_FCT_PRICE_STG\n    WHERE RI_FAIL_FLG = FALSE\n) s\nON  t.DAY_KY      = s.DAY_KY\nAND t.ITEM_KY     = s.ITEM_KY\nAND t.LOCATION_KY = s.LOCATION_KY\n\nWHEN MATCHED AND (\n        COALESCE(t.UNIT_PRICE_AMT, -1) <> COALESCE(s.UNIT_PRICE_AMT, -1)\n     OR COALESCE(t.EFF_FROM_DATE, DATE '1900-01-01') <> COALESCE(s.SRC_EFF_FROM_DATE, DATE '1900-01-01')\n     OR COALESCE(t.EFF_TO_DATE,   DATE '9999-12-31') <> COALESCE(s.SRC_EFF_TO_DATE,   DATE '9999-12-31')\n) THEN UPDATE SET\n    UNIT_PRICE_AMT = s.UNIT_PRICE_AMT,\n    EFF_FROM_DATE  = s.SRC_EFF_FROM_DATE,\n    EFF_TO_DATE    = s.SRC_EFF_TO_DATE,\n    REC_UPDT_TS    = CURRENT_TIMESTAMP(),\n    BATCH_ID       = DATE '2026-11-17',\n    SRC_SYS_CD     = 'TMP_PRICE_MASTER'\n\nWHEN NOT MATCHED THEN INSERT (\n    DAY_KY, ITEM_KY, LOCATION_KY,\n    UNIT_PRICE_AMT,\n    EFF_FROM_DATE, EFF_TO_DATE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID\n)\nVALUES (\n    s.DAY_KY, s.ITEM_KY, s.LOCATION_KY,\n    s.UNIT_PRICE_AMT,\n    s.SRC_EFF_FROM_DATE, s.SRC_EFF_TO_DATE,\n    CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'TMP_PRICE_MASTER', DATE '2026-11-17'\n);, parameters: None","dag_id":"my_etl_dag","map_index":1,"try_number":1,"ti_id":"01a1f85d-8a25-7508-b8bc-6adc10de5c0a","task_id":"gold_load_fct_phase1","run_id":"backfill__2026-11-17T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
