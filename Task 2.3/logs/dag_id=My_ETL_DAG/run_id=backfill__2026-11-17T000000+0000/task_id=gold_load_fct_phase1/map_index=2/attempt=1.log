{"timestamp":"2026-11-20T07:21:18.304619Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: FCT_INVENTORY\n-- Source : silver.TMP_INVENTORY_MASTER\n-- Grain  : (DAY_KY, ITEM_KY, LOCATION_KY)\n-- FKs    : DAY_KY, ITEM_KY, LOCATION_KY — all resolved as-of INVENTORY_DT\n-- EFF_*  : from DIM_ITEM (silver has no EFF_* cols)\n-- Rejects: rows whose dim FKs don't resolve -> control.C_REJ_TABLE\n--          SRC_ROW_NUM = NULL (silver doesn't carry it);\n--          _ROW_HASH is preserved in DETAILS:SRC_ROW_HASH for traceability.\n-- MERGE  : idempotent on (DAY_KY, ITEM_KY, LOCATION_KY)\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Build staged fact rows with resolved dim FKs + RI flag.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_FCT_INVENTORY_STG AS\nSELECT\n    src.INVENTORY_DT,\n    src.ITEM_ID,\n    src.LOCATION_ID,\n    src.STOCK_ON_HAND,\n    src.IN_TRANSIT,\n    i.EFF_FROM_DATE             AS SRC_EFF_FROM_DATE,\n    i.EFF_TO_DATE               AS SRC_EFF_TO_DATE,\n    src._SRC_FILE_NM            AS SRC_FILE_NM,\n    src._ROW_HASH               AS SRC_ROW_HASH,\n    CAST(NULL AS NUMBER)        AS SRC_ROW_NUM,\n\n    d.DAY_KY,\n    i.ITEM_KY,\n    l.LOCATION_KY,\n\n    (d.DAY_KY IS NULL OR i.ITEM_KY IS NULL OR l.LOCATION_KY IS NULL) AS RI_FAIL_FLG\n\nFROM silver.TMP_INVENTORY_MASTER src\n\nLEFT JOIN gold.DIM_DAY d\n       ON d.CALENDAR_DT = src.INVENTORY_DT\n\nLEFT JOIN gold.DIM_ITEM i\n       ON i.ITEM_ID = src.ITEM_ID\n      AND src.INVENTORY_DT BETWEEN i.EFF_FROM_DATE AND i.EFF_TO_DATE\n\nLEFT JOIN gold.DIM_LOCATION l\n       ON l.LOCATION_ID = src.LOCATION_ID\n      AND src.INVENTORY_DT BETWEEN l.EFF_FROM_DATE AND l.EFF_TO_DATE\n\nWHERE src._BATCH_ID = DATE '2026-11-17';, parameters: None","map_index":2,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38e0-773d-bc40-34012dd44762","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:21:19.038804Z","level":"info","event":"Rows affected: 1","map_index":2,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38e0-773d-bc40-34012dd44762","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T07:21:19.039026Z","level":"info","event":"Snowflake query id: 01c88859-0003-1f41-000f-4ff60012e9c6","map_index":2,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38e0-773d-bc40-34012dd44762","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:21:19.039115Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. Write join-miss rows to the reject table.\n-- ----------------------------------------------------------------------------\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT\n    s.SRC_FILE_NM,\n    DATE '2026-11-17',\n    'FCT_INVENTORY',\n    'REFERENTIAL_INTEGRITY_FAILURE',\n    'DAY_KY / ITEM_KY / LOCATION_KY could not be resolved as-of INVENTORY_DT',\n    OBJECT_CONSTRUCT(\n        'INVENTORY_DT',   s.INVENTORY_DT,\n        'ITEM_ID',        s.ITEM_ID,\n        'LOCATION_ID',    s.LOCATION_ID,\n        'STOCK_ON_HAND',  s.STOCK_ON_HAND,\n        'IN_TRANSIT',     s.IN_TRANSIT,\n        'DAY_KY',         s.DAY_KY,\n        'ITEM_KY',        s.ITEM_KY,\n        'LOCATION_KY',    s.LOCATION_KY,\n        'SRC_FILE_NM',    s.SRC_FILE_NM,\n        'SRC_ROW_HASH',   s.SRC_ROW_HASH\n    )\nFROM TMP_FCT_INVENTORY_STG s\nWHERE s.RI_FAIL_FLG = TRUE;, parameters: None","map_index":2,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38e0-773d-bc40-34012dd44762","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:21:19.434935Z","level":"info","event":"Rows affected: 40","map_index":2,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38e0-773d-bc40-34012dd44762","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T07:21:19.435223Z","level":"info","event":"Snowflake query id: 01c88859-0003-1f41-000f-4ff60012e9ca","map_index":2,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38e0-773d-bc40-34012dd44762","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:21:19.435292Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3. MERGE valid rows into FCT_INVENTORY — idempotent on the grain.\n-- ----------------------------------------------------------------------------\nMERGE INTO gold.FCT_INVENTORY t\nUSING (\n    SELECT\n        DAY_KY, ITEM_KY, LOCATION_KY,\n        STOCK_ON_HAND, IN_TRANSIT,\n        SRC_EFF_FROM_DATE, SRC_EFF_TO_DATE\n    FROM TMP_FCT_INVENTORY_STG\n    WHERE RI_FAIL_FLG = FALSE\n) s\nON  t.DAY_KY      = s.DAY_KY\nAND t.ITEM_KY     = s.ITEM_KY\nAND t.LOCATION_KY = s.LOCATION_KY\n\nWHEN MATCHED AND (\n        COALESCE(t.STOCK_ON_HAND, -1) <> COALESCE(s.STOCK_ON_HAND, -1)\n     OR COALESCE(t.IN_TRANSIT,    -1) <> COALESCE(s.IN_TRANSIT,    -1)\n     OR COALESCE(t.EFF_FROM_DATE, DATE '1900-01-01') <> COALESCE(s.SRC_EFF_FROM_DATE, DATE '1900-01-01')\n     OR COALESCE(t.EFF_TO_DATE,   DATE '9999-12-31') <> COALESCE(s.SRC_EFF_TO_DATE,   DATE '9999-12-31')\n) THEN UPDATE SET\n    STOCK_ON_HAND = s.STOCK_ON_HAND,\n    IN_TRANSIT    = s.IN_TRANSIT,\n    EFF_FROM_DATE = s.SRC_EFF_FROM_DATE,\n    EFF_TO_DATE   = s.SRC_EFF_TO_DATE,\n    REC_UPDT_TS   = CURRENT_TIMESTAMP(),\n    BATCH_ID      = DATE '2026-11-17',\n    SRC_SYS_CD    = 'TMP_INVENTORY_MASTER'\n\nWHEN NOT MATCHED THEN INSERT (\n    DAY_KY, ITEM_KY, LOCATION_KY,\n    STOCK_ON_HAND, IN_TRANSIT,\n    EFF_FROM_DATE, EFF_TO_DATE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID\n)\nVALUES (\n    s.DAY_KY, s.ITEM_KY, s.LOCATION_KY,\n    s.STOCK_ON_HAND, s.IN_TRANSIT,\n    s.SRC_EFF_FROM_DATE, s.SRC_EFF_TO_DATE,\n    CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'TMP_INVENTORY_MASTER', DATE '2026-11-17'\n);, parameters: None","map_index":2,"task_id":"gold_load_fct_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38e0-773d-bc40-34012dd44762","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
