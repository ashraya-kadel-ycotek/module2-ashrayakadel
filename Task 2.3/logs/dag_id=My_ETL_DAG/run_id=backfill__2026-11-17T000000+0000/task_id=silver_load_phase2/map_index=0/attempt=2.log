{"timestamp":"2026-11-20T07:39:21.827171Z","level":"info","event":"Running statement: INSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-17'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-17' AND TARGET_TABLE = 'TMP_INVENTORY_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-17'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-17' AND r.TARGET_TABLE = 'TMP_INVENTORY_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-17',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-17'),'inventory_master'),\n       'TMP_INVENTORY_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;, parameters: None","ti_id":"01a1f7df-2e2f-7e00-af23-460fb334ac81","try_number":2,"map_index":0,"run_id":"backfill__2026-11-17T00:00:00+00:00","dag_id":"my_etl_dag","task_id":"silver_load_phase2","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
