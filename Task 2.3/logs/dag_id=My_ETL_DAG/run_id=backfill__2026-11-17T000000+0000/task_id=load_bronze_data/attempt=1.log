{"timestamp":"2026-11-18T10:54:40.299565Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA bronze;\n\n-- ============================================================\n-- 1. CREATE A TEMPORARY STAGE FOR THE DAILY FILES\n-- ============================================================\nCREATE OR REPLACE TEMPORARY STAGE BRONZE.TMP_DAILY_STAGE\n    FILE_FORMAT = (\n        TYPE = CSV\n        FIELD_DELIMITER = ','\n        SKIP_HEADER = 1\n        FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n        EMPTY_FIELD_AS_NULL = TRUE\n        NULL_IF = ('', 'NULL')\n        TRIM_SPACE = TRUE\n    );\n\n\nPUT file:///opt/airflow/data/store_master_20261117.csv @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/item_master_20261117.csv @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/inventory_master_20261117.csv @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/pos_sales_20261117.csv @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\nPUT file:///opt/airflow/data/price_master_20261117.csv @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\n-- ============================================================\n-- 2. UPLOAD FILES FROM AIRFLOW CONTAINER TO SNOWFLAKE STAGE\n-- (Airflow's SnowflakeOperator runs these PUT commands)\n-- ============================================================\n\n-- ============================================================\n-- 3. COPY INTO BRONZE TABLES WITH AUDIT COLUMNS\n-- ============================================================\n\n-- STORE_MASTER\nCOPY INTO BRONZE.STORE_MASTER (\n    LOCATION_ID, LOCATION_NAME, ADDRESS_LINE, DISTRICT_ID, DISTRICT_NAME, \n    DISTRICT_CODE, STATE_ID, STATE_NAME, STATE_CODE,\n    SRC_FILE_NM, SRC_ROW_COUNT, BATCH_ID\n)\nFROM (\n    SELECT \n        t.$1, t.$2, t.$3, t.$4, t.$5, \n        t.$6, t.$7, t.$8, t.$9,\n        METADATA$FILENAME::VARCHAR(255), \n        METADATA$FILE_ROW_NUMBER, \n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/store_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'ABORT_STATEMENT'; \n\n-- ITEM_MASTER\nCOPY INTO BRONZE.ITEM_MASTER (\n    ITEM_ID, ITEM_NAME, COLOR, SIZE, CLASS_ID, CLASS_NAME, CLASS_DESCRIPTION, \n    DEPARTMENT_ID, DEPARTMENT_NAME, DEPARTMENT_MANAGER_NAME, COMPANY_ID, COMPANY_NAME, COMPANY_TYPE,\n    SRC_FILE_NM, SRC_ROW_COUNT, BATCH_ID\n)\nFROM (\n    SELECT \n        t.$1, t.$2, t.$3, t.$4, t.$5, t.$6, t.$7, \n        t.$8, t.$9, t.$10, t.$11, t.$12, t.$13,\n        METADATA$FILENAME::VARCHAR(255), \n        METADATA$FILE_ROW_NUMBER, \n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/item_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'ABORT_STATEMENT';\n\n-- INVENTORY_MASTER\nCOPY INTO BRONZE.INVENTORY_MASTER (\n    INVENTORY_DT, ITEM_ID, LOCATION_ID, STOCK_ON_HAND, IN_TRANSIT,\n    SRC_FILE_NM, SRC_ROW_COUNT, BATCH_ID\n)\nFROM (\n    SELECT \n        t.$1, t.$2, t.$3, t.$4, t.$5,\n        METADATA$FILENAME::VARCHAR(255), \n        METADATA$FILE_ROW_NUMBER, \n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/inventory_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'ABORT_STATEMENT';\n\n-- POS_SALES\nCOPY INTO BRONZE.POS_SALES (\n    TRANSACTION_ID, TRANSACTION_LINE_NUMBER, SALES_DT, ITEM_ID, LOCATION_ID, \n    CUSTOMER_ID, CUSTOMER_NAME, CUSTOMER_EMAIL, CUSTOMER_PHONE, SLS_QTY, SLS_AMT,\n    SRC_FILE_NM, SRC_ROW_COUNT, BATCH_ID\n)\nFROM (\n    SELECT \n        t.$1, t.$2, t.$3, t.$4, t.$5, \n        t.$6, t.$7, t.$8, t.$9, t.$10, t.$11,\n        METADATA$FILENAME::VARCHAR(255), \n        METADATA$FILE_ROW_NUMBER, \n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/pos_sales_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'ABORT_STATEMENT';\n\n-- PRICE_MASTER\nCOPY INTO BRONZE.PRICE_MASTER (\n    PRICE_DT, ITEM_ID, LOCATION_ID, UNIT_PRICE_AMT, EFF_FROM_DATE, EFF_TO_DATE,\n    SRC_FILE_NM, SRC_ROW_COUNT, BATCH_ID\n)\nFROM (\n    SELECT \n        t.$1, t.$2, t.$3, t.$4, t.$5, t.$6,\n        METADATA$FILENAME::VARCHAR(255), \n        METADATA$FILE_ROW_NUMBER, \n        '2026-11-17'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/price_master_20261117.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'ABORT_STATEMENT';\n\n-- Clean up the stage\nREMOVE @BRONZE.TMP_DAILY_STAGE;","dag_id":"my_etl_dag","try_number":1,"task_id":"load_bronze_data","ti_id":"01a1ee4b-398d-7959-a11c-bbc8bcac2a89","run_id":"backfill__2026-11-17T00:00:00+00:00","map_index":-1,"logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
