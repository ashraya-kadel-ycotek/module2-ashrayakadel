{"timestamp":"2026-11-20T09:57:46.406564Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose STATE_CODE is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_STATE tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-17'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-17'\nFROM TMP_DIM_STATE_SRC src\nWHERE tgt.STATE_ID = src.STATE_ID\n  AND tgt.CURR_FLG = TRUE\n  AND COALESCE(tgt.STATE_CODE, '') <> COALESCE(src.STATE_CODE, '');, parameters: None","map_index":1,"task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f85d-8a1d-752c-b27b-7dc5c026bc99","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
