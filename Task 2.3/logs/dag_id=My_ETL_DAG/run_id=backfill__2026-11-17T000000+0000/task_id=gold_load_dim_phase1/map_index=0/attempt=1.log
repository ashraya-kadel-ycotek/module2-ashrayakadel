{"timestamp":"2026-11-20T07:20:53.921132Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose COMPANY_NAME is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_COMPANY tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-17'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-17'\nFROM TMP_DIM_COMPANY_SRC src\nWHERE tgt.COMPANY_ID = src.COMPANY_ID\n  AND tgt.CURR_FLG   = TRUE\n  AND COALESCE(tgt.COMPANY_NAME, '') <> COALESCE(src.COMPANY_NAME, '');, parameters: None","task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","map_index":0,"ti_id":"01a1f7ce-38d6-74e6-ae1b-12bbb81b8463","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
