{"timestamp":"2026-11-20T07:20:54.147831Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for companies whose name changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_COMPANY (\n    COMPANY_ID,\n    COMPANY_NAME, COMPANY_TYPE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.COMPANY_ID,\n    src.COMPANY_NAME,\n    src.COMPANY_TYPE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-17',\n    DATE '2026-11-17',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_COMPANY_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_COMPANY tgt\n    WHERE tgt.COMPANY_ID = src.COMPANY_ID\n      AND tgt.CURR_FLG   = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-17')\n      AND tgt.BATCH_ID   = DATE '2026-11-17'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_COMPANY tgt\n    WHERE tgt.COMPANY_ID = src.COMPANY_ID\n      AND tgt.CURR_FLG   = TRUE\n);, parameters: None","task_id":"gold_load_dim_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-17T00:00:00+00:00","map_index":0,"ti_id":"01a1f7ce-38d6-74e6-ae1b-12bbb81b8463","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
