{"timestamp":"2026-11-20T07:20:45.608086Z","level":"info","event":"Running statement: -- ======================================================================\n-- RETAIL SNOWFLAKE SCHEMA: tables + date seed (2026-01-01 .. 2035-12-31)\n-- Safe to rerun: CREATE ... IF NOT EXISTS, and the seed only INSERTS missing rows.\n-- Week convention: ISO (Monday start). A week belongs to the month of its THURSDAY.\n-- FCT_SALES_PER_WEEK aggregate: grain = week / item / location (no customer).\n-- All objects are FULLY QUALIFIED (MODULE2_ETL.GOLD.<table>).\n-- No SET variables. No BEGIN TRANSACTION wrapper (Airflow split_statements safe).\n--\n-- Surrogate keys: AUTOINCREMENT — load scripts MUST NOT supply _KY on INSERT.\n-- BATCH_ID is DATE (matches bronze/silver).\n-- ======================================================================\n\n\nCREATE DATABASE IF NOT EXISTS MODULE2_ETL;, parameters: None","task_id":"run_gold_ddl","run_id":"backfill__2026-11-17T00:00:00+00:00","ti_id":"01a1f7ce-38d5-78b0-95a9-aba5fef0da85","dag_id":"my_etl_dag","try_number":1,"map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
