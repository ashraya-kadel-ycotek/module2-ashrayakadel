{"timestamp":"2026-11-20T06:29:17.660515Z","level":"info","event":"Executing: -- ======================================================================\n-- RETAIL SNOWFLAKE SCHEMA: tables + date seed (2026-01-01 .. 2035-12-31)\n-- Safe to rerun: CREATE ... IF NOT EXISTS, and the seed only INSERTS missing rows.\n-- Week convention: ISO (Monday start). A week belongs to the month of its THURSDAY.\n-- FCT_SALES_PER_WEEK aggregate: grain = week / item / location (no customer).\n-- All objects are FULLY QUALIFIED (MODULE2_ETL.GOLD.<table>).\n-- No SET variables. No BEGIN TRANSACTION wrapper (Airflow split_statements safe).\n--\n-- Surrogate keys: AUTOINCREMENT — load scripts MUST NOT supply _KY on INSERT.\n-- BATCH_ID is DATE (matches bronze/silver).\n-- ======================================================================\n\n\nCREATE DATABASE IF NOT EXISTS MODULE2_ETL;\nCREATE SCHEMA IF NOT EXISTS MODULE2_ETL.GOLD;\n\n-- ======================================================================\n-- TABLES\n-- ======================================================================\n\n-- DIM_YEAR\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_YEAR (\n    YEAR_KY                   INT AUTOINCREMENT START 1 INCREMENT 1 ORDER NOT NULL,\n    YEAR_ID                   INT NOT NULL,\n    CALENDAR_YEAR             NUMBER(4,0),\n    LEAP_YEAR_FLG             BOOLEAN,\n    FISCAL_YEAR_LABEL         VARCHAR,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_YEAR PRIMARY KEY (YEAR_KY),\n    CONSTRAINT UQ_DIM_YEAR_YEAR_ID UNIQUE (YEAR_ID)\n)\nCOMMENT = 'Date hierarchy dimension. All attributes SCD Type 1, single row per business key.';\n\n-- DIM_QUARTER\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_QUARTER (\n    QUARTER_KY                INT AUTOINCREMENT START 1 INCREMENT 1 ORDER NOT NULL,\n    QUARTER_ID                INT NOT NULL,\n    QUARTER_NUMBER            NUMBER(1,0),\n    QUARTER_NAME              VARCHAR,\n    YEAR_KY                   INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_QUARTER PRIMARY KEY (QUARTER_KY),\n    CONSTRAINT UQ_DIM_QUARTER_QUARTER_ID UNIQUE (QUARTER_ID),\n    CONSTRAINT FK_DIM_QUARTER_YEAR_KY FOREIGN KEY (YEAR_KY) REFERENCES MODULE2_ETL.GOLD.DIM_YEAR (YEAR_KY)\n)\nCOMMENT = 'Date hierarchy dimension. All attributes SCD Type 1, single row per business key.';\n\n-- DIM_MONTH\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_MONTH (\n    MONTH_KY                  INT AUTOINCREMENT START 1 INCREMENT 1 ORDER NOT NULL,\n    MONTH_ID                  INT NOT NULL,\n    MONTH_NAME                VARCHAR,\n    MONTH_NUMBER              NUMBER(2,0),\n    DAYS_IN_MONTH_NUMBER      NUMBER(2,0),\n    QUARTER_KY                INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_MONTH PRIMARY KEY (MONTH_KY),\n    CONSTRAINT UQ_DIM_MONTH_MONTH_ID UNIQUE (MONTH_ID),\n    CONSTRAINT FK_DIM_MONTH_QUARTER_KY FOREIGN KEY (QUARTER_KY) REFERENCES MODULE2_ETL.GOLD.DIM_QUARTER (QUARTER_KY)\n)\nCOMMENT = 'Date hierarchy dimension. All attributes SCD Type 1, single row per business key.';\n\n-- DIM_WEEK\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_WEEK (\n    WEEK_KY                   INT AUTOINCREMENT START 1 INCREMENT 1 ORDER NOT NULL,\n    WEEK_ID                   INT NOT NULL,\n    WEEK_START_DT             DATE,\n    WEEK_END_DT               DATE,\n    WEEK_OF_YEAR_NUMBER       NUMBER(2,0),\n    MONTH_KY                  INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_WEEK PRIMARY KEY (WEEK_KY),\n    CONSTRAINT UQ_DIM_WEEK_WEEK_ID UNIQUE (WEEK_ID),\n    CONSTRAINT UQ_DIM_WEEK_WEEK_START_DT UNIQUE (WEEK_START_DT),\n    CONSTRAINT FK_DIM_WEEK_MONTH_KY FOREIGN KEY (MONTH_KY) REFERENCES MODULE2_ETL.GOLD.DIM_MONTH (MONTH_KY)\n)\nCOMMENT = 'Date hierarchy dimension. All attributes SCD Type 1, single row per business key.';\n\n-- DIM_DAY\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_DAY (\n    DAY_KY                    INT AUTOINCREMENT START 1 INCREMENT 1 ORDER NOT NULL,\n    DAY_ID                    INT NOT NULL,\n    CALENDAR_DT               DATE,\n    DAY_OF_WEEK_NUMBER        NUMBER(1,0),\n    DAY_OF_MONTH_NUMBER       NUMBER(2,0),\n    WEEKEND_FLG               BOOLEAN,\n    WEEK_KY                   INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_DAY PRIMARY KEY (DAY_KY),\n    CONSTRAINT UQ_DIM_DAY_DAY_ID UNIQUE (DAY_ID),\n    CONSTRAINT UQ_DIM_DAY_CALENDAR_DT UNIQUE (CALENDAR_DT),\n    CONSTRAINT FK_DIM_DAY_WEEK_KY FOREIGN KEY (WEEK_KY) REFERENCES MODULE2_ETL.GOLD.DIM_WEEK (WEEK_KY)\n)\nCOMMENT = 'Date hierarchy dimension. All attributes SCD Type 1, single row per business key.';\n\n-- DIM_COMPANY\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_COMPANY (\n    COMPANY_KY                INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    COMPANY_ID                INT NOT NULL,\n    COMPANY_NAME              VARCHAR,\n    COMPANY_TYPE              VARCHAR,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_COMPANY PRIMARY KEY (COMPANY_KY),\n    CONSTRAINT UQ_DIM_COMPANY_COMPANY_ID UNIQUE (COMPANY_ID, EFF_FROM_DATE)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: COMPANY_NAME. SCD1 attrs: COMPANY_TYPE.';\n\n-- DIM_DEPARTMENT\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_DEPARTMENT (\n    DEPARTMENT_KY             INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    DEPARTMENT_ID             INT NOT NULL,\n    DEPARTMENT_NAME           VARCHAR,\n    DEPARTMENT_MANAGER_NAME   VARCHAR,\n    COMPANY_KY                INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_DEPARTMENT PRIMARY KEY (DEPARTMENT_KY),\n    CONSTRAINT UQ_DIM_DEPARTMENT_DEPARTMENT_ID UNIQUE (DEPARTMENT_ID, EFF_FROM_DATE),\n    CONSTRAINT FK_DIM_DEPARTMENT_COMPANY_KY FOREIGN KEY (COMPANY_KY) REFERENCES MODULE2_ETL.GOLD.DIM_COMPANY (COMPANY_KY)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: DEPARTMENT_NAME. SCD1 attrs: DEPARTMENT_MANAGER_NAME.';\n\n-- DIM_CLASS\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_CLASS (\n    CLASS_KY                  INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    CLASS_ID                  INT NOT NULL,\n    CLASS_NAME                VARCHAR,\n    CLASS_DESCRIPTION         VARCHAR,\n    DEPARTMENT_KY             INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_CLASS PRIMARY KEY (CLASS_KY),\n    CONSTRAINT UQ_DIM_CLASS_CLASS_ID UNIQUE (CLASS_ID, EFF_FROM_DATE),\n    CONSTRAINT FK_DIM_CLASS_DEPARTMENT_KY FOREIGN KEY (DEPARTMENT_KY) REFERENCES MODULE2_ETL.GOLD.DIM_DEPARTMENT (DEPARTMENT_KY)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: CLASS_NAME. SCD1 attrs: CLASS_DESCRIPTION.';\n\n-- DIM_ITEM\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_ITEM (\n    ITEM_KY                   INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    ITEM_ID                   INT NOT NULL,\n    ITEM_NAME                 VARCHAR,\n    COLOR                     VARCHAR,\n    SIZE                      VARCHAR,\n    CLASS_KY                  INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_ITEM PRIMARY KEY (ITEM_KY),\n    CONSTRAINT UQ_DIM_ITEM_ITEM_ID UNIQUE (ITEM_ID, EFF_FROM_DATE),\n    CONSTRAINT FK_DIM_ITEM_CLASS_KY FOREIGN KEY (CLASS_KY) REFERENCES MODULE2_ETL.GOLD.DIM_CLASS (CLASS_KY)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: ITEM_NAME, COLOR, SIZE. SCD1 attrs: none.';\n\n-- DIM_STATE\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_STATE (\n    STATE_KY                  INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    STATE_ID                  INT NOT NULL,\n    STATE_NAME                VARCHAR,\n    STATE_CODE                VARCHAR,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_STATE PRIMARY KEY (STATE_KY),\n    CONSTRAINT UQ_DIM_STATE_STATE_ID UNIQUE (STATE_ID, EFF_FROM_DATE)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: STATE_CODE. SCD1 attrs: STATE_NAME.';\n\n-- DIM_DISTRICT\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_DISTRICT (\n    DISTRICT_KY               INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    DISTRICT_ID               INT NOT NULL,\n    DISTRICT_NAME             VARCHAR,\n    DISTRICT_CODE             VARCHAR,\n    STATE_KY                  INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_DISTRICT PRIMARY KEY (DISTRICT_KY),\n    CONSTRAINT UQ_DIM_DISTRICT_DISTRICT_ID UNIQUE (DISTRICT_ID, EFF_FROM_DATE),\n    CONSTRAINT FK_DIM_DISTRICT_STATE_KY FOREIGN KEY (STATE_KY) REFERENCES MODULE2_ETL.GOLD.DIM_STATE (STATE_KY)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: DISTRICT_CODE. SCD1 attrs: DISTRICT_NAME.';\n\n-- DIM_LOCATION\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_LOCATION (\n    LOCATION_KY               INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    LOCATION_ID               INT NOT NULL,\n    LOCATION_NAME             VARCHAR,\n    ADDRESS_LINE              VARCHAR,\n    DISTRICT_KY               INT NOT NULL,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_LOCATION PRIMARY KEY (LOCATION_KY),\n    CONSTRAINT UQ_DIM_LOCATION_LOCATION_ID UNIQUE (LOCATION_ID, EFF_FROM_DATE),\n    CONSTRAINT FK_DIM_LOCATION_DISTRICT_KY FOREIGN KEY (DISTRICT_KY) REFERENCES MODULE2_ETL.GOLD.DIM_DISTRICT (DISTRICT_KY)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: LOCATION_NAME. SCD1 attrs: ADDRESS_LINE.';\n\n-- DIM_CUSTOMER\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.DIM_CUSTOMER (\n    CUSTOMER_KY               INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    CUSTOMER_ID               INT NOT NULL,\n    CUSTOMER_NAME             VARCHAR,\n    CUSTOMER_EMAIL            VARCHAR,\n    CUSTOMER_PHONE            VARCHAR,\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE NOT NULL,\n    EFF_TO_DATE               DATE NOT NULL DEFAULT DATE '9999-12-31',\n    CURR_FLG                  BOOLEAN NOT NULL DEFAULT TRUE,\n    CONSTRAINT PK_DIM_CUSTOMER PRIMARY KEY (CUSTOMER_KY),\n    CONSTRAINT UQ_DIM_CUSTOMER_CUSTOMER_ID UNIQUE (CUSTOMER_ID, EFF_FROM_DATE)\n)\nCOMMENT = 'SCD Type 1+2 hybrid. SCD2 attrs: CUSTOMER_PHONE. SCD1 attrs: CUSTOMER_NAME, CUSTOMER_EMAIL.';\n\n-- FCT_SALES\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.FCT_SALES (\n    SALES_KY                  INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    DAY_KY                    INT NOT NULL,\n    ITEM_KY                   INT NOT NULL,\n    LOCATION_KY               INT NOT NULL,\n    CUSTOMER_KY               INT NOT NULL,\n    TRANSACTION_ID            INT,\n    TRANSACTION_LINE_NUMBER   INT,\n    SLS_QTY                   NUMBER(18,4),\n    SLS_AMT                   NUMBER(18,2),\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    CONSTRAINT PK_FCT_SALES PRIMARY KEY (SALES_KY),\n    CONSTRAINT UQ_FCT_SALES_GRAIN UNIQUE (TRANSACTION_ID, TRANSACTION_LINE_NUMBER),\n    CONSTRAINT FK_FCT_SALES_DAY_KY FOREIGN KEY (DAY_KY) REFERENCES MODULE2_ETL.GOLD.DIM_DAY (DAY_KY),\n    CONSTRAINT FK_FCT_SALES_ITEM_KY FOREIGN KEY (ITEM_KY) REFERENCES MODULE2_ETL.GOLD.DIM_ITEM (ITEM_KY),\n    CONSTRAINT FK_FCT_SALES_LOCATION_KY FOREIGN KEY (LOCATION_KY) REFERENCES MODULE2_ETL.GOLD.DIM_LOCATION (LOCATION_KY),\n    CONSTRAINT FK_FCT_SALES_CUSTOMER_KY FOREIGN KEY (CUSTOMER_KY) REFERENCES MODULE2_ETL.GOLD.DIM_CUSTOMER (CUSTOMER_KY)\n)\nCOMMENT = 'Transactional fact. Grain: day/item/location/customer; carries TRANSACTION_ID + TRANSACTION_LINE_NUMBER.';\n\n-- FCT_PRICE\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.FCT_PRICE (\n    PRICE_KY                  INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    DAY_KY                    INT NOT NULL,\n    ITEM_KY                   INT NOT NULL,\n    LOCATION_KY               INT NOT NULL,\n    UNIT_PRICE_AMT            NUMBER(18,4),\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE,\n    EFF_TO_DATE               DATE,\n    CONSTRAINT PK_FCT_PRICE PRIMARY KEY (PRICE_KY),\n    CONSTRAINT UQ_FCT_PRICE_GRAIN UNIQUE (DAY_KY, ITEM_KY, LOCATION_KY),\n    CONSTRAINT FK_FCT_PRICE_DAY_KY FOREIGN KEY (DAY_KY) REFERENCES MODULE2_ETL.GOLD.DIM_DAY (DAY_KY),\n    CONSTRAINT FK_FCT_PRICE_ITEM_KY FOREIGN KEY (ITEM_KY) REFERENCES MODULE2_ETL.GOLD.DIM_ITEM (ITEM_KY),\n    CONSTRAINT FK_FCT_PRICE_LOCATION_KY FOREIGN KEY (LOCATION_KY) REFERENCES MODULE2_ETL.GOLD.DIM_LOCATION (LOCATION_KY)\n)\nCOMMENT = 'Positional fact. Grain: day/item/location.';\n\n-- FCT_INVENTORY\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.FCT_INVENTORY (\n    INVENTORY_KY              INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    DAY_KY                    INT NOT NULL,\n    ITEM_KY                   INT NOT NULL,\n    LOCATION_KY               INT NOT NULL,\n    STOCK_ON_HAND             NUMBER(18,4),\n    IN_TRANSIT                NUMBER(18,4),\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    EFF_FROM_DATE             DATE,\n    EFF_TO_DATE               DATE,\n    CONSTRAINT PK_FCT_INVENTORY PRIMARY KEY (INVENTORY_KY),\n    CONSTRAINT UQ_FCT_INVENTORY_GRAIN UNIQUE (DAY_KY, ITEM_KY, LOCATION_KY),\n    CONSTRAINT FK_FCT_INVENTORY_DAY_KY FOREIGN KEY (DAY_KY) REFERENCES MODULE2_ETL.GOLD.DIM_DAY (DAY_KY),\n    CONSTRAINT FK_FCT_INVENTORY_ITEM_KY FOREIGN KEY (ITEM_KY) REFERENCES MODULE2_ETL.GOLD.DIM_ITEM (ITEM_KY),\n    CONSTRAINT FK_FCT_INVENTORY_LOCATION_KY FOREIGN KEY (LOCATION_KY) REFERENCES MODULE2_ETL.GOLD.DIM_LOCATION (LOCATION_KY)\n)\nCOMMENT = 'Positional fact. Grain: day/item/location.';\n\n-- FCT_SALES_PER_WEEK\nCREATE TABLE IF NOT EXISTS MODULE2_ETL.GOLD.FCT_SALES_PER_WEEK (\n    SALES_WEEK_KY             INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    WEEK_KY                   INT NOT NULL,\n    ITEM_KY                   INT NOT NULL,\n    LOCATION_KY               INT NOT NULL,\n    SLS_QTY                   NUMBER(18,4),\n    SLS_AMT                   NUMBER(18,2),\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  DATE,\n    CONSTRAINT PK_FCT_SALES_PER_WEEK PRIMARY KEY (SALES_WEEK_KY),\n    CONSTRAINT UQ_FCT_SALES_PER_WEEK_GRAIN UNIQUE (WEEK_KY, ITEM_KY, LOCATION_KY),\n    CONSTRAINT FK_FCT_SALES_PER_WEEK_WEEK_KY FOREIGN KEY (WEEK_KY) REFERENCES MODULE2_ETL.GOLD.DIM_WEEK (WEEK_KY),\n    CONSTRAINT FK_FCT_SALES_PER_WEEK_ITEM_KY FOREIGN KEY (ITEM_KY) REFERENCES MODULE2_ETL.GOLD.DIM_ITEM (ITEM_KY),\n    CONSTRAINT FK_FCT_SALES_PER_WEEK_LOCATION_KY FOREIGN KEY (LOCATION_KY) REFERENCES MODULE2_ETL.GOLD.DIM_LOCATION (LOCATION_KY)\n)\nCOMMENT = 'Aggregate fact. Grain: week/item/location. Derived from FCT_SALES rolled up to DIM_WEEK.';\n\n-- ======================================================================\n-- DATE SEED (insert-only, individually idempotent MERGE statements)\n-- BATCH_ID is DATE — seed writes CURRENT_DATE().\n-- Order matters: YEAR -> QUARTER -> MONTH -> WEEK -> DAY (each joins parent _KY).\n-- ======================================================================\n\n-- DIM_YEAR\nMERGE INTO MODULE2_ETL.GOLD.DIM_YEAR t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT YEAR(y) AS YEAR_ID,\n               YEAR(y) AS CALENDAR_YEAR,\n               ((YEAR(y) % 4 = 0 AND YEAR(y) % 100 <> 0) OR YEAR(y) % 400 = 0) AS LEAP_YEAR_FLG,\n               'FY' || TO_VARCHAR(YEAR(y)) AS FISCAL_YEAR_LABEL\n        FROM yr\n        ORDER BY y\n      ) s\n   ON t.YEAR_ID = s.YEAR_ID\nWHEN NOT MATCHED THEN INSERT (YEAR_ID, CALENDAR_YEAR, LEAP_YEAR_FLG, FISCAL_YEAR_LABEL, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.YEAR_ID, s.CALENDAR_YEAR, s.LEAP_YEAR_FLG, s.FISCAL_YEAR_LABEL, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);\n\n-- DIM_QUARTER\nMERGE INTO MODULE2_ETL.GOLD.DIM_QUARTER t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT YEAR(q) * 10 + QUARTER(q) AS QUARTER_ID,\n               QUARTER(q) AS QUARTER_NUMBER,\n               'Q' || TO_VARCHAR(QUARTER(q)) || ' ' || TO_VARCHAR(YEAR(q)) AS QUARTER_NAME,\n               py.YEAR_KY\n        FROM qtr\n        JOIN MODULE2_ETL.GOLD.DIM_YEAR py ON py.YEAR_ID = YEAR(q) AND py.CURR_FLG = TRUE\n        ORDER BY q\n      ) s\n   ON t.QUARTER_ID = s.QUARTER_ID\nWHEN NOT MATCHED THEN INSERT (QUARTER_ID, QUARTER_NUMBER, QUARTER_NAME, YEAR_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.QUARTER_ID, s.QUARTER_NUMBER, s.QUARTER_NAME, s.YEAR_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);\n\n-- DIM_MONTH\nMERGE INTO MODULE2_ETL.GOLD.DIM_MONTH t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT YEAR(m) * 100 + MONTH(m) AS MONTH_ID,\n               DECODE(MONTH(m), 1,'January',2,'February',3,'March',4,'April',5,'May',6,'June',7,'July',8,'August',9,'September',10,'October',11,'November',12,'December') AS MONTH_NAME,\n               MONTH(m) AS MONTH_NUMBER,\n               DAY(LAST_DAY(m)) AS DAYS_IN_MONTH_NUMBER,\n               pq.QUARTER_KY\n        FROM mth\n        JOIN MODULE2_ETL.GOLD.DIM_QUARTER pq ON pq.QUARTER_ID = YEAR(m) * 10 + QUARTER(m) AND pq.CURR_FLG = TRUE\n        ORDER BY m\n      ) s\n   ON t.MONTH_ID = s.MONTH_ID\nWHEN NOT MATCHED THEN INSERT (MONTH_ID, MONTH_NAME, MONTH_NUMBER, DAYS_IN_MONTH_NUMBER, QUARTER_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.MONTH_ID, s.MONTH_NAME, s.MONTH_NUMBER, s.DAYS_IN_MONTH_NUMBER, s.QUARTER_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);\n\n-- DIM_WEEK\nMERGE INTO MODULE2_ETL.GOLD.DIM_WEEK t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        ),\n        mth AS (\n            SELECT DATE_TRUNC('MONTH', dt) AS m FROM d\n            UNION\n            SELECT DATE_TRUNC('MONTH', DATEADD(DAY, 3, wstart)) FROM wk\n        ),\n        qtr AS (SELECT DISTINCT DATE_TRUNC('QUARTER', m) AS q FROM mth),\n        yr  AS (SELECT DISTINCT DATE_TRUNC('YEAR', q)    AS y FROM qtr)\n        SELECT wy * 100 + wn AS WEEK_ID,\n               wstart AS WEEK_START_DT,\n               DATEADD(DAY, 6, wstart) AS WEEK_END_DT,\n               wn AS WEEK_OF_YEAR_NUMBER,\n               pm.MONTH_KY\n        FROM wk\n        JOIN MODULE2_ETL.GOLD.DIM_MONTH pm\n          ON pm.MONTH_ID = YEAR(DATEADD(DAY, 3, wstart)) * 100 + MONTH(DATEADD(DAY, 3, wstart))\n         AND pm.CURR_FLG = TRUE\n        ORDER BY wstart\n      ) s\n   ON t.WEEK_ID = s.WEEK_ID\nWHEN NOT MATCHED THEN INSERT (WEEK_ID, WEEK_START_DT, WEEK_END_DT, WEEK_OF_YEAR_NUMBER, MONTH_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.WEEK_ID, s.WEEK_START_DT, s.WEEK_END_DT, s.WEEK_OF_YEAR_NUMBER, s.MONTH_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);\n\n-- DIM_DAY\nMERGE INTO MODULE2_ETL.GOLD.DIM_DAY t\nUSING (\n        WITH n AS (\n            SELECT ROW_NUMBER() OVER (ORDER BY SEQ4()) - 1 AS i\n            FROM TABLE(GENERATOR(ROWCOUNT => 20000))\n        ),\n        d AS (\n            SELECT DATEADD(DAY, i, TO_DATE('2026-01-01')) AS dt\n            FROM n\n            WHERE DATEADD(DAY, i, TO_DATE('2026-01-01')) <= TO_DATE('2035-12-31')\n        ),\n        wk AS (\n            SELECT YEAROFWEEKISO(dt) AS wy,\n                   WEEKISO(dt)       AS wn,\n                   MIN(DATEADD(DAY, 1 - DAYOFWEEKISO(dt), dt)) AS wstart\n            FROM d\n            GROUP BY YEAROFWEEKISO(dt), WEEKISO(dt)\n        )\n        SELECT YEAR(dt) * 10000 + MONTH(dt) * 100 + DAY(dt) AS DAY_ID,\n               dt AS CALENDAR_DT,\n               DAYOFWEEKISO(dt) AS DAY_OF_WEEK_NUMBER,\n               DAY(dt) AS DAY_OF_MONTH_NUMBER,\n               (DAYOFWEEKISO(dt) >= 6) AS WEEKEND_FLG,\n               pw.WEEK_KY\n        FROM d\n        JOIN MODULE2_ETL.GOLD.DIM_WEEK pw\n          ON pw.WEEK_ID = YEAROFWEEKISO(dt) * 100 + WEEKISO(dt)\n         AND pw.CURR_FLG = TRUE\n        ORDER BY dt\n      ) s\n   ON t.DAY_ID = s.DAY_ID\nWHEN NOT MATCHED THEN INSERT (DAY_ID, CALENDAR_DT, DAY_OF_WEEK_NUMBER, DAY_OF_MONTH_NUMBER, WEEKEND_FLG, WEEK_KY, REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID, EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG)\nVALUES (s.DAY_ID, s.CALENDAR_DT, s.DAY_OF_WEEK_NUMBER, s.DAY_OF_MONTH_NUMBER, s.WEEKEND_FLG, s.WEEK_KY, CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'DATE_SEED', CURRENT_DATE(), DATE '1900-01-01', DATE '9999-12-31', TRUE);","task_id":"run_gold_ddl","try_number":1,"run_id":"backfill__2026-11-17T00:00:00+00:00","dag_id":"my_etl_dag","map_index":-1,"ti_id":"01a1f79d-e28a-7d36-a860-a138111625a5","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
