{"timestamp":"2026-11-20T09:57:57.459834Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for classes whose name (or parent)\n--     changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_CLASS (\n    CLASS_ID,\n    CLASS_NAME, CLASS_DESCRIPTION, DEPARTMENT_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.CLASS_ID,\n    src.CLASS_NAME,\n    src.CLASS_DESCRIPTION,\n    src.DEPARTMENT_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-17',\n    DATE '2026-11-17',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_CLASS_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_CLASS tgt\n    WHERE tgt.CLASS_ID = src.CLASS_ID\n      AND tgt.CURR_FLG = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-17')\n      AND tgt.BATCH_ID = DATE '2026-11-17'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_CLASS tgt\n    WHERE tgt.CLASS_ID = src.CLASS_ID\n      AND tgt.CURR_FLG = TRUE\n);, parameters: None","dag_id":"my_etl_dag","map_index":0,"try_number":1,"ti_id":"01a1f85d-8a21-7739-921a-54308893e019","task_id":"gold_load_dim_phase3","run_id":"backfill__2026-11-17T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
