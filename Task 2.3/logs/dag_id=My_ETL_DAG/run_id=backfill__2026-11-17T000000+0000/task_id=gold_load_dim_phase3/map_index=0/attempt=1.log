{"timestamp":"2026-11-20T07:21:07.871992Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New classes — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_CLASS (\n    CLASS_ID,\n    CLASS_NAME, CLASS_DESCRIPTION, DEPARTMENT_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.CLASS_ID,\n    src.CLASS_NAME,\n    src.CLASS_DESCRIPTION,\n    src.DEPARTMENT_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-17',\n    DATE '2026-11-17',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_CLASS_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_CLASS tgt\n    WHERE tgt.CLASS_ID = src.CLASS_ID\n);, parameters: None","map_index":0,"ti_id":"01a1f7ce-38db-7895-ac7b-fec6cf0f33d3","try_number":1,"run_id":"backfill__2026-11-17T00:00:00+00:00","task_id":"gold_load_dim_phase3","dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
