{"timestamp":"2026-11-20T07:21:06.881516Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for locations whose name (or parent)\n--     changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_LOCATION (\n    LOCATION_ID,\n    LOCATION_NAME, ADDRESS_LINE, DISTRICT_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.LOCATION_ID,\n    src.LOCATION_NAME,\n    src.ADDRESS_LINE,\n    src.DISTRICT_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_STORE_MASTER',\n    DATE '2026-11-17',\n    DATE '2026-11-17',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_LOCATION_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_LOCATION tgt\n    WHERE tgt.LOCATION_ID = src.LOCATION_ID\n      AND tgt.CURR_FLG    = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-17')\n      AND tgt.BATCH_ID    = DATE '2026-11-17'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_LOCATION tgt\n    WHERE tgt.LOCATION_ID = src.LOCATION_ID\n      AND tgt.CURR_FLG    = TRUE\n);, parameters: None","task_id":"gold_load_dim_phase3","run_id":"backfill__2026-11-17T00:00:00+00:00","dag_id":"my_etl_dag","try_number":1,"map_index":1,"ti_id":"01a1f7ce-38dc-7064-b582-435bc4a7b49b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
