{"timestamp":"2026-11-20T07:21:06.632865Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose LOCATION_NAME (or parent) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_LOCATION tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-17'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-17'\nFROM TMP_DIM_LOCATION_SRC src\nWHERE tgt.LOCATION_ID = src.LOCATION_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND (\n        COALESCE(tgt.LOCATION_NAME, '') <> COALESCE(src.LOCATION_NAME, '')\n     OR tgt.DISTRICT_KY <> src.DISTRICT_KY\n  );, parameters: None","task_id":"gold_load_dim_phase3","run_id":"backfill__2026-11-17T00:00:00+00:00","dag_id":"my_etl_dag","try_number":1,"map_index":1,"ti_id":"01a1f7ce-38dc-7064-b582-435bc4a7b49b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
