{"timestamp":"2026-11-20T07:21:06.194396Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_LOCATION\n-- Source : silver.TMP_STORE_MASTER\n-- Parent : DIM_DISTRICT (DISTRICT_KY via DISTRICT_ID, CURR_FLG = TRUE)\n-- SCD    : LOCATION_NAME -> SCD2\n--          ADDRESS_LINE  -> SCD1\n-- Dedup  : one row per LOCATION_ID from today's batch\n-- KY     : LOCATION_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent DISTRICT_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_LOCATION_SRC AS\nWITH ranked AS (\n    SELECT\n        s.LOCATION_ID,\n        s.LOCATION_NAME,\n        s.ADDRESS_LINE,\n        s.DISTRICT_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.LOCATION_ID\n            ORDER BY s._LOAD_TS DESC, s.LOCATION_ID DESC\n        ) AS RN\n    FROM silver.TMP_STORE_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-17'\n      AND s.LOCATION_ID IS NOT NULL\n)\nSELECT\n    r.LOCATION_ID,\n    r.LOCATION_NAME,\n    r.ADDRESS_LINE,\n    d.DISTRICT_KY\nFROM ranked r\nJOIN gold.DIM_DISTRICT d\n  ON d.DISTRICT_ID = r.DISTRICT_ID\n AND d.CURR_FLG    = TRUE\nWHERE r.RN = 1;, parameters: None","task_id":"gold_load_dim_phase3","run_id":"backfill__2026-11-17T00:00:00+00:00","dag_id":"my_etl_dag","try_number":1,"map_index":1,"ti_id":"01a1f7ce-38dc-7064-b582-435bc4a7b49b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
