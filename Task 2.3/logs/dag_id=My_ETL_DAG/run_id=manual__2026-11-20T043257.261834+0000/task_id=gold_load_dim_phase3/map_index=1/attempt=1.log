{"timestamp":"2026-11-20T04:34:45.793080Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New locations — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_LOCATION (\n    LOCATION_ID,\n    LOCATION_NAME, ADDRESS_LINE, DISTRICT_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.LOCATION_ID,\n    src.LOCATION_NAME,\n    src.ADDRESS_LINE,\n    src.DISTRICT_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_STORE_MASTER',\n    DATE '2026-11-20',\n    DATE '2026-11-20',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_LOCATION_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_LOCATION tgt\n    WHERE tgt.LOCATION_ID = src.LOCATION_ID\n);, parameters: None","try_number":1,"run_id":"manual__2026-11-20T04:32:57.261834+00:00","task_id":"gold_load_dim_phase3","dag_id":"my_etl_dag","map_index":1,"ti_id":"01a1f73a-a1eb-7f6d-94ae-cfb9f099775c","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
