{"timestamp":"2026-11-20T04:34:38.707627Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New districts — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_DISTRICT (\n    DISTRICT_ID,\n    DISTRICT_NAME, DISTRICT_CODE, STATE_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.DISTRICT_ID,\n    src.DISTRICT_NAME,\n    src.DISTRICT_CODE,\n    src.STATE_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_STORE_MASTER',\n    DATE '2026-11-20',\n    DATE '2026-11-20',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_DISTRICT_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_DISTRICT tgt\n    WHERE tgt.DISTRICT_ID = src.DISTRICT_ID\n);, parameters: None","task_id":"gold_load_dim_phase2","ti_id":"01a1f73a-a1e9-7dba-b86e-cd6ba212a0db","run_id":"manual__2026-11-20T04:32:57.261834+00:00","try_number":1,"map_index":1,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
