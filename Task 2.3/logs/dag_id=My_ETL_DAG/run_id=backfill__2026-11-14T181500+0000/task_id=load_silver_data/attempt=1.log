{"timestamp":"2026-11-19T10:18:51.590586Z","level":"info","event":"Running statement: -- 5.5 Duplicate business key\n-- Business key: ITEM_ID, LOCATION_ID, EFF_FROM_DATE\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-14', 'TMP_PRICE_MASTER',\n       'DUP_BUSINESS_KEY',\n       '(ITEM_ID, LOCATION_ID, EFF_FROM_DATE) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nJOIN (\n    SELECT\n        ITEM_ID,\n        LOCATION_ID,\n        EFF_FROM_DATE\n    FROM bronze.STG_PRICE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-14'\n    GROUP BY ITEM_ID, LOCATION_ID, EFF_FROM_DATE\n    HAVING COUNT(*) > 1\n) d\n    ON d.ITEM_ID = s.ITEM_ID\n   AND d.LOCATION_ID = s.LOCATION_ID\n   AND d.EFF_FROM_DATE = s.EFF_FROM_DATE\nWHERE s.BATCH_ID = DATE '2026-11-14';, parameters: None","try_number":1,"dag_id":"my_etl_dag","map_index":-1,"run_id":"backfill__2026-11-14T18:15:00+00:00","ti_id":"01a1f34f-a0c3-7657-8992-21fb498c73f3","task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
