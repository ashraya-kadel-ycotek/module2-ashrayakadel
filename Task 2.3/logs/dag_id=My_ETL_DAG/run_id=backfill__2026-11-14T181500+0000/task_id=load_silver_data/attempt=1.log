{"timestamp":"2026-11-19T10:18:46.268946Z","level":"info","event":"Running statement: -- ============================================================================\n-- 4. TMP_POS_SALES   (key: TRANSACTION_ID, TRANSACTION_LINE_NUMBER)\n-- ============================================================================\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-14', 'TMP_POS_SALES',\n       'TYPE_CAST_FAILURE',\n       'TRANSACTION_LINE_NUMBER / SALES_DT / SLS_QTY / SLS_AMT failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-14'\n  AND ( TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER) IS NULL\n     OR TRY_TO_DATE  (s.SALES_DT,'YYYY-MM-DD')   IS NULL\n     OR TRY_TO_NUMBER(s.SLS_QTY)                 IS NULL\n     OR TRY_TO_NUMBER(s.SLS_AMT)                 IS NULL );, parameters: None","try_number":1,"dag_id":"my_etl_dag","map_index":-1,"run_id":"backfill__2026-11-14T18:15:00+00:00","ti_id":"01a1f34f-a0c3-7657-8992-21fb498c73f3","task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
