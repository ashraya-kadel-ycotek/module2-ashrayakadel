{"timestamp":"2026-11-19T10:18:49.941576Z","level":"info","event":"Running statement: -- ============================================================================\n-- 5. TMP_PRICE_MASTER\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID, EFF_FROM_DATE)\n-- ============================================================================\n\n-- 5.1 Type-cast failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-14', 'TMP_PRICE_MASTER',\n       'TYPE_CAST_FAILURE',\n       'PRICE_DT / UNIT_PRICE_AMT / EFF_FROM_DATE / EFF_TO_DATE failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-14'\n  AND (\n       TRY_TO_DATE(s.PRICE_DT, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_NUMBER(s.UNIT_PRICE_AMT) IS NULL\n    OR TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') IS NULL\n  );, parameters: None","try_number":1,"dag_id":"my_etl_dag","map_index":-1,"run_id":"backfill__2026-11-14T18:15:00+00:00","ti_id":"01a1f34f-a0c3-7657-8992-21fb498c73f3","task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
