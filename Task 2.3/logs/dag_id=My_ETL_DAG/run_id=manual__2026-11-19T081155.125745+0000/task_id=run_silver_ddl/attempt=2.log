{"timestamp":"2026-11-19T08:26:21.851485Z","level":"info","event":"Running statement: -- ============================================================\n-- SILVER.TMP_POS_SALES\n-- Grain: 1 row per (TRANSACTION_ID, TRANSACTION_LINE_NUMBER)\n-- NOTE: referential integrity (ITEM_ID, LOCATION_ID) is\n--       checked in Load SQL, not via DB constraints.\n-- ============================================================\nCREATE TABLE IF NOT EXISTS silver.TMP_POS_SALES (\n    -- business columns\n    TRANSACTION_ID              VARCHAR(20)     NOT NULL,\n    TRANSACTION_LINE_NUMBER     NUMBER(38,0)    NOT NULL,\n    SALES_DT                    DATE            NOT NULL,\n    ITEM_ID                     VARCHAR(20)     NOT NULL,\n    LOCATION_ID                 VARCHAR(20)     NOT NULL,\n    CUSTOMER_ID                 VARCHAR(20)     NOT NULL,\n    CUSTOMER_NAME               VARCHAR(255)    NOT NULL,\n    CUSTOMER_EMAIL              VARCHAR(255)    NOT NULL,\n    CUSTOMER_PHONE              VARCHAR(30)     NOT NULL,\n    SLS_QTY                     NUMBER(38,0)    NOT NULL,\n    SLS_AMT                     NUMBER(18,2)    NOT NULL,\n\n    -- silver audit columns\n    _SRC_FILE_NM                VARCHAR(255)    NOT NULL,\n    _BATCH_ID                   DATE            NOT NULL,\n    _LOAD_TS                    TIMESTAMP_NTZ(9) NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n\n    CONSTRAINT PK_TMP_POS_SALES\n        PRIMARY KEY (TRANSACTION_ID, TRANSACTION_LINE_NUMBER),\n    CONSTRAINT CK_TMP_POS_SLS_QTY\n        CHECK (SLS_QTY >= 0),\n    CONSTRAINT CK_TMP_POS_SLS_AMT\n        CHECK (SLS_AMT >= 0)\n)\nCOMMENT = 'Silver staging: validated POS sales lines';, parameters: None","dag_id":"my_etl_dag","task_id":"run_silver_ddl","try_number":2,"ti_id":"01a1f2e9-df27-7463-81f1-9eec7b07edcf","map_index":-1,"run_id":"manual__2026-11-19T08:11:55.125745+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
