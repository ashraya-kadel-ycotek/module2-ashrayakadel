{"timestamp":"2026-11-19T08:18:09.104800Z","level":"info","event":"Running statement: -- ============================================================\n-- SILVER.TMP_PRICE_MASTER\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID, EFF_FROM_DATE)\n-- NOTE: effective-date range overlap is enforced in Load SQL,\n--       not in DDL. A changed EFF_FROM_DATE is a legitimate\n--       new version and becomes SCD2 in the Gold layer.\n--       Referential integrity is also checked in Load SQL.\n-- ============================================================\nCREATE TABLE IF NOT EXISTS silver.TMP_PRICE_MASTER (\n    -- business columns\n    PRICE_DT            DATE            NOT NULL,\n    ITEM_ID             VARCHAR(20)     NOT NULL,\n    LOCATION_ID         VARCHAR(20)     NOT NULL,\n    UNIT_PRICE_AMT      NUMBER(18,2)    NOT NULL,\n    EFF_FROM_DATE       DATE            NOT NULL,\n    EFF_TO_DATE         DATE            NOT NULL,\n\n    -- silver audit columns\n    _SRC_FILE_NM        VARCHAR(255)    NOT NULL,\n    _BATCH_ID           DATE            NOT NULL,\n    _LOAD_TS            TIMESTAMP_NTZ(9) NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n\n    CONSTRAINT PK_TMP_PRICE_MASTER\n        PRIMARY KEY (ITEM_ID, LOCATION_ID, EFF_FROM_DATE),\n    CONSTRAINT CK_TMP_PRICE_UNIT_PRICE_AMT\n        CHECK (UNIT_PRICE_AMT >= 0),\n    CONSTRAINT CK_TMP_PRICE_EFF_DATES\n        CHECK (EFF_TO_DATE >= EFF_FROM_DATE)\n)\nCOMMENT = 'Silver staging: validated price master (SCD2 source for Gold)';, parameters: None","ti_id":"01a1f2e2-21df-7106-ada1-755026cf7a5f","map_index":-1,"run_id":"manual__2026-11-19T08:11:55.125745+00:00","task_id":"run_silver_ddl","dag_id":"my_etl_dag","try_number":1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
