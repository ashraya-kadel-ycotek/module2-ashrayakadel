{"timestamp":"2026-11-20T04:38:41.156681Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but ADDRESS_LINE changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_LOCATION tgt\nSET\n    ADDRESS_LINE = src.ADDRESS_LINE,\n    REC_UPDT_TS  = CURRENT_TIMESTAMP(),\n    BATCH_ID     = DATE '2026-11-15'\nFROM TMP_DIM_LOCATION_SRC src\nWHERE tgt.LOCATION_ID = src.LOCATION_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.LOCATION_NAME, '') = COALESCE(src.LOCATION_NAME, '')\n  AND tgt.DISTRICT_KY = src.DISTRICT_KY\n  AND COALESCE(tgt.ADDRESS_LINE, '') <> COALESCE(src.ADDRESS_LINE, '');, parameters: None","task_id":"gold_load_dim_phase3","dag_id":"my_etl_dag","ti_id":"01a1f73e-e1b0-7efb-ac68-9ff796c1f2ae","map_index":1,"try_number":1,"run_id":"scheduled__2026-11-15T18:15:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
