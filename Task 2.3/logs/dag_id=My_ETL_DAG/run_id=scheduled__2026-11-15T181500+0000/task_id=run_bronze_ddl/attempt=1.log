{"timestamp":"2026-11-18T11:18:25.193685Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\n\nUSE DATABASE MODULE2_ETL;\nCREATE SCHEMA IF NOT EXISTS bronze;\nUSE SCHEMA bronze;\n\n-- ============================================================\n-- BRONZE.STG_STORE_MASTER\n-- Source: store_master_YYYYMMDD.csv\n-- Grain: 1 row per LOCATION_ID per source file\n-- ============================================================\nCREATE TABLE IF NOT EXISTS BRONZE.STG_STORE_MASTER (\n    -- business columns\n    LOCATION_ID         VARCHAR(20),\n    LOCATION_NAME       VARCHAR(255),\n    ADDRESS_LINE        VARCHAR(500),\n    DISTRICT_ID         VARCHAR(20),\n    DISTRICT_NAME       VARCHAR(100),\n    DISTRICT_CODE       VARCHAR(10),\n    STATE_ID            VARCHAR(20),\n    STATE_NAME          VARCHAR(100),\n    STATE_CODE          VARCHAR(10),\n\n    -- bronze audit columns\n    SRC_FILE_NM         VARCHAR(255)     NOT NULL,\n    SRC_ROW_COUNT       NUMBER(38,0)      NOT NULL,\n    INGEST_TS           TIMESTAMP_NTZ(9)  NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    BATCH_ID            DATE              NOT NULL,\n\n    CONSTRAINT PK_STG_STORE_MASTER\n        PRIMARY KEY (BATCH_ID, SRC_FILE_NM, LOCATION_ID) RELY\n)\nCOMMENT = 'Staging: raw store master, append-only, 30-day retention'\nCLUSTER BY (INGEST_TS)\nDATA_RETENTION_TIME_IN_DAYS = 30;\n\n-- ============================================================\n-- BRONZE.STG_ITEM_MASTER\n-- Source: item_master_YYYYMMDD.csv\n-- Grain: 1 row per ITEM_ID per source file\n-- ============================================================\nCREATE TABLE IF NOT EXISTS BRONZE.STG_ITEM_MASTER (\n    -- business columns\n    ITEM_ID                 VARCHAR(20),\n    ITEM_NAME               VARCHAR(255),\n    COLOR                   VARCHAR(50),\n    SIZE                    VARCHAR(50),\n    CLASS_ID                VARCHAR(20),\n    CLASS_NAME              VARCHAR(100),\n    CLASS_DESCRIPTION       VARCHAR(500),\n    DEPARTMENT_ID           VARCHAR(20),\n    DEPARTMENT_NAME         VARCHAR(100),\n    DEPARTMENT_MANAGER_NAME VARCHAR(255),\n    COMPANY_ID              VARCHAR(20),\n    COMPANY_NAME            VARCHAR(255),\n    COMPANY_TYPE            VARCHAR(50),\n\n    -- bronze audit columns\n    SRC_FILE_NM         VARCHAR(255)     NOT NULL,\n    SRC_ROW_COUNT       NUMBER(38,0)      NOT NULL,\n    INGEST_TS           TIMESTAMP_NTZ(9)  NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    BATCH_ID            DATE              NOT NULL,\n\n    CONSTRAINT PK_STG_ITEM_MASTER\n        PRIMARY KEY (BATCH_ID, SRC_FILE_NM, ITEM_ID) RELY\n)\nCOMMENT = 'Staging: raw item master, append-only, 30-day retention'\nCLUSTER BY (INGEST_TS)\nDATA_RETENTION_TIME_IN_DAYS = 30;\n\n-- ============================================================\n-- BRONZE.STG_INVENTORY_MASTER\n-- Source: inventory_master_YYYYMMDD.csv\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID) per source file\n-- ============================================================\nCREATE TABLE IF NOT EXISTS BRONZE.STG_INVENTORY_MASTER (\n    -- business columns (landed as STRING, cast in SILVER)\n    INVENTORY_DT        VARCHAR(10),\n    ITEM_ID             VARCHAR(20),\n    LOCATION_ID         VARCHAR(20),\n    STOCK_ON_HAND       VARCHAR(20),\n    IN_TRANSIT          VARCHAR(20),\n\n    -- bronze audit columns\n    SRC_FILE_NM         VARCHAR(255)     NOT NULL,\n    SRC_ROW_COUNT       NUMBER(38,0)      NOT NULL,\n    INGEST_TS           TIMESTAMP_NTZ(9)  NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    BATCH_ID            DATE              NOT NULL,\n\n    CONSTRAINT PK_STG_INVENTORY_MASTER\n        PRIMARY KEY (BATCH_ID, SRC_FILE_NM, ITEM_ID, LOCATION_ID) RELY\n)\nCOMMENT = 'Staging: raw inventory snapshot, append-only, 30-day retention'\nCLUSTER BY (INGEST_TS)\nDATA_RETENTION_TIME_IN_DAYS = 30;\n\n-- ============================================================\n-- BRONZE.STG_POS_SALES\n-- Source: pos_sales_YYYYMMDD.csv\n-- Grain: 1 row per (TRANSACTION_ID, TRANSACTION_LINE_NUMBER)\n-- ============================================================\nCREATE TABLE IF NOT EXISTS BRONZE.STG_POS_SALES (\n    -- business columns\n    TRANSACTION_ID              VARCHAR(20),\n    TRANSACTION_LINE_NUMBER     VARCHAR(10),\n    SALES_DT                    VARCHAR(10),\n    ITEM_ID                     VARCHAR(20),\n    LOCATION_ID                 VARCHAR(20),\n    CUSTOMER_ID                 VARCHAR(20),\n    CUSTOMER_NAME               VARCHAR(255),\n    CUSTOMER_EMAIL              VARCHAR(255),\n    CUSTOMER_PHONE              VARCHAR(30),\n    SLS_QTY                     VARCHAR(20),\n    SLS_AMT                     VARCHAR(20),\n\n    -- bronze audit columns\n    SRC_FILE_NM         VARCHAR(255)     NOT NULL,\n    SRC_ROW_COUNT       NUMBER(38,0)      NOT NULL,\n    INGEST_TS           TIMESTAMP_NTZ(9)  NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    BATCH_ID            DATE              NOT NULL,\n\n    CONSTRAINT PK_STG_POS_SALES\n        PRIMARY KEY (BATCH_ID, SRC_FILE_NM, TRANSACTION_ID, TRANSACTION_LINE_NUMBER) RELY\n)\nCOMMENT = 'Staging: raw POS sales lines, append-only, 30-day retention'\nCLUSTER BY (INGEST_TS)\nDATA_RETENTION_TIME_IN_DAYS = 30;\n\n-- ============================================================\n-- BRONZE.STG_PRICE_MASTER\n-- Source: price_master_YYYYMMDD.csv\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID) per source file\n-- ============================================================\nCREATE TABLE IF NOT EXISTS BRONZE.STG_PRICE_MASTER (\n    -- business columns\n    PRICE_DT            VARCHAR(10),\n    ITEM_ID             VARCHAR(20),\n    LOCATION_ID         VARCHAR(20),\n    UNIT_PRICE_AMT      VARCHAR(20),\n    EFF_FROM_DATE       VARCHAR(10),\n    EFF_TO_DATE         VARCHAR(10),\n\n    -- bronze audit columns\n    SRC_FILE_NM         VARCHAR(255)     NOT NULL,\n    SRC_ROW_COUNT       NUMBER(38,0)      NOT NULL,\n    INGEST_TS           TIMESTAMP_NTZ(9)  NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    BATCH_ID            DATE              NOT NULL,\n\n    CONSTRAINT PK_STG_PRICE_MASTER\n        PRIMARY KEY (BATCH_ID, SRC_FILE_NM, ITEM_ID, LOCATION_ID) RELY\n)\nCOMMENT = 'Staging: raw price master, append-only, 30-day retention'\nCLUSTER BY (INGEST_TS)\nDATA_RETENTION_TIME_IN_DAYS = 30;","ti_id":"01a1ee61-0d12-79db-99e5-09a54d9b8b99","dag_id":"my_etl_dag","map_index":-1,"run_id":"scheduled__2026-11-15T18:15:00+00:00","try_number":1,"task_id":"run_bronze_ddl","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
