{"timestamp":"2026-11-20T04:37:43.894371Z","level":"info","event":"Running statement: -- ============================================================\n-- BRONZE STAGING TABLES\n-- Purpose : land EVERY source row, no casting, no dropping.\n-- Rule    : all business columns VARCHAR. Casting happens in Silver,\n--           so cast failures become rejectable rows (AC #3) and\n--           recon ties out (AC #5).\n-- Audit   : SRC_FILE_NM, SRC_ROW_NUM (line within file), BATCH_ID.\n-- Grain   : one row per source CSV line, per batch.\n-- ============================================================\n\nCREATE TABLE IF NOT EXISTS BRONZE.STG_STORE_MASTER (\n    LOCATION_ID     VARCHAR(20),\n    LOCATION_NAME   VARCHAR(255),\n    ADDRESS_LINE    VARCHAR(500),\n    DISTRICT_ID     VARCHAR(20),\n    DISTRICT_NAME   VARCHAR(100),\n    DISTRICT_CODE   VARCHAR(10),\n    STATE_ID        VARCHAR(20),\n    STATE_NAME      VARCHAR(100),\n    STATE_CODE      VARCHAR(10),\n\n    SRC_FILE_NM     VARCHAR(255)    NOT NULL,\n    SRC_ROW_NUM     NUMBER(38,0)    NOT NULL,\n    BATCH_ID        DATE            NOT NULL\n)\nCOMMENT = 'Bronze staging: raw store master (all VARCHAR, no casting)';, parameters: None","task_id":"run_bronze_ddl","try_number":1,"run_id":"scheduled__2026-11-15T18:15:00+00:00","dag_id":"my_etl_dag","map_index":-1,"ti_id":"01a1f73e-e19c-7beb-b256-6f8c42d76a56","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
