{"timestamp":"2026-11-20T09:53:18.714357Z","level":"info","event":"Running statement: -- Bronze targets\n-- Append one load event per target for this (batch, run).\n-- NOT EXISTS makes a task retry/clear safe (Snowflake does not enforce the UNIQUE).\n\nINSERT INTO control.C_LOAD_DATES (TARGET_TABLE, LAYER, BATCH_ID, RUN_ID)\nSELECT s.TARGET_TABLE, s.LAYER, DATE '2026-11-15', 'backfill__2026-11-15T00:00:00+00:00'\nFROM (VALUES\n    ('bronze', 'STG_STORE_MASTER'),\n    ('bronze', 'STG_ITEM_MASTER'),\n    ('bronze', 'STG_INVENTORY_MASTER'),\n    ('bronze', 'STG_POS_SALES'),\n    ('bronze', 'STG_PRICE_MASTER')\n) AS s(LAYER, TARGET_TABLE)\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM control.C_LOAD_DATES t\n    WHERE t.TARGET_TABLE = s.TARGET_TABLE\n      AND t.BATCH_ID     = DATE '2026-11-15'\n      AND t.RUN_ID       = 'backfill__2026-11-15T00:00:00+00:00'\n);, parameters: None","task_id":"stamp_bronze","ti_id":"01a1f85d-8982-7dc5-bae6-21f50aa1f3ca","map_index":-1,"try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
