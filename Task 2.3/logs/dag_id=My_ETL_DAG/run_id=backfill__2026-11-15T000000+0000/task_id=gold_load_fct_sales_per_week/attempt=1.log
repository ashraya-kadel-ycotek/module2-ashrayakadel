{"timestamp":"2026-11-20T08:23:56.870831Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. Delete the affected weeks from the aggregate (scoped rebuild).\n-- ----------------------------------------------------------------------------\nDELETE FROM gold.FCT_SALES_PER_WEEK\nWHERE WEEK_KY IN (SELECT WEEK_KY FROM TMP_FCT_WEEK_KEYS);, parameters: None","map_index":-1,"dag_id":"my_etl_dag","ti_id":"01a1f80a-9c51-700a-9fcb-76081bc03f85","try_number":1,"run_id":"backfill__2026-11-15T00:00:00+00:00","task_id":"gold_load_fct_sales_per_week","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
