{"timestamp":"2026-11-20T07:17:24.347924Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_LOCATION\n-- Source : silver.TMP_STORE_MASTER\n-- Parent : DIM_DISTRICT (DISTRICT_KY via DISTRICT_ID, CURR_FLG = TRUE)\n-- SCD    : LOCATION_NAME -> SCD2\n--          ADDRESS_LINE  -> SCD1\n-- Dedup  : one row per LOCATION_ID from today's batch\n-- KY     : LOCATION_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent DISTRICT_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_LOCATION_SRC AS\nWITH ranked AS (\n    SELECT\n        s.LOCATION_ID,\n        s.LOCATION_NAME,\n        s.ADDRESS_LINE,\n        s.DISTRICT_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.LOCATION_ID\n            ORDER BY s._LOAD_TS DESC, s.LOCATION_ID DESC\n        ) AS RN\n    FROM silver.TMP_STORE_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-15'\n      AND s.LOCATION_ID IS NOT NULL\n)\nSELECT\n    r.LOCATION_ID,\n    r.LOCATION_NAME,\n    r.ADDRESS_LINE,\n    d.DISTRICT_KY\nFROM ranked r\nJOIN gold.DIM_DISTRICT d\n  ON d.DISTRICT_ID = r.DISTRICT_ID\n AND d.CURR_FLG    = TRUE\nWHERE r.RN = 1;, parameters: None","map_index":1,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-3850-7963-b4ca-fc33387a0d7a","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:17:24.843473Z","level":"info","event":"Rows affected: 1","map_index":1,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-3850-7963-b4ca-fc33387a0d7a","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T07:17:24.843738Z","level":"info","event":"Snowflake query id: 01c88855-0003-1f52-000f-4ff600123c2a","map_index":1,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-3850-7963-b4ca-fc33387a0d7a","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:17:24.843875Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose LOCATION_NAME (or parent) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_LOCATION tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-15'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-15'\nFROM TMP_DIM_LOCATION_SRC src\nWHERE tgt.LOCATION_ID = src.LOCATION_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND (\n        COALESCE(tgt.LOCATION_NAME, '') <> COALESCE(src.LOCATION_NAME, '')\n     OR tgt.DISTRICT_KY <> src.DISTRICT_KY\n  );, parameters: None","map_index":1,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-3850-7963-b4ca-fc33387a0d7a","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
