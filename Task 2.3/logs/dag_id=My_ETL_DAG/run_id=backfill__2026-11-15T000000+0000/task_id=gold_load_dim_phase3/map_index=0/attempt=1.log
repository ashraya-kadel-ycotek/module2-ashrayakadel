{"timestamp":"2026-11-20T08:23:39.619750Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but DESCRIPTION changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CLASS tgt\nSET\n    CLASS_DESCRIPTION = src.CLASS_DESCRIPTION,\n    REC_UPDT_TS       = CURRENT_TIMESTAMP(),\n    BATCH_ID          = DATE '2026-11-15'\nFROM TMP_DIM_CLASS_SRC src\nWHERE tgt.CLASS_ID = src.CLASS_ID\n  AND tgt.CURR_FLG = TRUE\n  AND COALESCE(tgt.CLASS_NAME, '') = COALESCE(src.CLASS_NAME, '')\n  AND tgt.DEPARTMENT_KY = src.DEPARTMENT_KY\n  AND COALESCE(tgt.CLASS_DESCRIPTION, '') <> COALESCE(src.CLASS_DESCRIPTION, '');, parameters: None","dag_id":"my_etl_dag","map_index":0,"try_number":1,"ti_id":"01a1f80a-9c4b-7e99-8b04-28e12e89186a","task_id":"gold_load_dim_phase3","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
