{"timestamp":"2026-11-20T07:17:24.347781Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_CLASS\n-- Source : silver.TMP_ITEM_MASTER\n-- Parent : DIM_DEPARTMENT (DEPARTMENT_KY via DEPARTMENT_ID, CURR_FLG = TRUE)\n-- SCD    : CLASS_NAME        -> SCD2\n--          CLASS_DESCRIPTION -> SCD1\n-- Dedup  : one row per CLASS_ID from today's batch\n-- KY     : CLASS_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source + resolved parent DEPARTMENT_KY.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_CLASS_SRC AS\nWITH ranked AS (\n    SELECT\n        s.CLASS_ID,\n        s.CLASS_NAME,\n        s.CLASS_DESCRIPTION,\n        s.DEPARTMENT_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.CLASS_ID\n            ORDER BY s._LOAD_TS DESC, s.ITEM_ID DESC\n        ) AS RN\n    FROM silver.TMP_ITEM_MASTER s\n    WHERE s._BATCH_ID = DATE '2026-11-15'\n      AND s.CLASS_ID IS NOT NULL\n)\nSELECT\n    r.CLASS_ID,\n    r.CLASS_NAME,\n    r.CLASS_DESCRIPTION,\n    d.DEPARTMENT_KY\nFROM ranked r\nJOIN gold.DIM_DEPARTMENT d\n  ON d.DEPARTMENT_ID = r.DEPARTMENT_ID\n AND d.CURR_FLG       = TRUE\nWHERE r.RN = 1;, parameters: None","map_index":0,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-384f-7127-a1b5-1e9db3cb2d18","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:17:24.898967Z","level":"info","event":"Rows affected: 1","map_index":0,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-384f-7127-a1b5-1e9db3cb2d18","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
{"timestamp":"2026-11-20T07:17:24.899241Z","level":"info","event":"Snowflake query id: 01c88855-0003-1ebf-000f-4ff600122cea","map_index":0,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-384f-7127-a1b5-1e9db3cb2d18","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T07:17:24.899374Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose CLASS_NAME (or parent) changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CLASS tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-15'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-15'\nFROM TMP_DIM_CLASS_SRC src\nWHERE tgt.CLASS_ID = src.CLASS_ID\n  AND tgt.CURR_FLG = TRUE\n  AND (\n        COALESCE(tgt.CLASS_NAME, '') <> COALESCE(src.CLASS_NAME, '')\n     OR tgt.DEPARTMENT_KY <> src.DEPARTMENT_KY\n  );, parameters: None","map_index":0,"task_id":"gold_load_dim_phase3","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-384f-7127-a1b5-1e9db3cb2d18","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
