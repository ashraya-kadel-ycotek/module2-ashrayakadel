{"timestamp":"2026-11-20T08:23:31.413850Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3a. SCD2 open — insert a NEW history row for districts whose code\n--     (or parent state) changed.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_DISTRICT (\n    DISTRICT_ID,\n    DISTRICT_NAME, DISTRICT_CODE, STATE_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.DISTRICT_ID,\n    src.DISTRICT_NAME,\n    src.DISTRICT_CODE,\n    src.STATE_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_STORE_MASTER',\n    DATE '2026-11-15',\n    DATE '2026-11-15',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_DISTRICT_SRC src\nWHERE EXISTS (\n    SELECT 1\n    FROM gold.DIM_DISTRICT tgt\n    WHERE tgt.DISTRICT_ID = src.DISTRICT_ID\n      AND tgt.CURR_FLG    = FALSE\n      AND tgt.EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-15')\n      AND tgt.BATCH_ID    = DATE '2026-11-15'\n)\nAND NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_DISTRICT tgt\n    WHERE tgt.DISTRICT_ID = src.DISTRICT_ID\n      AND tgt.CURR_FLG    = TRUE\n);, parameters: None","map_index":1,"task_id":"gold_load_dim_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f80a-9c4a-78c6-b727-a1466061c440","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
