{"timestamp":"2026-11-20T07:16:47.305533Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_ITEM_MASTER',\n       'DUP_BUSINESS_KEY',\n       'Composite (ITEM_ID, CLASS_ID, DEPARTMENT_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_ITEM_MASTER s\nJOIN (\n    SELECT ITEM_ID, CLASS_ID, DEPARTMENT_ID\n    FROM bronze.STG_ITEM_MASTER\n    WHERE BATCH_ID = DATE '2026-11-15'\n    GROUP BY ITEM_ID, CLASS_ID, DEPARTMENT_ID HAVING COUNT(*) > 1\n) d ON  d.ITEM_ID = s.ITEM_ID\n    AND d.CLASS_ID = s.CLASS_ID\n    AND d.DEPARTMENT_ID = s.DEPARTMENT_ID\nWHERE s.BATCH_ID = DATE '2026-11-15';, parameters: None","map_index":1,"task_id":"silver_load_phase1","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f7ce-3844-7d0c-abf4-c09a6baeefe2","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
