CODE,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.LOCATION_ID, s.LOCATION_NAME, s.ADDRESS_LINE, s.DISTRICT_ID, s.DISTRICT_NAME,\n     s.DISTRICT_CODE, s.STATE_ID, s.STATE_NAME, s.STATE_CODE,\n     s.SRC_FILE_NM, DATE '2026-11-15', CURRENT_TIMESTAMP(), s.ROW_HASH);, parameters: None","map_index":0,"ti_id":"01a1f80a-9c3f-79b0-8511-761f2e066555","try_number":1,"run_id":"backfill__2026-11-15T00:00:00+00:00","task_id":"silver_load_phase1","dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
