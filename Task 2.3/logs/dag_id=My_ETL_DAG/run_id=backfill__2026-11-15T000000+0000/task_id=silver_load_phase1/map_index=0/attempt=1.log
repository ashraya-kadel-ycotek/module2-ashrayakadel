{"timestamp":"2026-11-20T07:16:47.670324Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_STORE_MASTER',\n       'DUP_BUSINESS_KEY', 'LOCATION_ID duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nJOIN (\n    SELECT LOCATION_ID\n    FROM bronze.STG_STORE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-15' AND LOCATION_ID IS NOT NULL\n    GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n) d ON d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-15';, parameters: None","task_id":"silver_load_phase1","try_number":1,"run_id":"backfill__2026-11-15T00:00:00+00:00","dag_id":"my_etl_dag","map_index":0,"ti_id":"01a1f7ce-3843-79dc-b582-9e154d3ca855","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
