{"timestamp":"2026-11-20T08:23:24.618972Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose phone is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CUSTOMER tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-15'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-15'\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.CUSTOMER_PHONE, '') <> COALESCE(src.CUSTOMER_PHONE, '');, parameters: None","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f80a-9c48-718e-87b5-bad153654b71","try_number":1,"map_index":2,"task_id":"gold_load_dim_phase1","dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
