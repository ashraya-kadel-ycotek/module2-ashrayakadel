{"timestamp":"2026-11-20T07:17:14.255354Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. SCD2 close-out — close current rows whose phone is changing.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_CUSTOMER tgt\nSET\n    EFF_TO_DATE = DATEADD('day', -1, DATE '2026-11-15'),\n    CURR_FLG    = FALSE,\n    REC_UPDT_TS = CURRENT_TIMESTAMP(),\n    BATCH_ID    = DATE '2026-11-15'\nFROM TMP_DIM_CUSTOMER_SRC src\nWHERE tgt.CUSTOMER_ID = src.CUSTOMER_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.CUSTOMER_PHONE, '') <> COALESCE(src.CUSTOMER_PHONE, '');, parameters: None","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f7ce-384c-7e27-a6c7-63a86b0ad766","task_id":"gold_load_dim_phase1","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
