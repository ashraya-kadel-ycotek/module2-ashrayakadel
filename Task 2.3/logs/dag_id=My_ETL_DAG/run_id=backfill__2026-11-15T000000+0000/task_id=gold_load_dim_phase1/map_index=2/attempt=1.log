{"timestamp":"2026-11-20T07:17:13.665525Z","level":"info","event":"Running statement: -- ============================================================================\n-- GOLD LOAD: DIM_CUSTOMER\n-- Source : silver.TMP_POS_SALES\n-- SCD    : CUSTOMER_NAME / CUSTOMER_EMAIL  -> SCD1 (overwrite in place)\n--          CUSTOMER_PHONE                  -> SCD2 (close old row, open new row)\n-- Dedup  : one row per CUSTOMER_ID from today's batch\n--          ORDER BY SALES_DT DESC, TRANSACTION_ID DESC\n-- KY     : CUSTOMER_KY is AUTOINCREMENT — never supplied in INSERT\n-- ============================================================================\n\n-- ----------------------------------------------------------------------------\n-- 1. Deduplicated today's source — exactly one row per CUSTOMER_ID.\n-- ----------------------------------------------------------------------------\nCREATE OR REPLACE TEMPORARY TABLE TMP_DIM_CUSTOMER_SRC AS\nWITH ranked AS (\n    SELECT\n        s.CUSTOMER_ID,\n        s.CUSTOMER_NAME,\n        s.CUSTOMER_EMAIL,\n        s.CUSTOMER_PHONE,\n        s.SALES_DT,\n        s.TRANSACTION_ID,\n        ROW_NUMBER() OVER (\n            PARTITION BY s.CUSTOMER_ID\n            ORDER BY s.SALES_DT DESC,\n                     s.TRANSACTION_ID DESC\n        ) AS RN\n    FROM silver.TMP_POS_SALES s\n    WHERE s._BATCH_ID = DATE '2026-11-15'\n      AND s.CUSTOMER_ID IS NOT NULL\n)\nSELECT\n    CUSTOMER_ID,\n    CUSTOMER_NAME,\n    CUSTOMER_EMAIL,\n    CUSTOMER_PHONE\nFROM ranked\nWHERE RN = 1;, parameters: None","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f7ce-384c-7e27-a6c7-63a86b0ad766","task_id":"gold_load_dim_phase1","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
{"timestamp":"2026-11-20T07:17:14.254923Z","level":"info","event":"Rows affected: 1","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f7ce-384c-7e27-a6c7-63a86b0ad766","task_id":"gold_load_dim_phase1","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":872}
