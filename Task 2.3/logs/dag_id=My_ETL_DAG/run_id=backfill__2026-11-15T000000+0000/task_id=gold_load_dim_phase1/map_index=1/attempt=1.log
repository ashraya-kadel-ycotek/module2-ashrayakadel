{"timestamp":"2026-11-20T07:17:14.130032Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New states — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_STATE (\n    STATE_ID,\n    STATE_NAME, STATE_CODE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.STATE_ID,\n    src.STATE_NAME,\n    src.STATE_CODE,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_STORE_MASTER',\n    DATE '2026-11-15',\n    DATE '2026-11-15',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_STATE_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_STATE tgt\n    WHERE tgt.STATE_ID = src.STATE_ID\n);, parameters: None","ti_id":"01a1f7ce-384b-7246-862d-9c55c822fddd","try_number":1,"map_index":1,"task_id":"gold_load_dim_phase1","dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
