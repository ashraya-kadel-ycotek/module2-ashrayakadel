{"timestamp":"2026-11-20T07:17:30.659035Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3b. New items — never seen before. Insert as current row.\n-- ----------------------------------------------------------------------------\nINSERT INTO gold.DIM_ITEM (\n    ITEM_ID,\n    ITEM_NAME, COLOR, SIZE, CLASS_KY,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID,\n    EFF_FROM_DATE, EFF_TO_DATE, CURR_FLG\n)\nSELECT\n    src.ITEM_ID,\n    src.ITEM_NAME,\n    src.COLOR,\n    src.SIZE,\n    src.CLASS_KY,\n    CURRENT_TIMESTAMP(),\n    CURRENT_TIMESTAMP(),\n    'TMP_ITEM_MASTER',\n    DATE '2026-11-15',\n    DATE '2026-11-15',\n    DATE '9999-12-31',\n    TRUE\nFROM TMP_DIM_ITEM_SRC src\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM gold.DIM_ITEM tgt\n    WHERE tgt.ITEM_ID = src.ITEM_ID\n);, parameters: None","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f7ce-3851-707c-97ba-2645c3bb1941","task_id":"gold_load_dim_item","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
