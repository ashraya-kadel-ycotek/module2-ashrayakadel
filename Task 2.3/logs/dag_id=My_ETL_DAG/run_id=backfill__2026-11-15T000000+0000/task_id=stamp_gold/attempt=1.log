{"timestamp":"2026-11-20T09:54:31.815176Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA control;\n\n-- Gold dims + facts (12 targets)\n-- Append one load event per target for this (batch, run).\n-- NOT EXISTS makes a task retry/clear safe (Snowflake does not enforce the UNIQUE).\n\nINSERT INTO control.C_LOAD_DATES (TARGET_TABLE, LAYER, BATCH_ID, RUN_ID)\nSELECT s.TARGET_TABLE, s.LAYER, DATE '2026-11-15', 'backfill__2026-11-15T00:00:00+00:00'\nFROM (VALUES\n    ('gold', 'DIM_COMPANY'),\n    ('gold', 'DIM_STATE'),\n    ('gold', 'DIM_CUSTOMER'),\n    ('gold', 'DIM_DEPARTMENT'),\n    ('gold', 'DIM_DISTRICT'),\n    ('gold', 'DIM_CLASS'),\n    ('gold', 'DIM_LOCATION'),\n    ('gold', 'DIM_ITEM'),\n    ('gold', 'FCT_SALES'),\n    ('gold', 'FCT_PRICE'),\n    ('gold', 'FCT_INVENTORY'),\n    ('gold', 'FCT_SALES_PER_WEEK')\n) AS s(LAYER, TARGET_TABLE)\nWHERE NOT EXISTS (\n    SELECT 1\n    FROM control.C_LOAD_DATES t\n    WHERE t.TARGET_TABLE = s.TARGET_TABLE\n      AND t.BATCH_ID     = DATE '2026-11-15'\n      AND t.RUN_ID       = 'backfill__2026-11-15T00:00:00+00:00'\n);","map_index":-1,"try_number":1,"run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f85d-8998-7169-b107-cdf049f4e7e0","task_id":"stamp_gold","dag_id":"my_etl_dag","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
