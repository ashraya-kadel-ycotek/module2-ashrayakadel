{"timestamp":"2026-11-20T09:54:24.130819Z","level":"info","event":"Snowflake query id: 01c888f2-0003-1f56-000f-4ff6001405ea","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f85d-8996-7f8f-8ea5-991120b125a4","task_id":"gold_load_fct_phase1","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":996}
{"timestamp":"2026-11-20T09:54:24.130913Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 3. MERGE valid rows into FCT_INVENTORY — idempotent on the grain.\n-- ----------------------------------------------------------------------------\nMERGE INTO gold.FCT_INVENTORY t\nUSING (\n    SELECT\n        DAY_KY, ITEM_KY, LOCATION_KY,\n        STOCK_ON_HAND, IN_TRANSIT,\n        SRC_EFF_FROM_DATE, SRC_EFF_TO_DATE\n    FROM TMP_FCT_INVENTORY_STG\n    WHERE RI_FAIL_FLG = FALSE\n) s\nON  t.DAY_KY      = s.DAY_KY\nAND t.ITEM_KY     = s.ITEM_KY\nAND t.LOCATION_KY = s.LOCATION_KY\n\nWHEN MATCHED AND (\n        COALESCE(t.STOCK_ON_HAND, -1) <> COALESCE(s.STOCK_ON_HAND, -1)\n     OR COALESCE(t.IN_TRANSIT,    -1) <> COALESCE(s.IN_TRANSIT,    -1)\n     OR COALESCE(t.EFF_FROM_DATE, DATE '1900-01-01') <> COALESCE(s.SRC_EFF_FROM_DATE, DATE '1900-01-01')\n     OR COALESCE(t.EFF_TO_DATE,   DATE '9999-12-31') <> COALESCE(s.SRC_EFF_TO_DATE,   DATE '9999-12-31')\n) THEN UPDATE SET\n    STOCK_ON_HAND = s.STOCK_ON_HAND,\n    IN_TRANSIT    = s.IN_TRANSIT,\n    EFF_FROM_DATE = s.SRC_EFF_FROM_DATE,\n    EFF_TO_DATE   = s.SRC_EFF_TO_DATE,\n    REC_UPDT_TS   = CURRENT_TIMESTAMP(),\n    BATCH_ID      = DATE '2026-11-15',\n    SRC_SYS_CD    = 'TMP_INVENTORY_MASTER'\n\nWHEN NOT MATCHED THEN INSERT (\n    DAY_KY, ITEM_KY, LOCATION_KY,\n    STOCK_ON_HAND, IN_TRANSIT,\n    EFF_FROM_DATE, EFF_TO_DATE,\n    REC_INS_TS, REC_UPDT_TS, SRC_SYS_CD, BATCH_ID\n)\nVALUES (\n    s.DAY_KY, s.ITEM_KY, s.LOCATION_KY,\n    s.STOCK_ON_HAND, s.IN_TRANSIT,\n    s.SRC_EFF_FROM_DATE, s.SRC_EFF_TO_DATE,\n    CURRENT_TIMESTAMP(), CURRENT_TIMESTAMP(), 'TMP_INVENTORY_MASTER', DATE '2026-11-15'\n);, parameters: None","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f85d-8996-7f8f-8ea5-991120b125a4","task_id":"gold_load_fct_phase1","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
