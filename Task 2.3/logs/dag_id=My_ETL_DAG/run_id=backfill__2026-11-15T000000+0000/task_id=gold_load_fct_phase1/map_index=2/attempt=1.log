{"timestamp":"2026-11-20T07:17:36.294922Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 2. Write join-miss rows to the reject table.\n-- ----------------------------------------------------------------------------\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT\n    s.SRC_FILE_NM,\n    DATE '2026-11-15',\n    'FCT_INVENTORY',\n    'REFERENTIAL_INTEGRITY_FAILURE',\n    'DAY_KY / ITEM_KY / LOCATION_KY could not be resolved as-of INVENTORY_DT',\n    OBJECT_CONSTRUCT(\n        'INVENTORY_DT',   s.INVENTORY_DT,\n        'ITEM_ID',        s.ITEM_ID,\n        'LOCATION_ID',    s.LOCATION_ID,\n        'STOCK_ON_HAND',  s.STOCK_ON_HAND,\n        'IN_TRANSIT',     s.IN_TRANSIT,\n        'DAY_KY',         s.DAY_KY,\n        'ITEM_KY',        s.ITEM_KY,\n        'LOCATION_KY',    s.LOCATION_KY,\n        'SRC_FILE_NM',    s.SRC_FILE_NM,\n        'SRC_ROW_HASH',   s.SRC_ROW_HASH\n    )\nFROM TMP_FCT_INVENTORY_STG s\nWHERE s.RI_FAIL_FLG = TRUE;, parameters: None","task_id":"gold_load_fct_phase1","ti_id":"01a1f7ce-3854-7d1c-ada0-e599fe39ef0d","run_id":"backfill__2026-11-15T00:00:00+00:00","dag_id":"my_etl_dag","try_number":1,"map_index":2,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
