MER c\n       ON c.CUSTOMER_ID = src.CUSTOMER_ID\n      AND src.SALES_DT BETWEEN c.EFF_FROM_DATE AND c.EFF_TO_DATE\n\nWHERE src._BATCH_ID = DATE '2026-11-15';, parameters: None","map_index":0,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f85d-8994-77d6-9b35-a23cbb2180f5","try_number":1,"task_id":"gold_load_fct_phase1","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
