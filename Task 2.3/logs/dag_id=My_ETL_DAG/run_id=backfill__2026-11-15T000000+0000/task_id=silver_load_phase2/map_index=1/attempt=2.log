{"timestamp":"2026-11-20T07:35:33.945746Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_POS_SALES',\n       'NEGATIVE_AMOUNT', 'SLS_QTY or SLS_AMT negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND TRY_TO_NUMBER(s.SLS_QTY) IS NOT NULL\n  AND TRY_TO_NUMBER(s.SLS_AMT) IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.SLS_QTY) < 0 OR TRY_TO_NUMBER(s.SLS_AMT) < 0 );, parameters: None","map_index":1,"ti_id":"01a1f7df-2ac5-7681-9e18-6e74acb3abb4","try_number":2,"run_id":"backfill__2026-11-15T00:00:00+00:00","task_id":"silver_load_phase2","dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
