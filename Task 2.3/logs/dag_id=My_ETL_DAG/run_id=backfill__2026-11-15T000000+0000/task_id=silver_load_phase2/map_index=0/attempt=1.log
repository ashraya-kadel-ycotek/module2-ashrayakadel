{"timestamp":"2026-11-20T08:23:02.888486Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_INVENTORY_MASTER',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in dims',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND ( NOT EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER  i WHERE i.ITEM_ID     = s.ITEM_ID)\n     OR NOT EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID) );, parameters: None","map_index":0,"task_id":"silver_load_phase2","try_number":1,"dag_id":"my_etl_dag","run_id":"backfill__2026-11-15T00:00:00+00:00","ti_id":"01a1f80a-9c41-701f-9f95-9e4328265ca3","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
