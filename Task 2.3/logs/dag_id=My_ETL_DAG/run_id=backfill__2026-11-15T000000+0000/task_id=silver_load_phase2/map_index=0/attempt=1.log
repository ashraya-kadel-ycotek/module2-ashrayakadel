{"timestamp":"2026-11-20T07:16:50.614071Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_INVENTORY_MASTER',\n       'TYPE_CAST_FAILURE',\n       'INVENTORY_DT / STOCK_ON_HAND / IN_TRANSIT failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND ( TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NULL\n     OR TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NULL\n     OR TRY_TO_NUMBER(s.IN_TRANSIT)    IS NULL );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_INVENTORY_MASTER',\n       'NULL_REQUIRED_FIELD', 'Required inventory field is NULL',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NOT NULL\n  AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n  AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n  AND ( s.INVENTORY_DT IS NULL OR s.ITEM_ID IS NULL\n     OR s.LOCATION_ID IS NULL OR s.STOCK_ON_HAND IS NULL\n     OR s.IN_TRANSIT IS NULL );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_INVENTORY_MASTER',\n       'NEGATIVE_AMOUNT', 'STOCK_ON_HAND or IN_TRANSIT negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n  AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n  AND ( TRY_TO_NUMBER(s.STOCK_ON_HAND) < 0\n     OR TRY_TO_NUMBER(s.IN_TRANSIT)   < 0 );\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_INVENTORY_MASTER',\n       'DUP_BUSINESS_KEY',\n       '(INVENTORY_DT, ITEM_ID, LOCATION_ID) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nJOIN (\n    SELECT TRY_TO_DATE(INVENTORY_DT,'YYYY-MM-DD') AS D, ITEM_ID, LOCATION_ID\n    FROM bronze.STG_INVENTORY_MASTER\n    WHERE BATCH_ID = DATE '2026-11-15'\n    GROUP BY 1,2,3 HAVING COUNT(*) > 1\n) d ON  d.D = TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD')\n    AND d.ITEM_ID = s.ITEM_ID\n    AND d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-15';\n\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_INVENTORY_MASTER',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in dims',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND ( NOT EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER  i WHERE i.ITEM_ID     = s.ITEM_ID)\n     OR NOT EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID) );\n\nMERGE INTO silver.TMP_INVENTORY_MASTER t\nUSING (\n    SELECT\n        TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') AS INVENTORY_DT,\n        s.ITEM_ID, s.LOCATION_ID,\n        TRY_TO_NUMBER(s.STOCK_ON_HAND) AS STOCK_ON_HAND,\n        TRY_TO_NUMBER(s.IN_TRANSIT)    AS IN_TRANSIT,\n        s.SRC_FILE_NM,\n        MD5(\n            TO_VARCHAR(TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD'))||'|'||\n            COALESCE(s.ITEM_ID,'')||'|'||COALESCE(s.LOCATION_ID,'')||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.STOCK_ON_HAND))||'|'||\n            TO_VARCHAR(TRY_TO_NUMBER(s.IN_TRANSIT))\n        ) AS ROW_HASH\n    FROM bronze.STG_INVENTORY_MASTER s\n    WHERE s.BATCH_ID = DATE '2026-11-15'\n      AND TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NOT NULL\n      AND TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NOT NULL\n      AND TRY_TO_NUMBER(s.IN_TRANSIT)    IS NOT NULL\n      AND TRY_TO_NUMBER(s.STOCK_ON_HAND) >= 0\n      AND TRY_TO_NUMBER(s.IN_TRANSIT)    >= 0\n      AND s.ITEM_ID IS NOT NULL AND s.LOCATION_ID IS NOT NULL\n      AND EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER  i WHERE i.ITEM_ID     = s.ITEM_ID)\n      AND EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID)\n      AND NOT EXISTS (\n          SELECT 1 FROM (\n              SELECT TRY_TO_DATE(INVENTORY_DT,'YYYY-MM-DD') AS D,\n                     ITEM_ID, LOCATION_ID, COUNT(*) c\n              FROM bronze.STG_INVENTORY_MASTER\n              WHERE BATCH_ID = DATE '2026-11-15'\n              GROUP BY 1,2,3\n          ) d\n          WHERE d.D = TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD')\n            AND d.ITEM_ID = s.ITEM_ID\n            AND d.LOCATION_ID = s.LOCATION_ID\n            AND d.c > 1\n      )\n) s\nON  t.INVENTORY_DT = s.INVENTORY_DT\nAND t.ITEM_ID      = s.ITEM_ID\nAND t.LOCATION_ID  = s.LOCATION_ID\nWHEN MATCHED AND t._ROW_HASH <> s.ROW_HASH THEN UPDATE SET\n    STOCK_ON_HAND = s.STOCK_ON_HAND, IN_TRANSIT = s.IN_TRANSIT,\n    _SRC_FILE_NM = s.SRC_FILE_NM, _BATCH_ID = DATE '2026-11-15',\n    _LOAD_TS = CURRENT_TIMESTAMP(), _ROW_HASH = s.ROW_HASH\nWHEN NOT MATCHED THEN INSERT\n    (INVENTORY_DT, ITEM_ID, LOCATION_ID, STOCK_ON_HAND, IN_TRANSIT,\n     _SRC_FILE_NM, _BATCH_ID, _LOAD_TS, _ROW_HASH)\n    VALUES\n    (s.INVENTORY_DT, s.ITEM_ID, s.LOCATION_ID, s.STOCK_ON_HAND, s.IN_TRANSIT,\n     s.SRC_FILE_NM, DATE '2026-11-15', CURRENT_TIMESTAMP(), s.ROW_HASH);\n\nINSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-15'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-15' AND TARGET_TABLE = 'TMP_INVENTORY_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-15'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-15' AND r.TARGET_TABLE = 'TMP_INVENTORY_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-15',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-15'),'inventory_master'),\n       'TMP_INVENTORY_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;","task_id":"silver_load_phase2","ti_id":"01a1f7ce-3845-774b-a8db-8c31d5a0e6ac","run_id":"backfill__2026-11-15T00:00:00+00:00","try_number":1,"map_index":0,"dag_id":"my_etl_dag","logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
