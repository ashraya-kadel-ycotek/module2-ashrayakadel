{"timestamp":"2026-11-20T07:16:54.273484Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_INVENTORY_MASTER',\n       'REFERENTIAL_INTEGRITY_FAILURE',\n       'ITEM_ID or LOCATION_ID missing in dims',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND ( NOT EXISTS (SELECT 1 FROM silver.TMP_ITEM_MASTER  i WHERE i.ITEM_ID     = s.ITEM_ID)\n     OR NOT EXISTS (SELECT 1 FROM silver.TMP_STORE_MASTER st WHERE st.LOCATION_ID = s.LOCATION_ID) );, parameters: None","task_id":"silver_load_phase2","ti_id":"01a1f7ce-3845-774b-a8db-8c31d5a0e6ac","run_id":"backfill__2026-11-15T00:00:00+00:00","try_number":1,"map_index":0,"dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
