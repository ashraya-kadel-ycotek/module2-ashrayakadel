{"timestamp":"2026-11-20T07:16:53.240338Z","level":"info","event":"Running statement: -- 5.3 Negative price\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-15', 'TMP_PRICE_MASTER',\n       'NEGATIVE_AMOUNT',\n       'UNIT_PRICE_AMT is negative',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-15'\n  AND TRY_TO_NUMBER(s.UNIT_PRICE_AMT) < 0;, parameters: None","dag_id":"my_etl_dag","map_index":2,"try_number":1,"ti_id":"01a1f7ce-3847-726d-aa1d-c6236583ba80","task_id":"silver_load_phase2","run_id":"backfill__2026-11-15T00:00:00+00:00","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
