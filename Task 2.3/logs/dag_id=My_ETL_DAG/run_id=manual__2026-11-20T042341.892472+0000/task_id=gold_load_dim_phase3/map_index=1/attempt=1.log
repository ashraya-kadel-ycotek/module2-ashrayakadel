{"timestamp":"2026-11-20T04:24:55.775649Z","level":"info","event":"Running statement: -- ----------------------------------------------------------------------------\n-- 4. SCD1 update — same name (and same parent), but ADDRESS_LINE changed.\n-- ----------------------------------------------------------------------------\nUPDATE gold.DIM_LOCATION tgt\nSET\n    ADDRESS_LINE = src.ADDRESS_LINE,\n    REC_UPDT_TS  = CURRENT_TIMESTAMP(),\n    BATCH_ID     = DATE '2026-11-20'\nFROM TMP_DIM_LOCATION_SRC src\nWHERE tgt.LOCATION_ID = src.LOCATION_ID\n  AND tgt.CURR_FLG    = TRUE\n  AND COALESCE(tgt.LOCATION_NAME, '') = COALESCE(src.LOCATION_NAME, '')\n  AND tgt.DISTRICT_KY = src.DISTRICT_KY\n  AND COALESCE(tgt.ADDRESS_LINE, '') <> COALESCE(src.ADDRESS_LINE, '');, parameters: None","task_id":"gold_load_dim_phase3","run_id":"manual__2026-11-20T04:23:41.892472+00:00","try_number":1,"dag_id":"my_etl_dag","map_index":1,"ti_id":"01a1f732-2887-74a5-b074-568c1857f91f","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
