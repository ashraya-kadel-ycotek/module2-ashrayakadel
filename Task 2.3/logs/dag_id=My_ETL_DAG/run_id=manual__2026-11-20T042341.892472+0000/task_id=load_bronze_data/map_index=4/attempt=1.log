{"timestamp":"2026-11-20T04:23:54.414656Z","level":"info","event":"Executing: USE WAREHOUSE MODULE2;\nUSE DATABASE MODULE2_ETL;\nUSE SCHEMA bronze;\n\nCREATE OR REPLACE TEMPORARY STAGE BRONZE.TMP_DAILY_STAGE\n    FILE_FORMAT = (\n        TYPE = CSV\n        FIELD_DELIMITER = ','\n        SKIP_HEADER = 1\n        FIELD_OPTIONALLY_ENCLOSED_BY = '\"'\n        EMPTY_FIELD_AS_NULL = TRUE\n        NULL_IF = ('', 'NULL')\n        TRIM_SPACE = TRUE\n    );\n\nPUT file:///opt/airflow/data/store_master_20261120.csv\n    @BRONZE.TMP_DAILY_STAGE AUTO_COMPRESS=TRUE OVERWRITE=TRUE;\n\nBEGIN;\n\nDELETE FROM BRONZE.STG_STORE_MASTER\nWHERE BATCH_ID = '2026-11-20'::DATE;\n\nCOPY INTO BRONZE.STG_STORE_MASTER (\n    LOCATION_ID, LOCATION_NAME, ADDRESS_LINE, DISTRICT_ID, DISTRICT_NAME,\n    DISTRICT_CODE, STATE_ID, STATE_NAME, STATE_CODE,\n    SRC_FILE_NM, SRC_ROW_NUM, BATCH_ID\n)\nFROM (\n    SELECT\n        t.$1, t.$2, t.$3, t.$4, t.$5,\n        t.$6, t.$7, t.$8, t.$9,\n        METADATA$FILENAME::VARCHAR(255),\n        METADATA$FILE_ROW_NUMBER,\n        '2026-11-20'::DATE\n    FROM @BRONZE.TMP_DAILY_STAGE/store_master_20261120.csv.gz t\n)\nFILE_FORMAT = (TYPE = CSV SKIP_HEADER = 1 FIELD_OPTIONALLY_ENCLOSED_BY = '\"')\nON_ERROR = 'CONTINUE';\n\nCOMMIT;","run_id":"manual__2026-11-20T04:23:41.892472+00:00","ti_id":"01a1f732-2878-770d-8bd3-3f4e99cfff66","try_number":1,"dag_id":"my_etl_dag","task_id":"load_bronze_data","map_index":4,"logger":"airflow.task.operators.airflow.providers.common.sql.operators.sql.SQLExecuteQueryOperator","filename":"sql.py","lineno":556}
