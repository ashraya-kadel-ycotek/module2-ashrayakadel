{"timestamp":"2026-11-19T10:14:17.135621Z","level":"info","event":"Running statement: -- ============================================================================\n-- 5. TMP_PRICE_MASTER\n-- Grain: 1 row per (ITEM_ID, LOCATION_ID, EFF_FROM_DATE)\n-- ============================================================================\n\n-- 5.1 Type-cast failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_PRICE_MASTER',\n       'TYPE_CAST_FAILURE',\n       'PRICE_DT / UNIT_PRICE_AMT / EFF_FROM_DATE / EFF_TO_DATE failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_PRICE_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND (\n       TRY_TO_DATE(s.PRICE_DT, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_NUMBER(s.UNIT_PRICE_AMT) IS NULL\n    OR TRY_TO_DATE(s.EFF_FROM_DATE, 'YYYY-MM-DD') IS NULL\n    OR TRY_TO_DATE(s.EFF_TO_DATE, 'YYYY-MM-DD') IS NULL\n  );, parameters: None","try_number":2,"dag_id":"my_etl_dag","map_index":-1,"run_id":"manual__2026-11-19T10:03:33.909487+00:00","ti_id":"01a1f34c-9953-7c6e-8188-2be38dff64bd","task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
