{"timestamp":"2026-11-19T10:14:13.496156Z","level":"info","event":"Running statement: INSERT INTO control.C_BATCH_RECON\n    (BATCH_ID, SRC_FILE_NM, TARGET_TABLE, BRONZE_CNT, TMP_CNT, REJ_CNT, VARIANCE, STATUS)\nWITH b AS (SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-19'),\n     r AS (SELECT COUNT(*) c FROM control.C_REJ_TABLE\n            WHERE BATCH_ID = DATE '2026-11-19' AND TARGET_TABLE = 'TMP_INVENTORY_MASTER'),\n     t AS (\n       SELECT COUNT(*) c FROM bronze.STG_INVENTORY_MASTER s\n        WHERE s.BATCH_ID = DATE '2026-11-19'\n          AND NOT EXISTS (\n              SELECT 1 FROM control.C_REJ_TABLE r\n               WHERE r.BATCH_ID = DATE '2026-11-19' AND r.TARGET_TABLE = 'TMP_INVENTORY_MASTER'\n                 AND r.DETAILS:SRC_FILE_NM::VARCHAR = s.SRC_FILE_NM\n                 AND r.DETAILS:SRC_ROW_NUM::NUMBER   = s.SRC_ROW_NUM))\nSELECT DATE '2026-11-19',\n       COALESCE((SELECT MAX(SRC_FILE_NM) FROM bronze.STG_INVENTORY_MASTER WHERE BATCH_ID = DATE '2026-11-19'),'inventory_master'),\n       'TMP_INVENTORY_MASTER',\n       b.c, t.c, r.c,\n       b.c - (t.c + r.c),\n       CASE WHEN b.c = (t.c + r.c) THEN 'PASSED' ELSE 'FAILED' END\nFROM b, r, t;, parameters: None","try_number":2,"dag_id":"my_etl_dag","map_index":-1,"run_id":"manual__2026-11-19T10:03:33.909487+00:00","ti_id":"01a1f34c-9953-7c6e-8188-2be38dff64bd","task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
