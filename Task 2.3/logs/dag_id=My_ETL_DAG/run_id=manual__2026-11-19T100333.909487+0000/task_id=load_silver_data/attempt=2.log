{"timestamp":"2026-11-19T10:14:08.715715Z","level":"info","event":"Running statement: -- ============================================================================\n-- SILVER LOAD (flat script — no stored procedure)\n-- Run via Airflow SQLExecuteQueryOperator with split_statements=True,\n-- autocommit=False. Snowflake will treat the file as a sequence of\n-- statements; the MERGE/INSERT DML is auto-wrapped in a transaction\n-- by the connector when autocommit=False; DDL auto-commits regardless.\n--\n-- Batch id is bound as a placeholder :BATCH_ID by the driver — the\n-- SQLExecuteQueryOperator passes `parameters` / `params` if you set them.\n-- Simpler: use a single literal substitution here:\n--   2026-11-19 is resolved by Airflow BEFORE the file runs, so the file\n--   itself contains DATE '2026-11-19'.\n-- ============================================================================\nUSE WAREHOUSE MODULE2;, parameters: None","try_number":2,"dag_id":"my_etl_dag","map_index":-1,"run_id":"manual__2026-11-19T10:03:33.909487+00:00","ti_id":"01a1f34c-9953-7c6e-8188-2be38dff64bd","task_id":"load_silver_data","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
