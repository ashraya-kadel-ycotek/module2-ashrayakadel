{"timestamp":"2026-11-19T05:31:49.368005Z","level":"info","event":"Running statement: -- ============================================================\n-- SILVER.TMP_STORE_MASTER\n-- Grain: 1 row per (LOCATION_ID, ADDRESS_LINE, DISTRICT_CODE)\n-- NOTE: referential integrity is checked in Load SQL.\n-- ============================================================\nCREATE TABLE IF NOT EXISTS silver.TMP_STORE_MASTER (\n    -- business columns\n    LOCATION_ID         VARCHAR(20)     NOT NULL,\n    LOCATION_NAME       VARCHAR(255)    NOT NULL,\n    ADDRESS_LINE        VARCHAR(500)    NOT NULL,\n    DISTRICT_ID         VARCHAR(20)     NOT NULL,\n    DISTRICT_NAME       VARCHAR(100)    NOT NULL,\n    DISTRICT_CODE       VARCHAR(10)     NOT NULL,\n    STATE_ID            VARCHAR(20)     NOT NULL,\n    STATE_NAME          VARCHAR(100)    NOT NULL,\n    STATE_CODE          VARCHAR(10)     NOT NULL,\n\n    -- silver audit columns\n    _SRC_FILE_NM        VARCHAR(255)    NOT NULL,\n    _BATCH_ID           DATE            NOT NULL,\n    _LOAD_TS            TIMESTAMP_NTZ(9) NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n\n    CONSTRAINT PK_TMP_STORE_MASTER\n        PRIMARY KEY (LOCATION_ID, ADDRESS_LINE, DISTRICT_CODE),\n    CONSTRAINT UQ_TMP_STORE_MASTER_LOCATION\n        UNIQUE (LOCATION_ID)\n)\nCOMMENT = 'Silver staging: validated store master';, parameters: None","try_number":2,"ti_id":"01a1f24a-1984-7909-9345-4fd209a29df6","dag_id":"my_etl_dag","task_id":"run_silver_ddl","run_id":"manual__2026-11-19T05:28:20.960454+00:00","map_index":-1,"logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
