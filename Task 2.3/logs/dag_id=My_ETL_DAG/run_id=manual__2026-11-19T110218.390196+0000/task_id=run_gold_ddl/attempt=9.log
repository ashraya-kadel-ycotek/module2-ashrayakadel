{"timestamp":"2026-11-19T11:32:11.907557Z","level":"info","event":"Running statement: -- FCT_SALES_PER_WEEK\nCREATE TABLE IF NOT EXISTS MODULE2.GOLD.FCT_SALES_PER_WEEK (\n    SALES_WEEK_KY             INT AUTOINCREMENT START 1 INCREMENT 1 NOT NULL,\n    WEEK_KY                   INT NOT NULL,\n    ITEM_KY                   INT NOT NULL,\n    LOCATION_KY               INT NOT NULL,\n    SLS_QTY                   NUMBER(18,4),\n    SLS_AMT                   NUMBER(18,2),\n    REC_INS_TS                TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    REC_UPDT_TS               TIMESTAMP_NTZ NOT NULL DEFAULT CURRENT_TIMESTAMP(),\n    SRC_SYS_CD                VARCHAR,\n    BATCH_ID                  VARCHAR,\n    CONSTRAINT PK_FCT_SALES_PER_WEEK PRIMARY KEY (SALES_WEEK_KY),\n    CONSTRAINT UQ_FCT_SALES_PER_WEEK_GRAIN UNIQUE (WEEK_KY, ITEM_KY, LOCATION_KY),\n    CONSTRAINT FK_FCT_SALES_PER_WEEK_WEEK_KY FOREIGN KEY (WEEK_KY) REFERENCES MODULE2.GOLD.DIM_WEEK (WEEK_KY),\n    CONSTRAINT FK_FCT_SALES_PER_WEEK_ITEM_KY FOREIGN KEY (ITEM_KY) REFERENCES MODULE2.GOLD.DIM_ITEM (ITEM_KY),\n    CONSTRAINT FK_FCT_SALES_PER_WEEK_LOCATION_KY FOREIGN KEY (LOCATION_KY) REFERENCES MODULE2.GOLD.DIM_LOCATION (LOCATION_KY)\n)\nCOMMENT = 'Aggregate fact. Grain: week/item/location. Derived from FCT_SALES rolled up to DIM_WEEK.';, parameters: None","task_id":"run_gold_ddl","run_id":"manual__2026-11-19T11:02:18.390196+00:00","dag_id":"my_etl_dag","map_index":-1,"try_number":9,"ti_id":"01a1f394-02ab-73f3-b26e-7f6c2ca67486","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
