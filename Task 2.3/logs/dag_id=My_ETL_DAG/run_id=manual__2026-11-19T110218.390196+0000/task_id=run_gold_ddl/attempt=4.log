{"timestamp":"2026-11-19T11:11:37.059321Z","level":"info","event":"Running statement: -- ======================================================================\n-- RETAIL SNOWFLAKE SCHEMA: tables + date seed (2026-01-01 .. 2035-12-31)\n-- Safe to rerun: CREATE ... IF NOT EXISTS, and the seed only INSERTS missing rows.\n-- Week convention: ISO (Monday start). A week belongs to the month of its THURSDAY.\n-- Because of that, week 2036-W01 (starts 2035-12-31) adds ancestor rows\n-- for Jan 2036 / Q1 2036 / Year 2036 (no 2036 day rows).\n-- FCT_SALES_PER_WEEK aggregate: grain = week / item / location (no customer).\n-- All objects are FULLY QUALIFIED (MODULE2.GOLD.<table>).\n-- No SET variables. No BEGIN TRANSACTION wrapper (Airflow split_statements safe).\n-- ======================================================================\n\nCREATE WAREHOUSE IF NOT EXISTS MODULE2_ETL\n    WAREHOUSE_SIZE = 'XSMALL' AUTO_SUSPEND = 60 AUTO_RESUME = TRUE INITIALLY_SUSPENDED = TRUE;, parameters: None","try_number":4,"map_index":-1,"run_id":"manual__2026-11-19T11:02:18.390196+00:00","task_id":"run_gold_ddl","ti_id":"01a1f381-3653-76a0-8150-a78d05c418ee","dag_id":"my_etl_dag","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
