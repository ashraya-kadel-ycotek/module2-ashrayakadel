{"timestamp":"2026-11-19T11:02:57.085790Z","level":"info","event":"Running statement: -- ============================================================================\n-- 3. TMP_INVENTORY_MASTER   (key: INVENTORY_DT, ITEM_ID, LOCATION_ID)\n-- ============================================================================\n-- 3.1 cast failures\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_INVENTORY_MASTER',\n       'TYPE_CAST_FAILURE',\n       'INVENTORY_DT / STOCK_ON_HAND / IN_TRANSIT failed to cast',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_INVENTORY_MASTER s\nWHERE s.BATCH_ID = DATE '2026-11-19'\n  AND ( TRY_TO_DATE(s.INVENTORY_DT,'YYYY-MM-DD') IS NULL\n     OR TRY_TO_NUMBER(s.STOCK_ON_HAND) IS NULL\n     OR TRY_TO_NUMBER(s.IN_TRANSIT)    IS NULL );, parameters: None","task_id":"load_silver_data","run_id":"manual__2026-11-19T11:02:18.390196+00:00","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f378-bc58-7f16-b9e5-9245e766b18b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
