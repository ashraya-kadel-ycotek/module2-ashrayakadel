{"timestamp":"2026-11-19T11:02:52.830112Z","level":"info","event":"Running statement: -- 1.2 DUP rejects\nINSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_STORE_MASTER',\n       'DUP_BUSINESS_KEY', 'LOCATION_ID duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_STORE_MASTER s\nJOIN (\n    SELECT LOCATION_ID\n    FROM bronze.STG_STORE_MASTER\n    WHERE BATCH_ID = DATE '2026-11-19' AND LOCATION_ID IS NOT NULL\n    GROUP BY LOCATION_ID HAVING COUNT(*) > 1\n) d ON d.LOCATION_ID = s.LOCATION_ID\nWHERE s.BATCH_ID = DATE '2026-11-19';, parameters: None","task_id":"load_silver_data","run_id":"manual__2026-11-19T11:02:18.390196+00:00","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f378-bc58-7f16-b9e5-9245e766b18b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
