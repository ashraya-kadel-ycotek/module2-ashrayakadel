{"timestamp":"2026-11-19T11:03:01.901165Z","level":"info","event":"Running statement: INSERT INTO control.C_REJ_TABLE\n    (SRC_FILE_NM, BATCH_ID, TARGET_TABLE, REASON_CODE, REASON, DETAILS)\nSELECT s.SRC_FILE_NM, DATE '2026-11-19', 'TMP_POS_SALES',\n       'DUP_BUSINESS_KEY',\n       '(TRANSACTION_ID, TRANSACTION_LINE_NUMBER) duplicated within batch',\n       OBJECT_CONSTRUCT(s.*)\nFROM bronze.STG_POS_SALES s\nJOIN (\n    SELECT TRANSACTION_ID, TRY_TO_NUMBER(TRANSACTION_LINE_NUMBER) AS LN\n    FROM bronze.STG_POS_SALES\n    WHERE BATCH_ID = DATE '2026-11-19'\n    GROUP BY 1,2 HAVING COUNT(*) > 1\n) d ON  d.TRANSACTION_ID = s.TRANSACTION_ID\n    AND d.LN = TRY_TO_NUMBER(s.TRANSACTION_LINE_NUMBER)\nWHERE s.BATCH_ID = DATE '2026-11-19';, parameters: None","task_id":"load_silver_data","run_id":"manual__2026-11-19T11:02:18.390196+00:00","dag_id":"my_etl_dag","map_index":-1,"try_number":1,"ti_id":"01a1f378-bc58-7f16-b9e5-9245e766b18b","logger":"airflow.task.hooks.airflow.providers.snowflake.hooks.snowflake.SnowflakeHook","filename":"snowflake.py","lineno":853}
